# Copy to .env and fill in after creating a Sanity project.
# Anything prefixed PUBLIC_ is visible in the browser — that's fine for these
# two, they're identifiers rather than secrets.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Only needed to run scripts/seed-sanity.ts. This one IS a secret — it can
# write to your dataset. Never commit the .env file.
SANITY_API_WRITE_TOKEN=
