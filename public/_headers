# Response headers for the built site (Cloudflare serves dist/ as static assets
# and reads this file).

# The client site copies the 3D work cards show live (Hunter's rule: trackers
# must never run from kineticstudio.com copies). Everything a copy needs was
# saved beside it, so nothing may leave the site: no analytics, pixels or
# beacons, no form posts, and only our own pages may frame them.
/sites/*
  Content-Security-Policy: default-src 'self' data: blob: 'unsafe-inline' 'unsafe-eval'; frame-ancestors 'self'; form-action 'none'; base-uri 'self'
  X-Robots-Tag: noindex, nofollow

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000

# The build's own files carry a hash of their contents in their names, so a
# changed file is a new address: keep them for a year without asking again.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Stills, films, sounds and card media keep their names when they change, so a
# day, then served from cache while the browser checks for a newer copy.
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/cards/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/sfx/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/experiments/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
