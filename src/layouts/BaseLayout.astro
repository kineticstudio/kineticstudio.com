---
import "@/styles/global.css";
import BaseHead from "@/components/utility/BaseHead.astro";
import SkipLink from "@/components/global/SkipLink.astro";
import Nav from "@/components/global/Nav.astro";
import Footer from "@/components/global/Footer.astro";
import EdgeTicks from "@/components/global/EdgeTicks.astro";
import ProjectModal from "@/components/global/ProjectModal.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark" | "brand";
  /** Hide the nav's lockup until the page's hero hands it over. */
  logoHidden?: boolean;
  /** Leave the footer off (full-screen pages). */
  footer?: boolean;
};

const { theme = "dark", logoHidden = false, footer = true, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en" class:list={[theme !== "inherit" && `theme-${theme}`]}>
  <head>
    {/* before anything is drawn: is this an arrival from the site's own links? (styles/hover.css) */}
    <script is:inline>try{sessionStorage.getItem("ks-internal")==="1"&&document.documentElement.classList.add("is-arrival")}catch(e){}</script>
    {/* the ground before the stylesheet lands, so a page never opens on white */}
    <style is:inline>html{background:#0d0d0d}html.theme-light{background:#f4f6f1}</style>
    <BaseHead {...seo} />
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <Nav logoHidden={logoHidden} />
    <EdgeTicks left={Astro.url.pathname !== "/"} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {footer && <Footer form={!Astro.url.pathname.startsWith("/playground")} />}
    <ProjectModal />
    <slot name="after" />
    <script>
      import "@/scripts/site.js";
    </script>
  </body>
</html>

<style is:global>
  @layer components {
    [data-reveal] {
      opacity: 0;
      transform: translateY(1.5rem);
      transition:
        opacity 0.9s cubic-bezier(0.2, 0.7, 0.2, 1),
        transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
      transition-delay: var(--reveal-delay, 0s);
      &.is-in {
        opacity: 1;
        transform: none;
      }
    }
    .cursor-tag {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 70;
      padding: 0.45rem 0.7rem 0.35rem;
      border-radius: var(--radius-round);
      background: var(--brand-500);
      color: var(--brand-text);
      font-family: var(--display-family);
      font-size: var(--pill-type);
      line-height: 1;
      text-transform: uppercase;
      white-space: nowrap;
      pointer-events: none;
      opacity: 0;
      scale: 0.6;
      transition: opacity 0.2s ease, scale 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
      &.is-on {
        opacity: 1;
        scale: 1;
      }
    }
  }
</style>
