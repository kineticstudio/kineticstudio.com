---
import { Font } from "astro:assets";
import { SITE_NAME, SITE_DESCRIPTION } from "@/consts.ts";
import { isNoindexRoute } from "@/utils/seo.ts";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps;

const {
  title,
  description = SITE_DESCRIPTION,
  image = "/og-image.jpg",
  type = "website",
  noindex,
} = Astro.props;

const isNoindex = noindex ?? isNoindexRoute(Astro.url.pathname);

// the name first (Hunter, Oct 30: "make title tag start with Kinetic Studio")
const pageTitle = title ? `${SITE_NAME} | ${title}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
// the site's own preview, the image and its film (scripts/og-video.mjs, Oct 30): where a page has its own image, the image alone
const shared = image === "/og-image.jpg";
const socialVideo = shared ? new URL("/og-video.mp4", Astro.site) : null;
---

<meta charset="utf-8" />
<style is:inline>
  @layer base, patterns, components, utilities;
</style>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<Font cssVariable="--font-panell" preload />
<Font cssVariable="--font-neue-montreal" preload />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{isNoindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
{shared && <meta property="og:image:width" content="1200" />}
{shared && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content="Kinetic Studio: captivating websites that tell compelling stories" />
{socialVideo && <meta property="og:video" content={socialVideo} />}
{socialVideo && <meta property="og:video:secure_url" content={socialVideo} />}
{socialVideo && <meta property="og:video:type" content="video/mp4" />}
{socialVideo && <meta property="og:video:width" content="1200" />}
{socialVideo && <meta property="og:video:height" content="630" />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

{/* Scripts build runtime URLs from this, so the site also works from a folder (scripts/relativize.mjs) */}
<link rel="site-root" href="/" />
{/* Cloudflare Web Analytics, cookie-free, on the site's own pages only: not on the
    3D cards' or the client site copies' frames (they were counted as page views), not in
    the Creative Studio's build, not in development */}
{import.meta.env.PROD && !process.env.KS_STUDIO_BUILD && (
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "b9c90f71eb6444f7bb599728f27f49de"}'></script>
)}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />
