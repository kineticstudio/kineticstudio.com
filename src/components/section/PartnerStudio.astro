---
import MarkLockup from "@/components/content/MarkLockup.astro";
import Modal from "@/components/interactive/Modal.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The partner's name, in the brand book point. */
  partner: string;
}

const { render = true, partner } = Astro.props;
/* The Studio, on /primary (Hunter, Nov 17: "a section as well that shows off the studio. You can look at the
   Proposals section, which shows off a screenshot of the studio and talks about the features and how we
   populate the brand book inside of there. Maybe we have a studio link that shows off the studio video").
   The proposal's "Bleeding-edge custom tooling" page (briefs/migration/kinetic.mjs `studio`), with the brand
   book first, its points beside the Studio itself. Later on Nov 17 (Hunter): "maybe they have the video just be
   more of a gradient. It doesn't have to be inside of the mockup, and then you could say, 'Watch the film,'
   over on top of the gradient looped video": the Studio loop sits on a curved gradient like the page's own
   (neon into dark), with the button over it, which opens the film (the About page's, media/studio-film.mp4)
   with sound. */
// the proposal's line icons (kinetic-contracts briefs/migration-sheet.mjs ICONS), one per point
const ICONS: Record<string, string> = {
  doc: "M5.5 3h9l4 4v14h-13z M14.5 3v4h4 M8.5 11h7 M8.5 14.5h7 M8.5 18h4",
  browser: "M3 5h18v14H3z M3 9h18 M6 7h1 M9 7h1",
  play: "M3.5 5h17v14h-17z M10 9v6l5-3z",
  pin: "M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z M12 7.5a2.5 2.5 0 1 0 0 5a2.5 2.5 0 1 0 0-5",
  sliders: "M4 6h9 M17 6h3 M4 12h3 M11 12h9 M4 18h11 M19 18h1 M15 4v4 M9 10v4 M17 16v4",
  deploy: "M4 20h16 M12 16V4 M7.5 8.5L12 4l4.5 4.5",
};
const POINTS = [
  ["doc", "Your brand book, built in", `${partner}'s colours, type, logos and guidelines load into the Studio, so every wireframe and design starts on-brand.`],
  ["browser", "One link for everything", "Every page, wireframe, prototype and design, in one place."],
  ["play", "Live prototypes", "Real, interactive builds to click through, not static mockups."],
  ["pin", "Real-time commenting", "Pin a note to any spot, with replies, mentions and files."],
  ["sliders", "Parameter tuning", "Dial in motion, colour and type live, then lock it in."],
  ["deploy", "From approved to live", "Every revision kept, and live in one step, with a preview first."],
];
---

{
  render && (
    <section class="studio-p theme-dark" aria-labelledby="studio-p-title">
      <div class="studio-p_inner">
        <div class="studio-p_text">
          <div data-reveal>
            <MarkLockup class="studio-p_lockup" label="Studio" />
          </div>
          <h2 id="studio-p-title" class="studio-p_title text-style-h2" data-reveal>
            <span>Bleeding-edge</span>
            <span>custom tooling</span>
          </h2>
          <p class="studio-p_lead text-style-main" data-reveal>
            The whole project lives in the Kinetic Studio, a tool Kinetic built for itself. {partner}'s brand book goes in first, and everything after is built from it.
          </p>
          <ul class="studio-p_points">
            {POINTS.map(([icon, title, body], i) => (
              <li class="studio-p_point" data-reveal style={`--reveal-delay:${(0.04 * i).toFixed(2)}s`}>
                <svg class="studio-p_icon" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d={ICONS[icon]} /></svg>
                <h3 class="studio-p_point-title text-style-h5">{title}</h3>
                <p class="studio-p_point-body text-style-label">{body}</p>
              </li>
            ))}
          </ul>
        </div>
        <div class="studio-p_stage" data-studio-stage data-reveal>
          <div class="studio-p_frame">
          <video data-src="/media/kinetic-studio.mp4" poster="/media/kinetic-studio.webp" muted loop playsinline preload="none" aria-label="The Kinetic Studio, in use" />
          <div class="studio-p_play">
            <button class="studio-p_film-btn" type="button" data-modal-open="studio-film" aria-label="Watch the film">
              <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M8 4.5v15l12-7.5z" fill="currentColor" /></svg>
            </button>
          </div>
          </div>
        </div>
      </div>
      <Modal id="studio-film" label="The Kinetic Studio film" variant="full-screen" class="studio-p_modal">
        <video class="studio-p_film" data-src="/media/studio-film.mp4" poster="/media/studio-film.webp" controls playsinline preload="none" />
      </Modal>
    </section>
  )
}

<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-studio-stage]").forEach((dev) => {
    const v = dev.querySelector<HTMLVideoElement>("video")!;
    new IntersectionObserver(
      ([e]) => {
        if (reduced) return;
        if (e.isIntersecting) {
          if (!v.src) v.src = v.dataset.src!;
          v.play().catch(() => {});
        } else v.pause();
      },
      { rootMargin: "10% 0px" },
    ).observe(dev);
  });
  // the film loads and plays with sound when its dialog opens, and stops when it closes
  document.querySelectorAll<HTMLDialogElement>("#studio-film").forEach((d) => {
    const film = d.querySelector<HTMLVideoElement>("video")!;
    new MutationObserver(() => {
      if (d.open) {
        if (!film.src) film.src = film.dataset.src!;
        film.play().catch(() => {});
      } else film.pause();
    }).observe(d, { attributes: true, attributeFilter: ["open"] });
  });
</script>

<style is:global>
  @layer components {
    /* black, after Nick's quote on white (Hunter, Nov 18; was a lighter grey) */
    .studio-p {
      --background: #000;
      background: var(--background);
      color: var(--text);
      padding: var(--section-space-large) var(--site-margin);
      overflow-x: clip;
    }
    /* the words on the left, the laptop on the right, turned toward them */
    .studio-p_inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(2rem, 4vw, 4rem);
      max-width: var(--max-width-main, 90rem);
      margin: 0 auto;
      @media (width < 56rem) {
        grid-template-columns: 1fr;
      }
    }
    .studio-p_text {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
    }
    /* the Kinetic Studio mark, a size up (Hunter, Nov 17) */
    .studio-p_lockup {
      font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    }
    .studio-p_title {
      display: flex;
      flex-direction: column;
      margin: 0;
      @media (width >= 56rem) {
        white-space: nowrap;
      }
    }
    .studio-p_lead {
      max-width: 40ch;
      margin: 0;
      color: color-mix(in srgb, var(--text) 72%, transparent);
    }
    .studio-p_points {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5) var(--space-6);
      width: 100%;
      margin: var(--space-3) 0;
      padding: 0;
      list-style: none;
      @media (width < 30rem) {
        grid-template-columns: 1fr;
      }
    }
    .studio-p_point {
      display: flex;
      flex-direction: column;
      gap: 0.75rem; /* more room between the title and its line (Hunter, Nov 17) */
      padding-top: var(--space-3);
      border-top: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
    }
    .studio-p_point-title,
    .studio-p_point-body {
      margin: 0;
    }
    .studio-p_point-title {
      font-size: clamp(1.05rem, 1.4vw, 1.3rem);
    }
    .studio-p_point-body {
      color: color-mix(in srgb, var(--text) 65%, transparent);
    }
    /* the Studio loop on a glow that rises out of the dark from the right (Hunter, Nov 17: "a gradient from left
       to right, where it looks like it's kind of full bleed off to the right"; no hard line on the left or the
       top): the stage runs off the window's right edge, its edges are the section's own dark, and the film
       itself runs off the right too */
    /* the film big, running off the right and the bottom of the section (Hunter, Nov 17: "The video should be
       bigger here. Full bleed towards the bottom"), its left and top edges melting into the grey */
    .studio-p_stage {
      --bleed: calc(var(--site-margin) + max(0px, (100vw - 2 * var(--site-margin) - var(--max-width-main, 90rem)) / 2));
      position: relative;
      align-self: stretch;
      display: flex;
      align-items: flex-end;
      min-height: 32rem;
      margin-right: calc(-1 * var(--bleed));
      margin-bottom: calc(-1 * var(--section-space-large));
      overflow: hidden;
      & .studio-p_frame {
        position: relative;
        flex: none;
        width: 150%;
      }
      & video {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        object-position: left top;
        -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 18%), linear-gradient(to bottom, transparent 0%, #000 16%);
        -webkit-mask-composite: source-in;
        mask-image: linear-gradient(to right, transparent 0%, #000 18%), linear-gradient(to bottom, transparent 0%, #000 16%);
        mask-composite: intersect;
      }
      @media (width < 56rem) {
        margin-left: calc(-1 * var(--site-margin));
        min-height: 0;
        & .studio-p_frame {
          width: 120%;
        }
      }
    }
    .studio-p_play {
      position: absolute;
      inset: 0 50% 0 0;
      display: grid;
      place-items: center;
      pointer-events: none;
      & > * {
        pointer-events: auto;
      }
    }
    /* a play button: just the triangle in a white circle (Hunter, Nov 17: no "Watch the film" label) */
    .studio-p_film-btn {
      display: grid;
      place-items: center;
      width: clamp(4.5rem, 6vw, 6rem);
      aspect-ratio: 1;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: var(--light-100);
      color: var(--dark-900);
      cursor: pointer;
      transition: transform 0.2s ease;
      &:hover {
        transform: scale(1.06);
      }
      & svg {
        display: block;
        width: 34%;
        height: auto;
        margin-left: 6%;
      }
    }
    .studio-p_icon {
      display: block;
      width: 1.75rem;
      height: 1.75rem;
      margin-bottom: 0.25rem;
      color: var(--brand-500);
    }
    .studio-p_modal .studio-p_film {
      display: block;
      width: 100%;
      height: 100%;
      max-height: 100svh;
      object-fit: contain;
      background: #000;
    }
  }
</style>
