---
import KineticLogo from "@/components/content/KineticLogo.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The line above the work; leave empty when the next section carries it (WorkField). */
  heading?: string;
}

const { render = true, heading = "Captivating websites that tell compelling stories" } = Astro.props;
---

{
  render && (
    <section class:list={["hero-lines_wrap", !heading && "is-bare"]} data-hero-lines>
      <div class="hero-lines_intro" aria-hidden="true">
        <div class="hero-lines_logo">
          <KineticLogo />
        </div>
      </div>
      {heading && (
        <div class="hero-lines_head">
          <h1 class="hero-lines_heading text-style-h4">
            {heading.split(" ").map((w) => (
              <span class="hero-lines_word"><span>{w}</span></span>
            ))}
          </h1>
        </div>
      )}
    </section>
  )
}

<script>
  import { gsap } from "gsap";
  import { HOME_LOOK } from "@/data/home-look.js";

  /* The intro plays by itself, no scroll: the lines fire in, KINETIC slides
     out, the logo flies up into the nav's corner, then the work comes in
     (WorkIndex with `intro` waits for "ks:intro-done"). A click, a key or a
     scroll skips to the end. It plays whenever you arrive at the homepage
     (a new visit, a reload, the Studio opening it); coming back from another
     page of the site, the nav's pill pulls the lines in instead. */
  document.querySelectorAll<HTMLElement>("[data-hero-lines]").forEach((root) => {
    const intro = root.querySelector<HTMLElement>(".hero-lines_intro")!;
    const logo = root.querySelector<HTMLElement>(".hero-lines_logo")!;
    // its width while the intro plays (HOME_LOOK.intro.logo; Hunter, Oct 24: "a little too big")
    logo.style.width = `min(100%, ${HOME_LOOK.intro.logo}rem)`;
    const words = root.querySelectorAll(".hero-lines_word > span");
    const nav = document.querySelector<HTMLElement>(".nav_wrap");
    const navLogo = document.querySelector<HTMLElement>(".nav_logo");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    // the nav marks a click on one of the site's own links
    let seen = false;
    try {
      seen = sessionStorage.getItem("ks-internal") === "1";
      sessionStorage.removeItem("ks-internal");
    } catch {}

    // the work starts coming in while the logo is still flying
    let shown = false;
    const reveal = () => {
      if (shown) return;
      shown = true;
      root.classList.add("is-in");
      gsap.fromTo(words, { yPercent: 110, y: 0 }, { yPercent: 0, y: 0, duration: reduced ? 0 : 1, stagger: 0.035, ease: "expo.out" });
      document.documentElement.dataset.intro = "done";
      window.dispatchEvent(new CustomEvent("ks:intro-done"));
    };
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      reveal();
      // the nav's logo takes over in the same frame the intro's goes: without
      // this its 0.4 s fade left just the pill's outline for a few frames
      nav?.classList.add("is-handover");
      nav?.classList.remove("logo-hidden");
      intro.hidden = true;
      requestAnimationFrame(() => requestAnimationFrame(() => nav?.classList.remove("is-handover")));
      removeEventListener("wheel", skip);
      removeEventListener("keydown", skip);
      removeEventListener("touchmove", skip);
      intro.removeEventListener("click", skip);
    };
    const skip = () => {
      dock?.kill();
      finish();
    };

    // the move from the centre to the nav's logo: the same 690 x 201 drawing
    let dock: gsap.core.Tween | null = null;
    const toCorner = () => {
      if (done || !navLogo) return finish();
      const a = logo.getBoundingClientRect();
      const b = navLogo.getBoundingClientRect();
      const scale = b.width / a.width;
      dock = gsap.to(logo, {
        // up into the corner as the lines land, the one move carrying on (Oct 29: "It should feel more like one
        // fluid movement"): expo.inOut's long slow start held the finished mark still, and power3's middle was
        // a whoosh next to everything round it ("Something still does feel jumpy about it"), so power2
        x: b.left - a.left, y: b.top - a.top, scale, transformOrigin: "0 0", duration: HOME_LOOK.intro.dockFor, ease: "sine.inOut",
        onUpdate() { if (this.progress() > 0.55) reveal(); },
        onComplete: finish,
      });
    };

    if (seen || reduced) {
      finish();
      return;
    }
    nav?.classList.add("logo-hidden");
    addEventListener("wheel", skip, { passive: true });
    addEventListener("keydown", skip);
    addEventListener("touchmove", skip, { passive: true });
    intro.addEventListener("click", skip);
    // straight on: the logo says it is built as its lines finish collapsing, so the two read as one move
    root.addEventListener("kinetic-logo:built", toCorner);
  });
</script>

<style is:global>
  @layer components {
    .hero-lines_wrap {
      position: relative;
      padding: calc(var(--nav-height) + var(--space-3)) var(--site-margin) var(--space-6);
    }
    .hero-lines_wrap.is-bare {
      padding: 0;
    }
    .hero-lines_intro {
      position: fixed;
      inset: 0;
      z-index: 55;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 var(--site-margin);
      cursor: pointer;
      &[hidden] {
        display: none;
      }
    }
    .hero-lines_logo {
      width: min(100%, 44rem);
      will-change: transform;
    }
    .hero-lines_heading {
      max-width: 28ch;
      margin: 0;
    }
    .hero-lines_word {
      display: inline-block;
      overflow: hidden;
      vertical-align: top;
      padding-right: 0.2em;
      & > span {
        display: inline-block;
        transform: translateY(110%);
      }
    }
  }
</style>
