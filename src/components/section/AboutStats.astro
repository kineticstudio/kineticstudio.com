---
import { STATS } from "@/data/work.js";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
/* The studio's numbers, a row of their own under Hunter's (Hunter, Oct 25:
   "Let's have the stats in a different section"): three big figures across
   the page, each over its line. */
---

{
  render && (
    <section class="stats_wrap" aria-label="The studio in numbers">
      <ul class="stats_list">
        {STATS.map((s, i) => (
          <li class="stats_item" data-reveal style={`--reveal-delay:${0.08 * i}s`}>
            <span class="stats_num text-style-figure" data-count={s.value}>{s.value}</span>
            <span class="stats_label text-style-label">{s.label}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}

<script>
  /* Each figure counts up from nothing as it scrolls in (Hunter, Oct 30: "Increment these numbers up as I
     scroll in"), with its row's reveal; the page itself carries the final figures, so without the script,
     or with reduced motion, they simply show. */
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const els = [...document.querySelectorAll<HTMLElement>(".stats_num[data-count]")];
  if (!reduced && "IntersectionObserver" in window) {
    const parts = (v: string) => {
      const m = v.match(/^(\D*)([\d,]+)(.*)$/);
      return m ? { pre: m[1], n: Number(m[2].replace(/,/g, "")), post: m[3] } : null;
    };
    const run = (el: HTMLElement, delay: number) => {
      const p = parts(el.dataset.count!);
      if (!p) return;
      const dur = 1400, t0 = performance.now() + delay;
      const step = (now: number) => {
        const u = Math.min(1, Math.max(0, (now - t0) / dur));
        el.textContent = `${p.pre}${Math.round(p.n * (1 - (1 - u) ** 3)).toLocaleString("en-US")}${p.post}`;
        if (u < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          run(e.target as HTMLElement, els.indexOf(e.target as HTMLElement) * 80);
        }
      },
      { threshold: 0.4 },
    );
    for (const el of els) {
      const p = parts(el.dataset.count!);
      if (!p) continue;
      el.textContent = `${p.pre}0${p.post}`;
      io.observe(el);
    }
  }
</script>

<style is:global>
  @layer components {
    .stats_wrap {
      padding: 0 var(--site-margin) var(--section-space-large);
    }
    .stats_list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: var(--border-width) solid var(--border);
      @media (width < 40rem) {
        grid-template-columns: 1fr;
      }
    }
    .stats_item {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding: var(--space-6) var(--space-4) 0 0;
      & + .stats_item {
        padding-left: var(--space-5);
        border-left: var(--border-width) solid var(--border);
      }
      @media (width < 40rem) {
        padding: var(--space-5) 0;
        & + .stats_item {
          padding-left: 0;
          border-left: 0;
          border-top: var(--border-width) solid var(--border);
        }
      }
    }
    .stats_label {
      color: color-mix(in srgb, var(--text) 60%, transparent);
    }
  }
</style>
