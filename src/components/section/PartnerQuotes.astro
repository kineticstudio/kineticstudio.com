---
import DATA from "@/data/testimonials.json";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Which page's quotes (each entry lists the pages it may appear on). */
  page: string;
  /** "dark" to sit between dark sections; "neon" on Primary's neon (/primary, Hunter, Nov 17: "the neon yellow
      from Primary Studio's colors as a background"). */
  theme?: "dark" | "neon";
}

const { render = true, page, theme } = Astro.props;
/* Client words in one line, running slowly under the hero (Hunter, Nov 17: a marquee of testimonials below
   a hero). They come from src/data/testimonials.json, and only approved ones render: a preview build with
   PUBLIC_DRAFT_QUOTES=1 also shows unapproved ones, each marked Draft, so the placement can be judged before
   anyone has said yes. Confidential clients never show here. Text only, no cards; the line is cut hard at
   the page's edges, no fade; it pauses under the pointer. */
const drafts = import.meta.env.PUBLIC_DRAFT_QUOTES === "1" || process.env.KS_STUDIO_BUILD === "1"; // previews and the Studio copy show drafts
type Q = { id: string; quote: string; name: string; role?: string; company: string; approved: boolean; confidential?: boolean; pages: string[] };
const quotes = (DATA.quotes as Q[]).filter((q) => q.pages.includes(page) && !q.confidential && !(q as { featured?: boolean }).featured && (q.approved || drafts));
const by = (q: Q) => [q.name, q.role, q.company].filter(Boolean).join(", ");
---

{
  render && quotes.length > 0 && (
    <section class:list={["quotes", theme === "dark" && "theme-dark", theme === "neon" && "is-neon"]} aria-label="What clients say">
      <div class="quotes_track" style={`--count:${quotes.length}`}>
        {[0, 1].map((copy) => (
          <ul class="quotes_set" aria-hidden={copy === 1 ? "true" : undefined}>
            {quotes.map((q) => (
              <li class="quotes_item">
                {/* no attribution in the marquee (Hunter, Nov 17); the names are in the data and the approvals */}
                <blockquote class="quotes_quote" aria-label={`${q.quote}, ${by(q)}`}>{q.quote}</blockquote>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </section>
  )
}

<style is:global>
  @layer components {
    .quotes {
      width: 100%;
      background: var(--background);
      color: var(--text);
      overflow: hidden;
      padding-block: 0; /* on the quotes, so the hairlines between them run the band's full height (Hunter, Nov 18) */
      border-block: 1px solid color-mix(in srgb, var(--text) 12%, transparent);
    }
    .quotes_track {
      display: flex;
      width: max-content;
      /* about nine seconds a quote, right to left */
      animation: quotes-run calc(var(--count) * 9s) linear infinite;
    }
    .quotes:hover .quotes_track {
      animation-play-state: paused;
    }
    /* a hairline between quotes (Hunter, Nov 17: "vertical dividers") */
    .quotes_set {
      display: flex;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .quotes_item {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      width: clamp(17rem, 30vw, 28rem);
      padding: var(--space-6) clamp(1.5rem, 3vw, 3rem);
      border-left: 1px solid color-mix(in srgb, var(--text) 28%, transparent);
    }
    .quotes_quote {
      margin: 0;
      font-size: clamp(1.1rem, 1.45vw, 1.4rem);
      line-height: 1.25;
      text-wrap: pretty;
    }
    .quotes_quote::before {
      content: "\201C";
    }
    .quotes_quote::after {
      content: "\201D";
    }
    .quotes_by {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0;
      color: color-mix(in srgb, var(--text) 60%, transparent);
    }
    .quotes_draft {
      padding: 0.05rem 0.45rem;
      border-radius: 99rem;
      background: var(--brand-500);
      color: #111;
    }
    /* Primary's neon, ink on it */
    .quotes.is-neon {
      --background: var(--brand-500);
      --text: #111;
      border-block: 0;
      & .quotes_by {
        color: #111;
      }
      & .quotes_draft {
        background: #111;
        color: var(--brand-500);
      }
    }
    /* left to right (Hunter, Nov 17) */
    @keyframes quotes-run {
      from {
        transform: translateX(-50%);
      }
      to {
        transform: translateX(0);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .quotes_track {
        animation: none;
      }
      .quotes {
        overflow-x: auto;
      }
    }
  }
</style>
