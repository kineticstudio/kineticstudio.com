---
import MarkLockup from "@/components/content/MarkLockup.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
/* The Creative Studio, the studio's own tool (Hunter, Oct 25: "Let's make
   this section dark mode, and then make sure we use the Kinetic Studio tool
   logo somewhere. Let's have a headline that makes it clear it's a
   custom-built tool ... a subhead that's clear that it's a tool that helps,
   exclusively for Kinetic Studio"). Dark from edge to edge whatever the
   page's theme: the mark with STUDIO TOOL in its pill (Oct 25), the headline,
   the subhead beside it, and the film of the tool under them. */
---

{
  render && (
    <section class="reel_wrap theme-dark" aria-labelledby="reel-title">
      <div class="reel_inner">
        <div class="reel_head">
          <div class="reel_name" data-reveal>
            <MarkLockup class="reel_lockup" label="Studio tool" />
          </div>
          <h2 id="reel-title" class="reel_title text-style-h2" data-reveal style="--reveal-delay:0.06s">Custom tooling for bleeding-edge creative work.</h2>
          <p class="reel_lead text-style-main" data-reveal style="--reveal-delay:0.12s">
            The Creative Studio is a tool Kinetic made for itself and no one else uses. Every sitemap, wireframe, prototype, design round and launch lives in it, so your project moves from first sketch to live site faster, with nothing lost along the way.
          </p>
        </div>
        {/* the Studio tool film (iCloud 💻 Kinetic/twitter/kinetic-studio-tool.mp4), cut for the web */}
        <figure class="reel_frame" data-reveal>
          <video data-loop data-src="/media/studio-film.mp4" data-poster="/media/studio-film.webp" muted loop playsinline preload="none" aria-label="The Kinetic Creative Studio, in motion" />
        </figure>
      </div>
    </section>
  )
}

<script>
  import { LITE } from "@/scripts/lite.js";
  /* Phones loop five seconds of the film (from 0:39, the moment the homepage's tool card shows) cut at
     phone size, 533 KB, instead of the whole 84 s film at 13.8 MB (src/scripts/lite.js); the loop
     itself starts when the frame is on screen (site.js watchLoops). */
  document.querySelectorAll<HTMLVideoElement>(".reel_frame video").forEach((v) => {
    if (LITE) v.dataset.src = "/media/studio-film-phone.mp4";
    v.poster = LITE ? "/media/studio-film-card-640.webp" : v.dataset.poster!;
  });
</script>

<style is:global>
  @layer components {
    .reel_wrap {
      background: var(--background);
      color: var(--text);
      padding: var(--section-space-large) var(--site-margin);
    }
    .reel_inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
      max-width: var(--max-width-main);
      margin: 0 auto;
    }
    .reel_head {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas:
        "name name"
        "title lead";
      column-gap: var(--space-8);
      row-gap: var(--space-5);
      align-items: start;
      @media (width < 48rem) {
        grid-template-columns: 1fr;
        grid-template-areas: "name" "title" "lead";
        row-gap: var(--space-4);
      }
    }
    /* the tool's own lockup, the way the tool signs itself */
    .reel_name {
      grid-area: name;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: var(--text);
    }
    .reel_lockup {
      font-size: 2.25rem;
    }
    .reel_title,
    .reel_lead {
      margin: 0;
    }
    .reel_title {
      grid-area: title;
      max-width: 14ch;
    }
    .reel_lead {
      grid-area: lead;
      max-width: 40ch;
      color: color-mix(in srgb, var(--text) 75%, transparent);
    }
    .reel_frame {
      margin: 0;
      overflow: hidden;
      border-radius: var(--radius-media);
      aspect-ratio: 16 / 9;
      background: #000;
      & video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }
  }
</style>
