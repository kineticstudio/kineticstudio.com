---
import Section from "@/components/wrapper/Section.astro";
import kineticRaw from "@/assets/brand/logo.svg?raw";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The headline; a "|" breaks it onto a second line. */
  heading: string;
  /** A line under the headline. */
  lead?: string;
  /** Week labels, in order (weeks, then what comes after); each week is five working days. */
  columns: string[];
  /** One lane per studio: its phases, each spanning weeks `from` to `to` (1-based, inclusive). */
  lanes: {
    name: string;
    /** "partner" (the partner's colour, on the left) or "kinetic" (ink, on the right). */
    kind: "partner" | "kinetic";
    bars: { title: string; note: string; from: number; to: number; when: string; soft?: boolean }[];
  }[];
  /** The partner's wordmark, raw SVG, over its lane. */
  partnerLogo?: string;
  /** A few short points under the timeline. */
  points?: { title: string; body: string }[];
}

const { render = true, heading, lead, columns, lanes, partnerLogo, points = [] } = Astro.props;
/* How the two studios hand off, day by day (Nick, Nov 9: "some clear process and timeline stuff"; Hunter,
   Nov 9: four weeks of web). Nov 17 (Hunter): "As I scroll down ... the primary logo and the Kinetic logo. In
   the middle, we have a timeline, and it's actually built out by days. You see a stronger line to show what
   the day is. All of the phases are built out by ... little perfect squares, tiny little squares, almost like
   pixels. The phase can be smaller ... a much smaller typeface."
   Primary's lane on the left under its logo, Kinetic's on the right under its own, the days down the
   middle. Each phase is a block of tiny squares, faint until the day line reaches it; the line is where the
   scroll has got to, and the squares of each day light up at random as it passes. Nothing is pinned: the
   page scrolls as ever. Reduced motion: every phase lit, no line. */
const DAYS = columns.length * 5;
const day = (week: number, end = false) => (end ? week * 5 : (week - 1) * 5 + 1);
const partner = lanes.find((l) => l.kind === "partner");
const kinetic = lanes.find((l) => l.kind === "kinetic");
const phases = [partner, kinetic].flatMap((lane) =>
  (lane?.bars ?? []).map((b) => ({ ...b, kind: lane!.kind, d0: day(b.from), d1: day(b.to, true) })),
);
const launch = (columns.findIndex((c) => /after/i.test(c)) + 1 || columns.length + 1) - 1; // weeks before launch
const clean = (svg: string, label: string) =>
  svg
    .replace(/<!--[\s\S]*?-->/g, "")
    .replace(/\sid="[^"]*"/g, "")
    .replace(/\saria-label="[^"]*"/g, "")
    .replace(/<svg /, `<svg role="img" aria-label="${label}" `);
---

{
  render && (
    <Section theme="dark" paddingTop="large" paddingBottom="large" class="process" gap="0">
      <div class="process_head" data-reveal>
        <h2 class="process_title text-style-h2">
          {heading.split("|").map((line) => <span>{line.trim()}</span>)}
        </h2>
        {lead && <p class="process_lead text-style-main">{lead}</p>}
      </div>
      <div class="tl" style={`--days:${DAYS}`} data-tl data-days={DAYS} data-launch={launch * 5}>
        <div class="tl_logo is-partner">{partnerLogo ? <span set:html={clean(partnerLogo, partner?.name ?? "Partner")} /> : <span class="text-style-h5">{partner?.name}</span>}</div>
        <div class="tl_logo is-kinetic"><span set:html={clean(kineticRaw, "Kinetic")} /></div>
        <div class="tl_body">
          <canvas class="tl_canvas" aria-hidden="true" />
          <div class="tl_lane is-partner" data-lane="partner" />
          <div class="tl_axis" data-axis />
          <div class="tl_lane is-kinetic" data-lane="kinetic" />
          {columns.map((c, i) => (
            <span class="tl_week text-style-label" style={`--d:${i * 5}`}>{c}</span>
          ))}
          {phases.map((p) => (
            <div class:list={["tl_phase", `is-${p.kind}`, p.soft && "is-soft"]} style={`--d0:${p.d0 - 1};--d1:${p.d1}`} data-phase={p.kind} data-d0={p.d0} data-d1={p.d1}>
              <span class="tl_phase-title text-style-label">{p.title}</span>
              <span class="tl_phase-when text-style-label">{p.when}</span>
            </div>
          ))}
          <div class="tl_now" data-now aria-hidden="true">
            <span class="tl_now-label text-style-label" data-now-label>Day 1</span>
          </div>
        </div>
        <ol class="sr-only">
          {phases.map((p) => (
            <li>{`${p.kind === "partner" ? partner?.name : kinetic?.name}: ${p.title}, ${p.when}. ${p.note}`}</li>
          ))}
        </ol>
      </div>
      {points.length > 0 && (
        <ul class="process_points">
          {points.map((p, i) => (
            <li class="process_point" data-reveal style={`--reveal-delay:${(0.06 * i).toFixed(2)}s`}>
              <h3 class="process_point-title text-style-h5">{p.title}</h3>
              <p class="process_point-body text-style-main">{p.body}</p>
            </li>
          ))}
        </ul>
      )}
    </Section>
  )
}

<script>
  /* The pixel timeline. One canvas over the body: each phase's block of its lane is a grid of tiny squares
     (PITCH apart, SIZE across), a few rows to a day. A square belongs to a day; it lights once the day line
     has passed that day plus its own random share of it, so a day fills in like pixels popping on as the
     line goes by. Unlit squares stay faint, so the plan is there from the start. The day line follows the
     scroll: day 0 as the chart's top reaches 70% down the window, the last day as its bottom does, eased. */
  const PITCH = 6, SIZE = 4;
  const NEON = [200, 255, 84], INK = [238, 241, 234];
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-tl]").forEach((tl) => {
    const body = tl.querySelector<HTMLElement>(".tl_body")!;
    const canvas = tl.querySelector<HTMLCanvasElement>(".tl_canvas")!;
    const ctx = canvas.getContext("2d")!;
    const now = tl.querySelector<HTMLElement>("[data-now]")!;
    const nowLabel = tl.querySelector<HTMLElement>("[data-now-label]")!;
    const DAYS = Number(tl.dataset.days), LAUNCH = Number(tl.dataset.launch);
    type Cell = { x: number; y: number; day: number; r: number; rgb: number[]; soft: boolean };
    let cells: Cell[] = [], W = 0, H = 0, dpr = 1, dayH = 18, axis = { x: 0, w: 0 };
    let seed = 3;
    const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647;

    const build = () => {
      const B = body.getBoundingClientRect();
      W = B.width;
      H = B.height;
      dayH = H / DAYS;
      dpr = Math.min(2, devicePixelRatio || 1);
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      const a = tl.querySelector<HTMLElement>("[data-axis]")!.getBoundingClientRect();
      axis = { x: a.left - B.left, w: a.width };
      seed = 3;
      cells = [];
      const rowsPerDay = Math.max(1, Math.round(dayH / PITCH));
      for (const ph of tl.querySelectorAll<HTMLElement>("[data-phase]")) {
        const lane = tl.querySelector<HTMLElement>(`[data-lane="${ph.dataset.phase}"]`)!.getBoundingClientRect();
        const partner = ph.dataset.phase === "partner";
        const d0 = Number(ph.dataset.d0), d1 = Number(ph.dataset.d1);
        // the squares hug the axis: the partner's block ends at its lane's right edge, Kinetic's starts at its left
        const cols = Math.floor((lane.width + (PITCH - SIZE)) / PITCH);
        const x0 = partner ? lane.right - B.left - cols * PITCH + (PITCH - SIZE) : lane.left - B.left;
        for (let d = d0; d <= d1; d++) {
          for (let r = 0; r < rowsPerDay; r++) {
            const y = (d - 1) * dayH + (r * dayH) / rowsPerDay + (dayH / rowsPerDay - SIZE) / 2;
            for (let c = 0; c < cols; c++) {
              cells.push({ x: x0 + c * PITCH, y, day: d - 1, r: rand(), rgb: partner ? NEON : INK, soft: ph.classList.contains("is-soft") });
            }
          }
        }
      }
    };

    let target = reduced ? DAYS : 0, cur = target, raf = 0;
    const draw = () => {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      // the days down the middle: a short tick each day, a longer one each week
      ctx.fillStyle = "rgba(238,241,234,0.22)";
      for (let d = 0; d <= DAYS; d++) {
        const w = d % 5 === 0 ? axis.w * 0.5 : axis.w * 0.18;
        ctx.fillRect(axis.x + (axis.w - w) / 2, Math.round(d * dayH), w, 1);
      }
      for (const c of cells) {
        const lit = Math.min(1, Math.max(0, (cur - (c.day + c.r)) * 3));
        const a = (c.soft ? 0.38 : 1) * lit + 0.09 * (1 - lit);
        ctx.fillStyle = `rgba(${c.rgb[0]},${c.rgb[1]},${c.rgb[2]},${a.toFixed(3)})`;
        ctx.fillRect(c.x, c.y, SIZE, SIZE);
      }
      // the day line, stronger, across everything
      const y = Math.min(DAYS, cur) * dayH;
      now.style.transform = `translateY(${y.toFixed(1)}px)`;
      const d = Math.min(DAYS, Math.max(1, Math.ceil(cur)));
      nowLabel.textContent = d > LAUNCH ? "After launch" : d === LAUNCH ? "Launch" : `Day ${d}`;
    };
    const tick = () => {
      raf = 0;
      cur += (target - cur) * 0.18;
      if (Math.abs(target - cur) < 0.002) cur = target;
      draw();
      if (cur !== target) raf = requestAnimationFrame(tick);
    };
    const onScroll = () => {
      if (reduced) return;
      const r = body.getBoundingClientRect(), start = innerHeight * 0.7;
      target = Math.min(DAYS, Math.max(0, ((start - r.top) / r.height) * DAYS));
      if (!raf) raf = requestAnimationFrame(tick);
    };
    new ResizeObserver(() => {
      build();
      onScroll();
      draw();
    }).observe(body);
    addEventListener("scroll", onScroll, { passive: true });
    tl.classList.toggle("is-still", reduced);
  });
</script>

<style is:global>
  @layer components {
    .process_head {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      width: 100%;
      margin-bottom: var(--space-8);
    }
    .process_title {
      display: flex;
      flex-direction: column;
      margin: 0;
    }
    .process_lead {
      max-width: 44ch;
      margin: 0;
      color: color-mix(in srgb, var(--text) 72%, transparent);
    }
    /* Primary's lane | the days | Kinetic's lane, each lane with its phases' names on its outer side */
    /* the lanes are narrow and hug the days, the phases' names beside them, the whole thing centred */
    .tl {
      --day-h: 18px;
      --axis-w: 5.5rem;
      --lane-w: clamp(7rem, 17vw, 15rem);
      --label-w: 9rem;
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--lane-w) var(--axis-w) var(--lane-w) minmax(0, 1fr);
      grid-template-rows: auto auto;
      row-gap: var(--space-5);
      width: 100%;
      @media (width < 48rem) {
        --day-h: 12px;
        --axis-w: 3.25rem;
        --lane-w: 4.5rem;
        --label-w: 6rem;
      }
    }
    .tl_logo {
      grid-row: 1;
      display: flex;
      align-items: flex-end;
      height: 1.75rem;
      color: var(--text);
      & svg {
        display: block;
        width: auto;
        height: 100%;
      }
      @media (width < 48rem) {
        height: 1.25rem;
      }
    }
    .tl_logo.is-partner {
      grid-column: 2;
      justify-content: flex-end;
      & span {
        height: 86%;
      }
    }
    .tl_logo.is-kinetic {
      grid-column: 4;
      justify-content: flex-start;
      & span {
        height: 100%;
      }
    }
    .tl_body {
      position: relative;
      grid-row: 2;
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: subgrid;
      height: calc(var(--days) * var(--day-h));
    }
    .tl_canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
    .tl_lane.is-partner {
      grid-column: 2;
    }
    .tl_axis {
      grid-column: 3;
    }
    .tl_lane.is-kinetic {
      grid-column: 4;
    }
    /* week names in the middle, at each week's first day */
    .tl_week {
      position: absolute;
      top: calc(var(--d) * var(--day-h) + 4px);
      left: calc(50% - var(--axis-w) / 2);
      width: var(--axis-w);
      text-align: center;
      color: color-mix(in srgb, var(--text) 50%, transparent);
      white-space: nowrap;
      font-size: 0.6875rem;
      @media (width < 48rem) {
        font-size: 0.5625rem;
      }
    }
    /* each phase's name, small, on its lane's outer side at its first day */
    .tl_phase {
      position: absolute;
      top: calc(var(--d0) * var(--day-h));
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      width: calc(50% - var(--axis-w) / 2 - var(--lane-w)); /* the outer column beside its lane */
      max-width: var(--label-w);
      font-size: 0.6875rem;
      line-height: 1.25;
      & > * {
        font-size: inherit;
      }
      @media (width < 48rem) {
        font-size: 0.5625rem;
      }
    }
    .tl_phase.is-partner {
      right: calc(50% + var(--axis-w) / 2 + var(--lane-w));
      padding-right: 0.75rem;
      text-align: right;
    }
    .tl_phase.is-kinetic {
      left: calc(50% + var(--axis-w) / 2 + var(--lane-w));
      padding-left: 0.75rem;
    }
    .tl_phase-title {
      color: var(--text);
    }
    .tl_phase-when {
      color: color-mix(in srgb, var(--text) 50%, transparent);
    }
    .tl_phase.is-soft .tl_phase-title {
      color: color-mix(in srgb, var(--text) 70%, transparent);
    }
    /* the day line: the scroll's day, a stronger rule across the chart, its day in the middle */
    .tl_now {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 0;
      border-top: 1px solid color-mix(in srgb, var(--text) 85%, transparent);
      will-change: transform;
      pointer-events: none;
    }
    .tl_now-label {
      position: absolute;
      top: 0;
      left: calc(50% - var(--axis-w) / 2);
      width: var(--axis-w);
      translate: 0 -50%;
      padding: 0.15rem 0;
      background: var(--background);
      color: var(--text);
      text-align: center;
      white-space: nowrap;
      font-size: 0.6875rem;
      @media (width < 48rem) {
        font-size: 0.5625rem;
      }
    }
    .tl.is-still .tl_now {
      display: none;
    }
    .process_points {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
      width: 100%;
      margin: var(--space-8) 0 0;
      padding: 0;
      list-style: none;
      @media (width < 36rem) {
        grid-template-columns: 1fr;
      }
    }
    .process_point {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding-top: var(--space-4);
      border-top: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
    }
    .process_point-title,
    .process_point-body {
      margin: 0;
    }
    .process_point-body {
      max-width: 40ch;
      color: color-mix(in srgb, var(--text) 72%, transparent);
    }
  }
</style>
