---
import Section from "@/components/wrapper/Section.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The headline; a "|" breaks it onto a second line. */
  heading: string;
  /** A line under the headline. */
  lead?: string;
  /** Column labels, left to right (weeks, then what comes after). */
  columns: string[];
  /** One lane per studio: its bars, each spanning columns `from` to `to` (1-based, inclusive). */
  lanes: {
    name: string;
    /** The lane's fill: "partner" (the partner's colour) or "kinetic" (ink). */
    kind: "partner" | "kinetic";
    bars: { title: string; note: string; from: number; to: number; when: string; soft?: boolean }[];
  }[];
  /** A few short points under the timeline. */
  points?: { title: string; body: string }[];
}

const { render = true, heading, lead, columns, lanes, points = [] } = Astro.props;
/* How the two studios hand off, week by week (Nick, Nov 9: "some clear process and timeline stuff";
   Hunter, Nov 9: four weeks of web). Nov 17 (Hunter): dark, and vertical "so you see the days kind of stack
   up, and then the ideas kind of bleed off to the right with Kinetic": the weeks run down the left, Primary
   has its own column, and Kinetic's column runs off the page's right edge. The particle script reads each
   bar's box, so it works in any layout. Nothing moves with the scroll. */
const rows = columns.length;
const partner = lanes.find((l) => l.kind === "partner");
const kinetic = lanes.find((l) => l.kind === "kinetic");
---

{
  render && (
    <Section theme="dark" paddingTop="large" paddingBottom="large" class="process" gap="0">
      <div class="process_head" data-reveal>
        <h2 class="process_title text-style-h2">
          {heading.split("|").map((line) => <span>{line.trim()}</span>)}
        </h2>
        {lead && <p class="process_lead text-style-main">{lead}</p>}
      </div>
      <div class="process_chart" style={`--rows:${rows}`} data-process>
        <canvas class="process_particles" aria-hidden="true" />
        <span class="process_lane-name text-style-h5" style="grid-column:2;grid-row:1">{partner?.name}</span>
        <span class="process_lane-name text-style-h5" style="grid-column:3;grid-row:1">{kinetic?.name}</span>
        {columns.map((c, i) => (
          <>
            <span class="process_rule" style={`grid-row:${i + 2}`} aria-hidden="true" />
            <span class="process_week text-style-label" style={`grid-row:${i + 2}`}>{c}</span>
          </>
        ))}
        {[partner, kinetic].map((lane, col) =>
          lane?.bars.map((b) => (
            <div
              class:list={["process_bar", `is-${lane.kind}`, b.soft && "is-soft"]}
              style={`grid-column:${col + 2};grid-row:${b.from + 1} / ${b.to + 2}`}
              data-bar={lane.kind}
            >
              <span class="process_bar-title text-style-h5">{b.title}</span>
              <span class="process_bar-note text-style-label">{b.note}</span>
            </div>
          )),
        )}
      </div>
      {points.length > 0 && (
        <ul class="process_points">
          {points.map((p, i) => (
            <li class="process_point" data-reveal style={`--reveal-delay:${(0.06 * i).toFixed(2)}s`}>
              <h3 class="process_point-title text-style-h5">{p.title}</h3>
              <p class="process_point-body text-style-main">{p.body}</p>
            </li>
          ))}
        </ul>
      )}
    </Section>
  )
}

<script>
  /* Knowledge passing between the studios (Hunter, Nov 17: "visualize it with particles, like knowledge going
     between ... Primary gets started, and then particles come down and start to build out the Kinetic
     timeline work"). When the chart comes on screen: Primary's bar fills, then particles leave it and land in
     each Kinetic bar in turn, lime turning to the bar's colour as they arrive, and each bar fills as its
     particles land. Then a light trickle keeps passing between the lanes while the chart is on screen. Plays
     once; nothing is tied to the scroll. Reduced motion: the finished chart, no particles. */
  const LIME = [200, 255, 84];
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);
  const rgb = (c: string) => (c.match(/[\d.]+/g) || ["0", "0", "0"]).slice(0, 3).map(Number);
  document.querySelectorAll<HTMLElement>("[data-process]").forEach((chart) => {
    if (reduced) return;
    const canvas = chart.querySelector<HTMLCanvasElement>(".process_particles")!;
    const ctx = canvas.getContext("2d")!;
    const source = chart.querySelector<HTMLElement>('[data-bar="partner"]');
    const targets = [...chart.querySelectorAll<HTMLElement>('[data-bar="kinetic"]')];
    if (!source || !targets.length) return;
    chart.classList.add("is-armed");
    const fills = new Map<HTMLElement, number>([[source, 0], ...targets.map((t) => [t, 0] as [HTMLElement, number])]);
    const setFill = (el: HTMLElement, f: number) => { fills.set(el, f); el.style.setProperty("--fill", f.toFixed(3)); };
    let dpr = 1, W = 0, H = 0;
    const rect = (el: HTMLElement) => { const c = chart.getBoundingClientRect(), r = el.getBoundingClientRect(); return { x: r.left - c.left, y: r.top - c.top, w: r.width, h: r.height }; };
    const size = () => { const r = chart.getBoundingClientRect(); dpr = Math.min(2, devicePixelRatio || 1); W = r.width; H = r.height; canvas.width = W * dpr; canvas.height = H * dpr; };
    new ResizeObserver(size).observe(chart); size();
    // how many particles each Kinetic bar takes to fill, by its area
    const need = targets.map((t) => { const r = rect(t); return Math.min(70, Math.max(26, Math.round((r.w * r.h) / 700))); });
    const got = targets.map(() => 0);
    const end = targets.map((t) => { const c = getComputedStyle(t).backgroundColor; const a = /rgba/.test(c) ? 0.55 : 1; return [...rgb(c), a]; });
    type P = { t: number; dur: number; sx: number; sy: number; cx: number; cy: number; ex: number; ey: number; k: number; r: number; ambient: boolean };
    const parts: P[] = [];
    const spawn = (k: number, ambient = false) => {
      const s = rect(source), d = rect(targets[k]);
      const sx = s.x + s.w * (0.1 + Math.random() * 0.8), sy = s.y + s.h * (0.55 + Math.random() * 0.4);
      // land just behind the bar's filling edge, so it builds left to right
      const front = ambient ? Math.random() : Math.min(1, got[k] / need[k] + 0.12);
      const ex = d.x + d.w * Math.max(0.03, front * Math.random()), ey = d.y + d.h * (0.15 + Math.random() * 0.7);
      const cx = (sx + ex) / 2 + (Math.random() - 0.5) * 80, cy = Math.min(sy, ey) + Math.abs(ey - sy) * (0.2 + Math.random() * 0.5);
      parts.push({ t: 0, dur: 700 + Math.random() * 600, sx, sy, cx, cy, ex, ey, k, r: 1.4 + Math.random() * 1.4, ambient });
    };
    let phase = 0, phaseT = 0, last = 0, acc = 0, cur = 0, onScreen = false, raf = 0, ambientAcc = 0;
    const frame = (now: number) => {
      const dt = Math.min(50, now - (last || now)); last = now; phaseT += dt;
      if (phase === 0) { setFill(source, ease(Math.min(1, phaseT / 900))); if (phaseT > 1000) { phase = 1; phaseT = 0; } }
      else if (phase === 1) {
        // stream into the current bar until it has what it needs in flight, then move to the next
        acc += dt * 0.12;
        while (acc >= 1 && cur < targets.length) { acc -= 1; spawn(cur); if (parts.filter((p) => !p.ambient && p.k === cur).length + got[cur] >= need[cur]) cur++; }
        if (cur >= targets.length && !parts.some((p) => !p.ambient)) phase = 2;
      } else {
        ambientAcc += dt * 0.006;
        while (ambientAcc >= 1) { ambientAcc -= 1; spawn(Math.floor(Math.random() * targets.length), true); }
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, W, H);
      for (let i = parts.length - 1; i >= 0; i--) {
        const p = parts[i]; p.t += dt; const u = Math.min(1, p.t / p.dur), e = ease(u);
        const x = (1 - e) * (1 - e) * p.sx + 2 * (1 - e) * e * p.cx + e * e * p.ex;
        const y = (1 - e) * (1 - e) * p.sy + 2 * (1 - e) * e * p.cy + e * e * p.ey;
        const c = end[p.k], m = Math.min(1, Math.max(0, (u - 0.35) / 0.65));
        const col = [0, 1, 2].map((j) => Math.round(LIME[j] + (c[j] - LIME[j]) * m));
        const a = p.ambient ? 0.5 * Math.sin(Math.PI * u) : u > 0.92 ? (1 - u) / 0.08 : 1;
        ctx.fillStyle = `rgba(${col[0]},${col[1]},${col[2]},${a})`;
        ctx.beginPath(); ctx.arc(x, y, p.r * (u > 0.85 && !p.ambient ? (1 - u) / 0.15 + 0.2 : 1), 0, Math.PI * 2); ctx.fill();
        if (u >= 1) {
          parts.splice(i, 1);
          if (!p.ambient) { got[p.k]++; setFill(targets[p.k], ease(Math.min(1, got[p.k] / need[p.k]))); }
        }
      }
      raf = onScreen ? requestAnimationFrame(frame) : 0;
    };
    new IntersectionObserver(([e]) => {
      onScreen = e.isIntersecting;
      if (onScreen && !raf) { last = 0; raf = requestAnimationFrame(frame); }
    }, { threshold: 0.35 }).observe(chart);
  });
</script>

<style is:global>
  @layer components {
    .process_head {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      width: 100%;
      margin-bottom: var(--space-8);
    }
    .process_title {
      display: flex;
      flex-direction: column;
      margin: 0;
    }
    .process_lead {
      max-width: 44ch;
      margin: 0;
      color: color-mix(in srgb, var(--text) 72%, transparent);
    }
    /* weeks down the left, Primary's column, then Kinetic's, which runs off the right edge of the page */
    .process_chart {
      --label-w: 7rem;
      --row-h: clamp(5rem, 9vw, 7.5rem);
      position: relative;
      display: grid;
      grid-template-columns: var(--label-w) minmax(0, 1fr) minmax(0, 1.7fr);
      grid-template-rows: auto repeat(var(--rows), var(--row-h));
      column-gap: 0.5rem;
      width: calc(100% + var(--site-margin, 1.5rem));
      margin-right: calc(-1 * var(--site-margin, 1.5rem));
      @media (width < 48rem) {
        --label-w: 3.5rem;
        --row-h: 6.5rem;
        grid-template-columns: var(--label-w) minmax(0, 1fr) minmax(0, 1.3fr);
        column-gap: 0.35rem;
      }
    }
    .process_lane-name {
      margin: 0;
      padding-bottom: var(--space-3);
    }
    .process_rule {
      grid-column: 1 / -1;
      border-top: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
    }
    .process_week {
      grid-column: 1;
      padding-top: var(--space-3);
      color: color-mix(in srgb, var(--text) 55%, transparent);
    }
    .process_particles {
      position: absolute;
      inset: 0;
      z-index: 2;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
    /* each bar builds left to right as its particles land (--fill, from the script); with no script or with
       reduced motion it is simply full */
    .process_bar {
      --fill: 1;
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      margin: 0.3rem 0;
      padding: var(--space-3);
      border-radius: var(--radius-media);
      clip-path: inset(0 calc((1 - var(--fill)) * 100%) 0 0 round var(--radius-media));
    }
    .process_bar.is-partner {
      background: #c8ff54; /* Primary's neon, from primary.studio */
      color: #111;
    }
    .process_bar.is-kinetic {
      background: var(--text);
      color: var(--background);
      /* off the page's right edge: square there, no rounding */
      border-radius: var(--radius-media) 0 0 var(--radius-media);
      clip-path: inset(0 calc((1 - var(--fill)) * 100%) 0 0 round var(--radius-media) 0 0 var(--radius-media));
    }
    .process_bar.is-kinetic.is-soft {
      background: color-mix(in srgb, var(--text) 16%, var(--background));
      color: var(--text);
    }
    .process_bar-title {
      margin: 0;
    }
    .process_bar-note {
      opacity: 0.72;
    }
    .process_chart.is-armed .process_bar {
      --fill: 0;
    }
    .process_chart.is-armed .process_bar > * {
      opacity: clamp(0, calc((var(--fill) - 0.6) * 3), 1);
    }
    .process_points {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
      width: 100%;
      margin: var(--space-8) 0 0;
      padding: 0;
      list-style: none;
      @media (width < 36rem) {
        grid-template-columns: 1fr;
      }
    }
    .process_point {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding-top: var(--space-4);
      border-top: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
    }
    .process_point-title,
    .process_point-body {
      margin: 0;
    }
    .process_point-body {
      max-width: 40ch;
      color: color-mix(in srgb, var(--text) 72%, transparent);
    }
  }
</style>
