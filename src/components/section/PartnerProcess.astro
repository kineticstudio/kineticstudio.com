---
import Section from "@/components/wrapper/Section.astro";
import kineticRaw from "@/assets/brand/logo.svg?raw";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The headline; a "|" breaks it onto a second line. */
  heading: string;
  /** A line under the headline. */
  lead?: string;
  /** Week labels, in order (weeks, then what comes after); each week is five working days. */
  columns: string[];
  /** One lane per studio: its phases, each spanning weeks `from` to `to` (1-based, inclusive). */
  lanes: {
    name: string;
    /** "partner" (the partner's colour, on the left) or "kinetic" (ink, on the right). */
    kind: "partner" | "kinetic";
    bars: { title: string; note: string; from: number; to: number; when: string; soft?: boolean }[];
  }[];
  /** The partner's wordmark, raw SVG, over its lane. */
  partnerLogo?: string;
  /** Things passed between the studios, each a labelled square thrown from one lane to the other on its day
      (1-based working day). */
  exchanges?: { day: number; from: "partner" | "kinetic"; label: string }[];
  /** A few short points under the timeline. */
  points?: { title: string; body: string }[];
}

const { render = true, heading, lead, columns, lanes, partnerLogo, exchanges = [], points = [] } = Astro.props;
/* How the two studios hand off, day by day (Nick, Nov 9: "some clear process and timeline stuff"; Hunter,
   Nov 9: four weeks of web). Nov 17 (Hunter): "As I scroll down ... the primary logo and the Kinetic logo. In
   the middle, we have a timeline, and it's actually built out by days. You see a stronger line to show what
   the day is. All of the phases are built out by ... little perfect squares, tiny little squares, almost like
   pixels. The phase can be smaller ... a much smaller typeface."
   Primary's lane on the left under its logo, Kinetic's on the right under its own, the days down the
   middle. Each phase is a block of tiny squares, faint until the day line reaches it; the line is where the
   scroll has got to, and the squares of each day light up at random as it passes. Nothing is pinned: the
   page scrolls as ever. Reduced motion: every phase lit, no line.
   Later on Nov 17 (Hunter): no week under each phase's name (the weeks are in the middle), the week names
   on the middle line, a line down the whole thing that fills as you scroll, "Primary + Kinetic" at the top,
   and, through the sprint, "things ... tossed back and forth between the two, but they're labeled":
   `exchanges`, each a square with its name thrown across the middle on its day, slower and taller. */
const DAYS = columns.length * 5;
const day = (week: number, end = false) => (end ? week * 5 : (week - 1) * 5 + 1);
const partner = lanes.find((l) => l.kind === "partner");
const kinetic = lanes.find((l) => l.kind === "kinetic");
const phases = [partner, kinetic].flatMap((lane) =>
  (lane?.bars ?? []).map((b) => ({ ...b, kind: lane!.kind, d0: day(b.from), d1: day(b.to, true) })),
);
// the sprint's days are as tall as a later week (Hunter, Nov 17: "the height of 1 week should be the height of 1
// day"), so the back and forth has room; every day after it is compact
const SPRINT = Math.max(0, ...phases.filter((p) => p.kind === "partner").map((p) => p.d1));
const yAt = (d: number) => `calc(${Math.min(d, SPRINT)} * var(--day-tall) + ${Math.max(d - SPRINT, 0)} * var(--day-h))`;
const launch = (columns.findIndex((c) => /after/i.test(c)) + 1 || columns.length + 1) - 1; // weeks before launch
const clean = (svg: string, label: string) =>
  svg
    .replace(/<!--[\s\S]*?-->/g, "")
    .replace(/\sid="[^"]*"/g, "")
    .replace(/\saria-label="[^"]*"/g, "")
    .replace(/<svg /, `<svg role="img" aria-label="${label}" `);
---

{
  render && (
    <Section theme="dark" paddingTop="large" paddingBottom="large" class="process" gap="0">
      <div class="process_head" data-reveal>
        <h2 class="process_title text-style-h2">
          {heading.split("|").map((line) => <span>{line.trim()}</span>)}
        </h2>
        {lead && <p class="process_lead text-style-main">{lead}</p>}
      </div>
      <div class="tl" style={`--body-h:${yAt(DAYS)}`} data-tl data-days={DAYS} data-sprint={SPRINT} data-launch={launch * 5}>
        {/* the two studios stay at the top of the screen while the days run under them (Hunter, Nov 17) */}
        <div class="tl_heads">
          <div class="tl_logo is-partner">{partnerLogo ? <span set:html={clean(partnerLogo, partner?.name ?? "Partner")} /> : <span class="text-style-h5">{partner?.name}</span>}</div>
          <div class="tl_plus" aria-label="and">+</div>
          <div class="tl_logo is-kinetic"><span set:html={clean(kineticRaw, "Kinetic")} /></div>
        </div>
        <div class="tl_body">
          <canvas class="tl_canvas" aria-hidden="true" />
          <div class="tl_lane is-partner" data-lane="partner" />
          <div class="tl_axis" data-axis />
          <div class="tl_lane is-kinetic" data-lane="kinetic" />
          <div class="tl_spine" aria-hidden="true"><span class="tl_spine-fill" data-spine /></div>
          {columns.map((c, i) => (
            <span class="tl_week text-style-label" style={`--y:${yAt(i * 5)}`}>{c}</span>
          ))}
          {/* a clear break for every day of the sprint, its number in the middle (Hunter, Nov 17) */}
          {Array.from({ length: SPRINT }, (_, d) => d).filter((d) => d % 5 !== 0).map((d) => (
            <span class="tl_week tl_day text-style-label" style={`--y:${yAt(d)}`}>Day {d + 1}</span>
          ))}
          {/* launch, a node at the bottom of the line, the end of week 6 (Hunter, Nov 18: "launch be a node at the
              bottom, not this big [neon] thing"; "all of this can happen in 6 weeks from kickoff with Primary") */}
          {launch * 5 === DAYS && (
            <div class="tl_launch" style={`--y:${yAt(DAYS)}`} data-launch-band>
              <i class="tl_launch-node" aria-hidden="true" />
              <span class="tl_launch-word text-style-h5">Launch</span>
              <span class="tl_launch-when text-style-label">End of week {launch}</span>
            </div>
          )}
          {phases.map((p) => (
            <div class:list={["tl_phase", `is-${p.kind}`, p.soft && "is-soft"]} style={`--y:${yAt(p.d0 - 1)}`} data-phase={p.kind} data-d0={p.d0} data-d1={p.d1}>
              <span class="tl_phase-title text-style-label">{p.title}</span>
            </div>
          ))}
          {exchanges.map((x) => (
            <span class:list={["tl_pass", `is-${x.from}`, "text-style-label"]} data-pass data-day={x.day} data-from={x.from} aria-hidden="true">
              <i />
              <b>{x.label}</b>
            </span>
          ))}
          <div class="tl_now" data-now aria-hidden="true">
            <span class="tl_now-label text-style-label" data-now-label>Day 1</span>
          </div>
        </div>
        <ol class="sr-only">
          {phases.map((p) => (
            <li>{`${p.kind === "partner" ? partner?.name : kinetic?.name}: ${p.title}, ${p.when}. ${p.note}`}</li>
          ))}
          {exchanges.map((x) => (
            <li>{`Day ${x.day}: ${x.label}, from ${x.from === "partner" ? partner?.name : kinetic?.name} to ${x.from === "partner" ? kinetic?.name : partner?.name}`}</li>
          ))}
        </ol>
      </div>
      {points.length > 0 && (
        <ul class="process_points">
          {points.map((p, i) => (
            <li class="process_point" data-reveal style={`--reveal-delay:${(0.06 * i).toFixed(2)}s`}>
              <h3 class="process_point-title text-style-h5">{p.title}</h3>
              <p class="process_point-body text-style-main">{p.body}</p>
            </li>
          ))}
        </ul>
      )}
    </Section>
  )
}

<script>
  /* The pixel timeline. One canvas over the body: each phase's block of its lane is a grid of tiny squares
     (PITCH apart, SIZE across), a few rows to a day. A square belongs to a day; it lights once the day line
     has passed that day plus its own random share of it, so a day fills in like pixels popping on as the
     line goes by. Unlit squares stay faint, so the plan is there from the start. The day line follows the
     scroll: day 0 as the chart's top reaches 70% down the window, the last day as its bottom does, eased. */
  const PITCH = 6, SIZE = 4;
  const NEON = [200, 255, 84], INK = [238, 241, 234];
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-tl]").forEach((tl) => {
    const body = tl.querySelector<HTMLElement>(".tl_body")!;
    const canvas = tl.querySelector<HTMLCanvasElement>(".tl_canvas")!;
    const ctx = canvas.getContext("2d")!;
    const now = tl.querySelector<HTMLElement>("[data-now]")!;
    const nowLabel = tl.querySelector<HTMLElement>("[data-now-label]")!;
    const DAYS = Number(tl.dataset.days), LAUNCH = Number(tl.dataset.launch), SPRINT = Number(tl.dataset.sprint);
    const spine = tl.querySelector<HTMLElement>("[data-spine]")!;
    const passes = [...tl.querySelectorAll<HTMLElement>("[data-pass]")].map((el) => ({ el, at: Number(el.dataset.day) - 1, partner: el.dataset.from === "partner", sx: 0, ex: 0 }));
    let edges = { partner: 0, kinetic: 0 };
    let spans = { partner: [0, 0], kinetic: [0, 0] };
    type Cell = { x: number; y: number; day: number; r: number; d2: number; rgb: number[]; soft: boolean; partner: boolean; sx: number; sy: number; fly: boolean; u: number };
    let cells: Cell[] = [], W = 0, H = 0, dpr = 1, tall = 130, short = 26, axis = { x: 0, w: 0 };
    let seed = 3;
    const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    // a day's top, in px (the sprint's days tall, the rest short), and back
    const yOf = (d: number) => Math.min(d, SPRINT) * tall + Math.max(d - SPRINT, 0) * short;
    const dOf = (y: number) => (y <= SPRINT * tall ? y / tall : SPRINT + (y - SPRINT * tall) / short);
    const hOf = (d: number) => (d < SPRINT ? tall : short);

    const build = () => {
      const B = body.getBoundingClientRect(), cs = getComputedStyle(tl);
      tall = parseFloat(cs.getPropertyValue("--day-tall")) || 130;
      short = parseFloat(cs.getPropertyValue("--day-h")) || 26;
      W = B.width;
      H = B.height;
      dpr = Math.min(2, devicePixelRatio || 1);
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      const a = tl.querySelector<HTMLElement>("[data-axis]")!.getBoundingClientRect();
      axis = { x: a.left - B.left, w: a.width };
      // the blocks' inner edges, either side of the middle: where things leave and land
      const lp = tl.querySelector<HTMLElement>('[data-lane="partner"]')!.getBoundingClientRect(), lk = tl.querySelector<HTMLElement>('[data-lane="kinetic"]')!.getBoundingClientRect();
      edges = { partner: lp.right - B.left - SIZE, kinetic: lk.left - B.left };
      spans = { partner: [lp.left - B.left, lp.right - B.left], kinetic: [lk.left - B.left, lk.right - B.left] };
      // each thing passed leaves from somewhere in the sender's block and lands somewhere in the other's
      for (const p of passes) {
        const from = p.partner ? spans.partner : spans.kinetic, to = p.partner ? spans.kinetic : spans.partner;
        p.sx = from[0] + (from[1] - from[0]) * (0.25 + rand() * 0.6);
        p.ex = to[0] + (to[1] - to[0]) * (0.15 + rand() * 0.6);
      }
      seed = 3;
      cells = [];
      for (const ph of tl.querySelectorAll<HTMLElement>("[data-phase]")) {
        const lane = tl.querySelector<HTMLElement>(`[data-lane="${ph.dataset.phase}"]`)!.getBoundingClientRect();
        const partner = ph.dataset.phase === "partner";
        const d0 = Number(ph.dataset.d0), d1 = Number(ph.dataset.d1);
        // the squares hug the axis: the partner's block ends at its lane's right edge, Kinetic's starts at its left
        const cols = Math.floor((lane.width + (PITCH - SIZE)) / PITCH);
        const x0 = partner ? lane.right - B.left - cols * PITCH + (PITCH - SIZE) : lane.left - B.left;
        for (let d = d0; d <= d1; d++) {
          const top = yOf(d - 1), dh = hOf(d - 1), rows = Math.max(1, Math.round(dh / PITCH));
          for (let r = 0; r < rows; r++) {
            const y = top + (r * dh) / rows + (dh / rows - SIZE) / 2;
            for (let c = 0; c < cols; c++) {
              // in the tall days a square lights at its own row's share of the day, so the block fills downward
              const share = dh > 40 ? (r + rand()) / rows : rand();
              cells.push({ x: x0 + c * PITCH, y, day: d - 1, r: share, d2: rand(), rgb: partner ? NEON : INK, soft: ph.classList.contains("is-soft"), partner, sx: 0, sy: 0, fly: false, u: 0 });
            }
          }
        }
      }
      // where each square sits across both lanes, 0 at Primary's outer edge, 1 at Kinetic's
      const x0All = spans.partner[0], x1All = spans.kinetic[1];
      for (const c of cells) c.u = (c.x - x0All) / Math.max(1, x1All - x0All);
      // through the sprint every Kinetic square is one of Primary's, thrown across: it leaves a square of
      // Primary's block on the same day and lands in its own place
      const byDay = new Map<number, Cell[]>();
      for (const c of cells) if (c.partner) byDay.set(c.day, [...(byDay.get(c.day) ?? []), c]);
      for (const c of cells) {
        if (c.partner || c.day >= SPRINT) continue;
        // from a square Primary already has when the throw starts (the day before, or earlier the same day),
        // never from below the day line
        const launch = c.day + c.r;
        const pool = (byDay.get(c.day) ?? []).filter((p) => p.day + p.r < launch).concat(c.day > 0 ? byDay.get(c.day - 1) ?? [] : []);
        const src = pool[Math.floor(rand() * pool.length)];
        if (src) (c.sx = src.x), (c.sy = src.y);
        // only a few squares make the trip, so each one can be followed (Hunter, Nov 17: "hard to see what's moving
        // ... feels very messy"); the rest come on in place
        c.fly = rand() < 0.045;
      }
    };

    let target = reduced ? DAYS : 0, cur = target, raf = 0;
    const draw = () => {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      // the days down the middle: a short tick each day, a longer one each week; through the sprint every day
      // gets a clear break right across, once the line has reached it
      for (let d = 0; d <= DAYS; d++) {
        const y = Math.round(yOf(d));
        ctx.fillStyle = "rgba(238,241,234,0.22)";
        const w = d % 5 === 0 ? axis.w * 0.5 : axis.w * 0.18;
        ctx.fillRect(axis.x + (axis.w - w) / 2, y, w, 1);
        if (d > 0 && d < SPRINT && d <= cur) {
          ctx.fillStyle = "rgba(238,241,234,0.1)";
          ctx.fillRect(0, y, W, 1);
        }
      }
      /* only what has happened shows (Hunter, Nov 17: "You also shouldn't see the future"), and it adds up: Primary's
         sprint fills in day by day and stays, and through it the work shifts across ("It really should look like
         primary is shifting the work to Kinetic"): each Kinetic square is one of Primary's, flying over the middle
         in Primary's neon and settling in Kinetic's ink, more of them each day, so Kinetic's block builds from a
         scatter to solid. It is all scrubbed by the scroll, so it runs backwards too. After the sprint Kinetic's
         own squares come on in place. */
      const FLY_SQ = 1.1; // days a square is in the air: slow enough to follow
      for (const c of cells) {
        /* the work as one band that slides across (Hunter, Nov 17: "instead of two perfect vertical columns, the
           work starts tapering off from the left of primary and moves to the right of Kinetic, so the work gets
           transitioned over"): each day the band's left edge eats into Primary from the outside and its right edge
           grows out across Kinetic, ragged at both edges; by the end of the sprint Primary is a sliver at the
           middle and Kinetic is full width */
        const at = c.day + c.r;
        const k = Math.min(1, at / SPRINT), ease = k * k * (3 - 2 * k);
        const left = 0.43 * ease, right = 0.58 + 0.42 * Math.min(1, (at / SPRINT) * 1.25);
        const rag = (c.d2 - 0.5) * 0.16;
        if (c.partner ? c.u < left + rag : c.u > right + rag) continue;
        if (!c.partner && c.day < SPRINT && c.sy && c.fly) {
          // thrown as the day line reaches its row, so the whole flight happens above the line, in the past
          const u = (cur - at) / FLY_SQ;
          if (u <= 0) continue;
          if (u < 1) {
            const e = u < 0.5 ? 2 * u * u : 1 - Math.pow(-2 * u + 2, 2) / 2;
            const cx = (c.sx + c.x) / 2, cy = Math.min(c.sy, c.y) - 24;
            const x = (1 - e) * (1 - e) * c.sx + 2 * (1 - e) * e * cx + e * e * c.x;
            const y = (1 - e) * (1 - e) * c.sy + 2 * (1 - e) * e * cy + e * e * c.y;
            const col = NEON.map((n, j) => Math.round(n + (INK[j] - n) * Math.max(0, (e - 0.7) / 0.3)));
            ctx.fillStyle = `rgb(${col})`;
            ctx.fillRect(x - 1.5, y - 1.5, SIZE + 3, SIZE + 3); // a touch bigger in the air
            continue;
          }
          ctx.fillStyle = `rgba(${INK},${c.soft ? 0.55 : 1})`;
          ctx.fillRect(c.x, c.y, SIZE, SIZE);
          continue;
        }
        const lit = Math.min(1, Math.max(0, (cur - at) * 3));
        const a = (c.soft ? 0.55 : 1) * lit;
        if (a > 0.01) {
          ctx.fillStyle = `rgba(${c.rgb[0]},${c.rgb[1]},${c.rgb[2]},${a.toFixed(3)})`;
          ctx.fillRect(c.x, c.y, SIZE, SIZE);
        }
      }
      /* the things passed across, scrubbed by the scroll: on its moment a square leaves the sender's block with its
         name beside it, arcs over the middle and drops into the other's; the name travels with it and is gone
         once it lands (Hunter, Nov 17: no legend, it "should happen with this interaction") */
      const FLY = 0.7;
      for (const p of passes) {
        const u = (cur - p.at) / FLY;
        if (u <= 0 || u >= 1.2) {
          p.el.style.opacity = "0";
          continue;
        }
        const k = Math.min(1, u), e = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
        const y0 = yOf(p.at), drop = hOf(p.at) * 0.3;
        const x = p.sx + (p.ex - p.sx) * e, y = y0 + drop * e - Math.sin(Math.PI * e) * 26;
        p.el.style.opacity = String(Math.min(1, u * 8, u > 1 ? (1.2 - u) / 0.2 : 1));
        p.el.style.transform = `translate(${x.toFixed(1)}px, ${(y - 6).toFixed(1)}px)`;
      }
      // the day line, stronger, across everything, and the line down the middle filled to it
      const y = yOf(Math.min(DAYS, cur));
      spine.style.height = `${y.toFixed(1)}px`;
      now.style.transform = `translateY(${y.toFixed(1)}px)`;
      tl.querySelector("[data-launch-band]")?.classList.toggle("is-on", cur >= DAYS - 0.05);
      const d = Math.min(DAYS, Math.max(1, Math.ceil(cur)));
      nowLabel.textContent = d > LAUNCH ? "After launch" : `Day ${d}`;
      now.classList.toggle("is-done", cur >= DAYS - 0.05); // the Launch node takes over from the day line
    };
    const tick = () => {
      raf = 0;
      cur += (target - cur) * 0.18;
      if (Math.abs(target - cur) < 0.002) cur = target;
      draw();
      if (cur !== target) raf = requestAnimationFrame(tick);
    };
    const onScroll = () => {
      if (reduced) return;
      const r = body.getBoundingClientRect(), start = innerHeight * 0.7;
      target = Math.min(DAYS, Math.max(0, dOf(start - r.top)));
      if (!raf) raf = requestAnimationFrame(tick);
    };
    new ResizeObserver(() => {
      build();
      onScroll();
      draw();
    }).observe(body);
    addEventListener("scroll", onScroll, { passive: true });
    tl.classList.toggle("is-still", reduced);
  });
</script>

<style is:global>
  @layer components {
    /* centred over the timeline (Hunter, Nov 17: "center two studios, one team, and the subcopy") */
    .process_head {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-4);
      width: 100%;
      margin-bottom: var(--space-8);
      text-align: center;
    }
    .process_title {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin: 0;
    }
    .process_lead {
      max-width: 44ch;
      margin: 0;
      text-wrap: balance;
      color: color-mix(in srgb, var(--text) 72%, transparent);
    }
    /* Primary's lane | the days | Kinetic's lane, each lane with its phases' names on its outer side */
    /* the lanes are narrow and hug the days, the phases' names beside them, the whole thing centred */
    .tl {
      --day-tall: 130px; /* a day of the sprint */
      --day-h: 26px; /* a day after it */
      --axis-w: 5.5rem;
      --lane-w: clamp(7rem, 17vw, 15rem);
      --label-w: 9rem;
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--lane-w) var(--axis-w) var(--lane-w) minmax(0, 1fr);
      grid-template-rows: auto auto;
      row-gap: var(--space-5);
      width: 100%;
      /* the room for the Launch node's words sits below the grid, so the sticky logos let go at the launch line */
      margin-bottom: clamp(5rem, 8vw, 6.5rem);
      @media (width < 48rem) {
        --day-tall: 80px;
        --day-h: 16px;
        --axis-w: 3.25rem;
        --lane-w: 4.5rem;
        --label-w: 6rem;
      }
    }
    /* the logos stick under the nav on the section's own grey, a solid band the squares pass beneath */
    .tl_heads {
      position: sticky;
      top: var(--tl-heads-top, 4.875rem); /* right under the nav bar */
      z-index: 3;
      grid-row: 1;
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: subgrid;
      padding: var(--space-3) 0;
      background: var(--background);
      @media (width < 48rem) {
        --tl-heads-top: 4.125rem;
      }
    }
    .tl_logo {
      grid-row: 1;
      display: flex;
      align-items: flex-end;
      height: 1.75rem;
      color: var(--text);
      & svg {
        display: block;
        width: auto;
        height: 100%;
      }
      @media (width < 48rem) {
        height: 1.25rem;
      }
    }
    .tl_logo.is-partner {
      grid-column: 2;
      justify-content: flex-end;
      & span {
        height: 86%;
      }
    }
    .tl_plus {
      grid-row: 1;
      grid-column: 3;
      align-self: end;
      text-align: center;
      font-size: 1.5rem;
      line-height: 1;
      color: color-mix(in srgb, var(--text) 60%, transparent);
    }
    .tl_logo.is-kinetic {
      grid-column: 4;
      justify-content: flex-start;
      & span {
        height: 100%;
      }
    }
    .tl_body {
      position: relative;
      grid-row: 2;
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: subgrid;
      height: var(--body-h);
    }
    .tl_canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
    .tl_lane.is-partner {
      grid-column: 2;
    }
    .tl_axis {
      grid-column: 3;
