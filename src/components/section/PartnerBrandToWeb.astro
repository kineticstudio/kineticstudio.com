---
import Section from "@/components/wrapper/Section.astro";
import { WORK } from "@/data/work.js";
import { restLoop } from "@/data/project-link.js";
import MAC from "@/data/macbook-angle.json";
import MEDIA from "@/data/media.json";
import Modal from "@/components/interactive/Modal.astro";
import exeLogo from "@/assets/clients/exe.svg?raw";
import ownerLogo from "@/assets/clients/owner.svg?raw";
import rambleLogo from "@/assets/clients/ramble.svg?raw";
import augustLogo from "@/assets/clients/august-health.svg?raw";
// each client's own logo heads its caption (Hunter, Nov 17: "we should use logos here"), from the Studio's
// clients/<slug>/brand/logo.svg, drawn in the text colour
const LOGOS: Record<string, string> = { exe: exeLogo, owner: ownerLogo, ramble: rambleLogo, "august-health": augustLogo };

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The headline; a "|" breaks it onto a second line. None on /primary, which goes straight into the rows. */
  heading?: string;
  /** A line under the headline. */
  lead?: string;
  /** Each pair: pages of the partner's brand guidelines, then the site we built from them. */
  pairs: {
    /** The project's slug in src/data/work.js (its loop, link and name come from there). */
    slug: string;
    /** 16:9 pages of the brand guidelines, as the partner delivered them. */
    slides: { src: string; alt: string }[];
    /** One line under the name: what the brand became on the web. */
    line?: string;
    /** A live 3D laptop instead of the render (Hunter, Nov 17: "Try it on exe"). */
    live3d?: boolean;
    /** A launch film, opened full screen with sound from a play button under the name. */
    film?: { src: string; poster: string; label: string };
  }[];
}

const { render = true, heading, lead, pairs } = Astro.props;
/* Brand to website (Hunter, Nov 17: "a handful of the brand guidelines that are essentially a 16:9 static
   PDF that Primary sends over ... and then you see a looped version of the website on the right"). The
   pages are Primary's own (the brand book Figma files); the site plays on Kinetic's MacBook, a Blender
   render (devices.py, az +12 el 8: turned left, toward the pages) with its screen's corners as fractions of
   the frame (src/data/macbook-angle.json), so the loop sits on the glass, inset from the screen's edge and
   rounded at the corners like the real display.
   The pages ride a barrel (Hunter, Nov 17: "skew the more they are to the left, and they shouldn't overlap,
   kind of like what we do with the hero"; "blurry on the left as well, maybe with a lens effect"): the
   Playground's projection on one axis, the barrel's axis through the laptop's screen, so a page at the
   screen is at true size and the further left, the nearer and more stretched; spaced evenly round it, so
   they never overlap; two lines, the top one slower, running in behind the screen.
   The section goes from light into dark toward its bottom right, the neon glowing on the edge, like the
   Primary proposal's cover ("add in the gradient and then go into dark mode in the bottom right"), into
   the dark timeline below. Every dial is in src/data/brand-web-look.js, with Params on the page (P). */
const rows = pairs
  .map((p) => ({ p, w: WORK.find((w) => w.slug === p.slug) }))
  .filter((r): r is { p: (typeof pairs)[number]; w: (typeof WORK)[number] } => Boolean(r.w && restLoop(r.w) && r.p.slides.length))
  .map(({ p, w }) => ({ p, w }));
---

{
  render && rows.length > 0 && (
    <Section paddingTop={heading ? "large" : "none"} paddingBottom="none" class="brand-web" gap="0">
      {heading && (
        <div class="brand-web_head" data-reveal>
          <h2 class="brand-web_title text-style-h2">
            {heading.split("|").map((line) => <span>{line.trim()}</span>)}
          </h2>
          {lead && <p class="brand-web_lead text-style-main">{lead}</p>}
        </div>
      )}
      <ul class="brand-web_list" style={`--mac-ratio:${MAC.width / MAC.height}`}>
        {rows.map(({ p, w }) => (
          <li class="brand-web_row" data-slug={w.slug}>
            <div class="brand-web_pair">
              <figure class="brand-web_book" aria-label={`${w.name} brand guidelines by Primary`} data-book>
                {/* two lines of pages fed in (Hunter, Nov 18: "bring it back to where there are two rows"), each the
                    whole book so neither runs with gaps; the lower starts halfway through, so a page is never
                    stacked over itself */}
                {[p.slides, [...p.slides.slice(Math.ceil(p.slides.length / 2)), ...p.slides.slice(0, Math.ceil(p.slides.length / 2))]].map((line, r) => (
                  <template data-line={r}>
                    {line.map((s) => (
                      <img class="brand-web_slide" src={s.src} alt="" width="1280" height="720" decoding="async" draggable="false" />
                    ))}
                  </template>
                ))}
                <ul class="sr-only">
                  {p.slides.map((s) => (
                    <li>{s.alt}</li>
                  ))}
                </ul>
              </figure>
              {/* under the pages: the name, one line, and the live site (Hunter, Nov 17) */}
              <div class="brand-web_caption">
                {LOGOS[w.slug] ? (
                  <p class="brand-web_logo" role="img" aria-label={w.name} set:html={LOGOS[w.slug].replace(/<svg /, '<svg aria-hidden="true" ')} />
                ) : (
                  <p class="brand-web_name text-style-h4">{w.name}</p>
                )}
                {p.line && <p class="brand-web_line text-style-main">{p.line}</p>}
                <div class="brand-web_links">
                  {/* the CTA to the live site: a black pill the size and type of the nav's Contact (Hunter, Nov 18) */}
                  <a class="brand-web_visit2" href={w.url} target="_blank" rel="noopener" data-track={`Visit site, ${w.name}`}>
                    Visit site
                    <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" /></svg>
                  </a>
                  {p.film && (
                    <button class="brand-web_film text-style-label" type="button" data-modal-open={`film-${w.slug}`}>
                      <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M7 4.5v15l12-7.5z" fill="currentColor" /></svg>
                      {p.film.label}
                    </button>
                  )}
                </div>
              </div>
              {/* the site straight on in a frosted glass frame, no laptop (Hunter, Nov 17: "Instead of mockups, let's
                  try a straight-on view, but with a border of glass morphism"); the pages pass behind the glass */}
              <a class="brand-web_device is-glass" href={w.url} target="_blank" rel="noopener" aria-label={`${w.name}, the live site`} data-track={`Laptop, ${w.name}`} data-mac data-glass>
                <span class="brand-web_glass">
                  <video class="brand-web_video" data-src={`/media/scroll-tall/${w.cover}.mp4`} poster={`/media/scroll-tall/${w.cover}.jpg`} muted loop playsinline preload="none" aria-hidden="true" />
                </span>
              </a>
            </div>
            {p.film && (
              <Modal id={`film-${w.slug}`} label={`${w.name}, ${p.film.label}`} variant="full-screen" class="brand-web_modal">
                <video class="brand-web_film-video" data-src={p.film.src} poster={p.film.poster} controls playsinline preload="none" data-film />
              </Modal>
            )}
          </li>
        ))}
      </ul>
      {/* the laptop model's licence (CC BY 4.0) asks for a credit */}
      {rows.some(({ p }) => p.live3d) && (
        <p class="brand-web_credit text-style-label">
          MacBook Pro model by <a href="https://sketchfab.com/3d-models/macbook-pro-m3-16-inch-2024-8e34fc2b303144f78490007d91ff57c4" target="_blank" rel="noopener">jackbaeten</a>, <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>
        </p>
      )}
    </Section>
  )
}

<script>
  import MAC from "@/data/macbook-angle.json";
  import { BRAND_WEB_LOOK as LOOK } from "@/data/brand-web-look.js";
  import { fitScreen } from "@/scripts/mac-screen.ts";
  import { LITE } from "@/scripts/lite.js";

  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  /* The ground (.bw-ground on the page, round the hero and these rows): the screen goes from light into dark
     toward its bottom right with a glow between, like the Primary proposal's cover but curved and soft: an
     ellipse off the bottom right corner, its colours eased into each other (smoothstep, in many stops), the
     glow in the colour of the client on screen, easing from one to the next as the rows scroll by. The layer
     sticks to the screen; each row's name takes the light text while the dark is behind it. */
  const ground = document.querySelector<HTMLElement>("[data-ground]");
  const layer = ground?.querySelector<HTMLElement>(".bw-ground_layer");
  const names = [...document.querySelectorAll<HTMLElement>(".brand-web_caption")];
  const rowsEls = [...document.querySelectorAll<HTMLElement>(".brand-web_row")];
  const hex = (h: string) => {
    const m = /^#?([\da-f]{2})([\da-f]{2})([\da-f]{2})$/i.exec(h.trim());
    return m ? m.slice(1).map((x) => parseInt(x, 16)) : [168, 255, 102];
  };
  const css = (v: string) => {
    const probe = document.createElement("i");
    probe.style.color = v;
    ground?.append(probe);
    const c = (getComputedStyle(probe).color.match(/[\d.]+/g) || ["0", "0", "0"]).slice(0, 3).map(Number);
    probe.remove();
    return c;
  };
  const DARK = css("var(--dark-900)"), LIGHT = css("var(--light-300)");
  const mix = (a: number[], b: number[], t: number) => a.map((x, i) => Math.round(x + (b[i] - x) * t));
  const smooth = (t: number) => t * t * (3 - 2 * t);
  let glowNow = hex(LOOK.gradient.hero), glowTo = glowNow, glowRaf = 0;
  const paint = () => {
    if (!layer) return;
    const g = LOOK.gradient, glow = mix(LIGHT, glowNow, g.glowMix);
    const stops: string[] = [`rgb(${DARK}) 0%`, `rgb(${DARK}) ${(g.dark * 100).toFixed(1)}%`];
    const run = (a: number[], b: number[], from: number, to: number) => {
      for (let i = 1; i <= 10; i++) {
        const t = i / 10;
        stops.push(`rgb(${mix(a, b, smooth(t))}) ${((from + (to - from) * t) * 100).toFixed(1)}%`);
      }
    };
    run(DARK, glow, g.dark, g.glow);
    run(glow, LIGHT, g.glow, g.light);
    layer.style.background = `radial-gradient(ellipse ${g.width}% ${g.height}% at ${g.x}% ${g.y}%, ${stops.join(", ")})`;
  };
  const shade = () => {
    if (!layer) return;
    const g = LOOK.gradient, S = layer.getBoundingClientRect();
    const cx = S.left + (S.width * g.x) / 100, cy = S.top + (S.height * g.y) / 100, rx = (S.width * g.width) / 100, ry = (S.height * g.height) / 100;
    for (const n of names) {
      const r = n.getBoundingClientRect();
      const t = Math.hypot((r.left + r.width / 2 - cx) / rx, (r.top + r.height / 2 - cy) / ry);
      n.classList.toggle("is-on-dark", t < (g.dark + g.glow) / 2);
    }
    // the client on screen: the row nearest the middle, once its laptop is well up; the hero's neon before
    const mid = innerHeight / 2;
    let slug = "hero", best = Infinity;
    for (const row of rowsEls) {
      const r = row.getBoundingClientRect();
      if (r.top > innerHeight * 0.55 || r.bottom < 0) continue;
      const d = Math.abs(r.top + r.height / 2 - mid);
      if (d < best) (best = d), (slug = row.dataset.slug ?? "hero");
    }
    const to = hex((g as Record<string, unknown>)[slug] as string ?? g.hero);
    if (to.join() !== glowTo.join()) {
      glowTo = to;
      if (!glowRaf) glowRaf = requestAnimationFrame(fade);
    }
  };
  // the glow eases from one client's colour to the next
  const fade = () => {
    glowRaf = 0;
    glowNow = glowNow.map((c, i) => c + (glowTo[i] - c) * 0.08);
    const done = glowNow.every((c, i) => Math.abs(c - glowTo[i]) < 0.5);
    if (done) glowNow = glowTo.slice();
    paint();
    if (!done) glowRaf = requestAnimationFrame(fade);
  };
  const gradient = () => {
    if (!ground) return;
    paint();
    shade();
  };
  let shading = 0;
  addEventListener("scroll", () => (shading ||= requestAnimationFrame(() => ((shading = 0), shade()))), { passive: true });

  // the site loop laid onto the laptop's glass (src/scripts/mac-screen.ts)
  const fit = (dev: HTMLElement) => fitScreen(dev, dev.querySelector<HTMLElement>(".brand-web_screen")!, LOOK.laptop);

  document.querySelectorAll<HTMLElement>(".brand-web_pair").forEach((pair) => {
    const book = pair.querySelector<HTMLElement>("[data-book]")!;
    const dev = pair.querySelector<HTMLElement>("[data-mac]")!;
    const row = pair.closest<HTMLElement>(".brand-web_row")!;
    type Line = { imgs: HTMLImageElement[]; els: HTMLImageElement[]; top: boolean; offs: number[]; span: number };
    /* The two lines (Hunter, Nov 18: "randomize the PDFs ... these are perfectly stacked top to bottom"; Nov 20:
       "Fix the gaps horizontally" and "make sure we never have the same PDF stacked on top of each other"):
       - one even gap between every page;
       - the book in a shuffled order (seeded by the row, so the same on every visit);
       - the lower line set half a page along, like brickwork, so the pages never line up in columns;
       - the lower line's order is the upper's moved on by OFF pages, and both lines run at one speed, so
         the pages above a lower page are always two others: page k sits under pages k+OFF and k+OFF+1, never
         under itself (different speeds would bring every page over its own copy sooner or later) */
    const seeded = (seed: number) => () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
    const slugSeed = [...(row.dataset.slug ?? "")].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
    const base = [...book.querySelector<HTMLTemplateElement>("template[data-line]")!.content.querySelectorAll("img")];
    const rnd = seeded(slugSeed);
    for (let i = base.length - 1; i > 0; i--) { const j = Math.floor(rnd() * (i + 1)); [base[i], base[j]] = [base[j], base[i]]; }
    const OFF = base.length >= 4 ? Math.floor(base.length / 2) : 0;
    const nLines = book.querySelectorAll("template[data-line]").length;
    const lines: Line[] = Array.from({ length: nLines }, (_, r) => ({
      imgs: r ? [...base.slice(OFF), ...base.slice(0, OFF)] : base,
      els: [],
      top: r === 0,
      offs: [],
      span: 0,
    }));
    let geo: { F: number; col: number; reach: number; span: number } | null = null;

    /* The barrel, as the Playground's globe on one axis: perspective F with its origin on the screen, a
       page at angle a (0 at the screen, negative to the left) is pushed out to the camera, turned, and
       pulled back: translateZ(F) rotateY(-a) translateZ(-F). It lands at x = F tan(a), stretched by
       1 / cos(a) and more, so the pages further left come nearer and stretch, each in its own slot. */
    const build = () => {
      dev.style.translate = ""; // measured where it rests, not mid-slide
      dev.style.width = `${LOOK.laptop.width}%`;
      pair.style.setProperty("--dev-w", `${LOOK.laptop.width}%`);
      const glass = dev.hasAttribute("data-glass");
      if (!glass) fit(dev);
      const B = book.getBoundingClientRect(), D = dev.getBoundingClientRect(), b = LOOK.barrel;
      const q = MAC.q;
      // the barrel's axis runs through the screen: the frame's middle, or the laptop's glass
      const sx = D.left - B.left + (glass ? 0.5 : (q[0][0] + q[1][0] + q[2][0] + q[3][0]) / 4) * D.width;
      const sy = D.top - B.top + (glass ? 0.3 : (q[0][1] + q[1][1] + q[2][1] + q[3][1]) / 4) * D.height;
      const reach = (b.reach * Math.PI) / 180;
      const F = sx / Math.tan(reach); // the page's left edge is `reach` round the barrel
      // a touch smaller on narrower screens, where the caption wraps taller, so the pages stay clear of it
      const h = b.page * D.height * (innerWidth < 1240 ? 0.78 : 1), w = (h * 16) / 9;
      const col = (w + b.gap * h) / F;
      // every page once round the loop, never two copies on screen (Hunter, Nov 17: "there are duplicates"); the
      // loop is at least the visible arc plus a slot, so a line with few pages runs with gaps between them
      // a line is always full from the window's left edge to the site: when a book has too few pages for the arc
      // (the pages got smaller, Nov 18: "these should already be loaded"), it repeats, its copies a whole book apart
      const book1 = Math.max(...lines.map((L) => L.imgs.length));
      const reps = Math.max(1, Math.ceil((reach + col * 2.2) / (book1 * col)));
      const n = book1 * reps;
      const span = n * col;
      geo = { F, col, reach, span };
      book.style.perspective = `${F}px`;
      book.style.perspectiveOrigin = `${sx}px ${sy}px`;
      lines.forEach((L, r) => {
        if (L.els.length !== L.imgs.length * reps) {
          L.els.forEach((e) => e.remove());
          L.els = Array.from({ length: reps }, () => L.imgs).flat().map((img) => book.appendChild(img.cloneNode() as HTMLImageElement));
        }
        // each page one slot along, one even gap; the lower line half a slot on
        L.offs = L.els.map((_, i) => (i + (r ? 0.5 : 0)) * col);
        L.span = L.els.length * col;
        const y = lines.length > 1 ? sy + (L.top ? -1 : 1) * (h / 2 + (b.rowGap * h) / 2) - h / 2 : sy - h / 2;
        for (const e of L.els) {
          e.style.width = `${w}px`;
          e.style.height = `${h}px`;
          e.style.left = `${sx - w / 2}px`;
          e.style.top = `${y}px`;
        }
      });
    };
    const draw = (t: number) => {
      if (!geo) return;
      const { F, col, reach } = geo, lens = LOOK.lens;
      for (const L of lines) {
        const lap = LOOK.barrel.lapTop; // one speed for both lines, so they keep their places (Nov 20)
        const v = reach / lap; // radians a second, so a page crosses in `lap` seconds
        const span = L.span;
        L.els.forEach((e, i) => {
          const pos = (((L.offs[i] + t * v) % span) + span) % span;
          const a = pos - span + col * 0.6; // from off the left edge to just past the screen's middle
          // gone once it is well behind the screen, so none peeks out past the laptop's right side
          if (a < -1.45 || a < -reach - col * 1.2 || a > -col * 0.4) {
            e.style.visibility = "hidden";
            return;
          }
          e.style.visibility = "visible";
          e.style.transform = `translateZ(${F.toFixed(1)}px) rotateY(${(-a).toFixed(4)}rad) translateZ(${(-F).toFixed(1)}px)`;
          // the lens: the nearer a page comes on the left, the softer it is
          const k = Math.max(0, -a) / reach;
          const px = lens.blur * Math.pow(Math.min(k, 1.3), lens.curve);
          e.style.filter = px > 0.25 ? `blur(${px.toFixed(2)}px)` : "";
        });
      }
    };

    /* the pages drift on their own and go faster the faster you scroll, either way (Hunter, Nov 18: "speed of
       brand pdfs going into website should speed up tied to scroll"); the site slides in from the right as the
       row comes up the screen */
    const BOOST = 0.014; // seconds of drift per px scrolled
    let lastY = scrollY;
    const SLIDE = 0.34; // the site starts this much of its width to the right (more, Nov 18)
    const wide = matchMedia("(width >= 48rem)");
    const enter = () => {
      const r = row.getBoundingClientRect();
      const k = Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight * 0.85)));
      return 1 - Math.pow(1 - k, 2); // gentle, so the slide is seen through most of the scroll in
    };
    let on = false, raf = 0, t0 = 0, t = 9;
    const frame = (now: number) => {
      raf = 0;
      if (!on) return;
      if (t0) t += Math.min(0.05, (now - t0) / 1000);
      t0 = now;
      t += Math.min(1.2, Math.abs(scrollY - lastY) * BOOST);
      lastY = scrollY;
      const e = enter();
      draw(t);
      dev.style.translate = wide.matches ? `${((1 - e) * SLIDE * 100).toFixed(2)}% 0` : "";
      raf = requestAnimationFrame(frame);
    };
    const redo = () => {
      build();
      draw(t);
    };
    new ResizeObserver(redo).observe(pair);
    addEventListener("ks:brand-web-look", redo);
    // each row plays (its pages drifting, its site looping) while it is on screen, and rests when it isn't
    const v = dev.querySelector<HTMLVideoElement>("video[data-src]");
    new IntersectionObserver(
      ([e]) => {
        on = e.isIntersecting && !reduced;
        if (on && !raf) {
          t0 = 0;
          lastY = scrollY;
          raf = requestAnimationFrame(frame);
        }
        if (!v || reduced) return;
        if (e.isIntersecting) {
          if (!v.src) v.src = v.dataset.src!;
          // played at their own speed: media/scroll-tall is recorded at the slower pace, at 60 fps (Hunter, Nov 18: "jumpy" at 0.55x)
          v.play().catch(() => {});
        } else v.pause();
      },
      { rootMargin: "15% 0px" },
    ).observe(row);
  });

  // the live 3D laptop (src/scripts/mac-3d.ts) on the rows that ask for it, loaded as the row nears the screen;
  // the render stays underneath until the 3D is drawing, and is all a phone or reduced motion ever gets
  if (!LITE && !reduced)
    document.querySelectorAll<HTMLElement>("[data-mac3d]").forEach((dev) => {
      const io = new IntersectionObserver(
        ([e]) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          const video = dev.querySelector<HTMLVideoElement>("video")!;
          if (!video.src) video.src = video.dataset.src!;
          // from the site's root, so it also loads in the Studio's copy, which lives in a folder
          const root = document.querySelector<HTMLLinkElement>('link[rel="site-root"]')?.href ?? location.origin + "/";
          const model = new URL("models/macbook-pro.glb", root).href; // jackbaeten, CC BY 4.0 (credited under the rows)
          import("@/scripts/mac-3d.ts").then(({ mountMac3D }) => mountMac3D(dev, { model, video })).catch(() => {});
        },
        { rootMargin: "60% 0px" },
      );
      io.observe(dev);
    });

  // a launch film loads and plays with sound when its dialog opens, and stops when it closes
  document.querySelectorAll<HTMLDialogElement>(".brand-web_modal").forEach((d) => {
    const film = d.querySelector<HTMLVideoElement>("video[data-film]");
    if (!film) return;
    new MutationObserver(() => {
      if (d.open) {
        if (!film.src) film.src = film.dataset.src!;
        film.play().catch(() => {});
      } else film.pause();
    }).observe(d, { attributes: true, attributeFilter: ["open"] });
  });

  gradient();
  addEventListener("resize", gradient);
  addEventListener("ks:brand-web-look", gradient);
  // the shade down each row and the line between them, from the look (Params > shade)
  const applyShade = () => {
    const S = LOOK.shade;
    if (!S) return;
    const m = /^#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(S.color || "#000000");
    const rgb = m ? m.slice(1).map((x) => parseInt(x, 16)).join(" ") : "0 0 0";
    for (const list of document.querySelectorAll<HTMLElement>(".brand-web_list")) {
      list.style.setProperty("--row-shade", `linear-gradient(${S.angle}deg, rgb(${rgb} / ${S.from}) ${S.start}%, rgb(${rgb} / ${S.to}) ${S.end}%)`);
      list.style.setProperty("--row-line", String(S.line));
    }
  };
  applyShade();
  addEventListener("ks:brand-web-look", applyShade);
</script>

<style is:global>
  @layer components {
    /* the ground round the hero and the rows: a layer the size of the screen, stuck to it */
    .bw-ground {
      position: relative;
      isolation: isolate;
      overflow: clip; /* the stuck layer ends with the rows, not over what follows (clip keeps it sticky) */
      & > .section {
        position: relative;
        background: transparent;
      }
    }
    .bw-ground_layer {
      position: sticky;
      top: 0;
      z-index: -1;
      height: 100lvh;
      margin-bottom: -100lvh;
      pointer-events: none;
      background: var(--light-300); /* the script paints the curve */
    }
    .brand-web_head {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      width: 100%;
      margin-bottom: var(--space-8);
    }
    .brand-web_title {
      display: flex;
      flex-direction: column;
      margin: 0;
    }
    .brand-web_lead {
      max-width: 40ch;
      margin: 0;
      color: color-mix(in srgb, var(--text) 72%, transparent);
    }
    .brand-web_list {
      display: flex;
      flex-direction: column;
      gap: 0;
      width: 100%;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    /* each client its own block: a rule across, its name, then its pages and site (Hunter, Nov 17: "clear
       delineation between each of the options") */
    .brand-web_row {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding-top: var(--space-5);
      /* the frame runs down past the row and is cut at the next row's line (Hunter, Nov 17: "Extend the bottom
         a bit and then crop it off at the line"); only the bottom is cut, the pages still reach the window edge */
      clip-path: inset(-100vh -100vw 0 -100vw);
      /* the line across the top of each row, the whole window wide */
      &::before {
        content: "";
        position: absolute;
        left: calc((100% - 100vw) / 2);
        width: 100vw;
        height: 1px;
        background: var(--text);
        opacity: var(--row-line, 0.18);
        z-index: 3;
      }
      &::before {
        top: 0;
      }
      &:first-child::before {
        display: none;
      }
      /* each row shades a touch toward its foot, 0 to 5% black, over the moving ground, so one project ends
         clearly before the next (Hunter, Nov 18); behind the row's pages, site and words. The last site still
         runs straight into the next section, with no line under it. */
      isolation: isolate;
      &::after,
      &:last-child::after {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: calc((100% - 100vw) / 2);
        width: 100vw;
        height: auto;
        z-index: -1;
        background: var(--row-shade, linear-gradient(to bottom, rgb(0 0 0 / 0), rgb(0 0 0 / 0.05)));
        pointer-events: none;
      }
    }
    /* the first site sits close under the hero, so exe peeks into the first screen (Hunter, Nov 18) */
    .brand-web_row:first-child {
      padding-top: 0;
      & .brand-web_pair {
        padding-top: clamp(1rem, 2vw, 2rem);
      }
    }
    /* the laptop on the right, big; the pages run in behind it from the page's left edge */
    .brand-web_pair {
      position: relative;
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      /* taller rows, so one client's glow doesn't run into the next (Hunter, Nov 18) */
      padding-top: clamp(4.5rem, 16vw, 16rem); /* taller rows again (Hunter, Nov 18) */
    }
    .brand-web_book {
      position: absolute;
      /* from the window's own left edge, however wide the window: the pair is centred, so half the difference */
      inset: 0 0 0 calc((100% - 100vw) / 2);
      margin: 0;
      overflow: hidden;
      pointer-events: none;
      /* not on a phone: the site alone, full width (Hunter, Nov 18) */
      @media (width < 48rem) {
        display: none;
      }
    }
    .brand-web_slide {
      position: absolute;
      display: block;
      visibility: hidden;
      backface-visibility: hidden;
      box-shadow: 0 0 0 1px rgb(17 17 17 / 0.06);
      will-change: transform, filter;
    }
    .brand-web_device {
      position: relative;
      z-index: 1;
      display: block;
      width: 68%;
      aspect-ratio: var(--mac-ratio, 1.6);
      @media (width < 48rem) {
        width: 74% !important;
      }
    }
    /* the glass frame: a frosted border round the site, the pages blurred as they pass behind it */
    .brand-web_device.is-glass {
      aspect-ratio: auto; /* the glass inside sets the shape */
      margin-bottom: -8%; /* past the row's bottom, cut at the line (Hunter, Nov 18: "Bottom here should still be cut off") */
      @media (width < 48rem) {
        width: 100% !important;
        margin-bottom: -14%;
      }
      padding: clamp(0.6rem, 1.1vw, 1.1rem);
      border-radius: clamp(1rem, 1.8vw, 1.75rem);
      background: color-mix(in srgb, #fff 18%, transparent);
      border: 1px solid color-mix(in srgb, #fff 55%, transparent);
      box-shadow:
        inset 0 1px 0 color-mix(in srgb, #fff 70%, transparent),
        0 2rem 4rem -1.5rem rgb(0 0 0 / 0.35);
      -webkit-backdrop-filter: blur(18px) saturate(1.4);
      backdrop-filter: blur(18px) saturate(1.4);
    }
    .brand-web_visit2 {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      height: var(--pill-height);
      padding: 0.1rem var(--pill-pad) 0;
      border-radius: var(--radius-round);
      background: #111;
      color: var(--light-100);
      font-family: var(--display-family);
      font-size: var(--pill-type);
      line-height: 1;
      text-transform: uppercase;
      text-decoration: none;
      transition: background-color 0.3s ease, color 0.3s ease;
      & svg {
        margin-top: -0.1rem;
      }
      &:hover,
      &:focus-visible {
        background: var(--brand-500);
        color: var(--brand-text);
      }
    }
    .brand-web_caption.is-on-dark .brand-web_visit2 {
      background: var(--light-100);
      color: var(--dark-900);
    }
    .brand-web_go {
      display: grid;
      place-items: center;
      width: 2.75rem;
      aspect-ratio: 1;
      border-radius: 50%;
      background: var(--text);
      color: var(--background);
      transition: transform 0.25s ease, background-color 0.25s ease, color 0.25s ease;
    }
    .brand-web_caption.is-on-dark .brand-web_go {
      background: var(--light-100);
      color: var(--dark-900);
    }
    .brand-web_visit2:hover .brand-web_go,
    .brand-web_visit2:focus-visible .brand-web_go {
      transform: scale(1.08);
      background: var(--brand-500);
      color: #111;
    }
    /* 16 : 11.5 inside the frame (Hunter, Nov 17: "a bit taller"), the recordings made at exactly that shape
       (media/scroll-tall, scripts/record-scroll-loops.mjs --tall), so no site is ever cut off */
    .brand-web_glass {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 11.5;
      overflow: hidden;
      border-radius: clamp(0.5rem, 0.9vw, 0.85rem);
      background: #111;
      & video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
      }
    }
    .brand-web_mac {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    /* the live 3D laptop over the render; once it draws, the render steps aside */
    .brand-web_device .mac3d {
      position: absolute;
      inset: -12% -8%;
      width: 116%;
      height: 124%;
      pointer-events: none;
    }
    .brand-web_device.is-3d > .brand-web_mac,
    .brand-web_device.is-3d > .brand-web_screen {
      visibility: hidden;
    }
    .brand-web_screen {
      position: absolute;
      top: 0;
      left: 0;
      overflow: hidden;
      transform-origin: 0 0;
      background: var(--site-ground, #111);
    }
    /* the site's own scroll-through, recorded full bleed at 16:10 (media/scroll, not the matted card loops,
       which put the site in a frame inside the screen: Hunter, Nov 17, "cropped in very weird ways"); the glass
       is a touch taller (1.54), so the recording fills it exactly, stretched 4% tall rather than cropped */
    .brand-web_video {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: fill;
    }
    /* the name, its line and the link, under the pages on the left; under the laptop on a phone */
    .brand-web_caption {
      position: absolute;
      left: 0;
      bottom: clamp(1.25rem, 2vw, 2rem);
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2, 0.5rem);
      /* well clear of the site (Hunter, Nov 18: "the subcopy is too close") */
      width: calc(100% - var(--dev-w, 68%) - clamp(2.5rem, 5vw, 5.5rem));
      max-width: 24rem;
      /* on a phone the words come first, over the site, on its left edge, and the site runs past the row's line
         and is cut there (Hunter, Nov 18) */
      @media (width < 48rem) {
        position: static;
        order: -1;
        width: 100%;
        max-width: none;
        margin: 0 0 var(--space-5);
        padding: 0;
      }
    }
    .brand-web_line {
      margin: 0;
      color: color-mix(in srgb, currentColor 72%, transparent);
    }
    .brand-web_links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.6rem 1.25rem;
      margin-top: var(--space-2, 0.5rem);
    }
    /* the film's play button: a pill in the text colour */
    .brand-web_film {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.45rem 0.85rem 0.45rem 0.7rem;
      border: 0;
      border-radius: 99rem;
      background: currentColor;
      cursor: pointer;
      & svg,
      & {
        color: inherit;
      }
    }
    .brand-web_film {
      background: var(--text);
      color: var(--background);
    }
    .brand-web_caption.is-on-dark .brand-web_film {
      background: var(--light-100);
      color: var(--dark-900);
    }
    .brand-web_film-video {
      display: block;
      width: 100%;
      height: 100%;
      max-height: 100svh;
      object-fit: contain;
      background: #000;
    }
    .brand-web_visit {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 0.2em;
      text-decoration-thickness: 1px;
      &:hover {
        text-decoration-thickness: 2px;
      }
    }
    .brand-web_credit {
      margin: var(--space-6) 0 0;
      font-size: 0.6875rem;
      opacity: 0.5;
      color: var(--light-100);
      & a {
        color: inherit;
      }
    }
    .brand-web_logo {
      display: block;
      height: clamp(1.6rem, 2.4vw, 2.25rem);
      margin: 0 0 var(--space-2, 0.5rem);
      & svg {
        display: block;
        width: auto;
        height: 100%;
      }
    }
    .brand-web_name {
      position: relative;
      z-index: 2;
      width: fit-content;
      margin: 0;
      transition: color 0.3s ease;
    }
    .brand-web_caption {
      transition: color 0.3s ease;
      &.is-on-dark {
        color: var(--light-100);
      }
    }
  }
</style>
