---
import Section from "@/components/wrapper/Section.astro";
import { WORK } from "@/data/work.js";
import { projectLink, restLoop } from "@/data/project-link.js";
import MAC from "@/data/macbook-angle.json";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The headline; a "|" breaks it onto a second line. */
  heading: string;
  /** A line under the headline. */
  lead?: string;
  /** Each pair: pages of the partner's brand guidelines, then the site we built from them. */
  pairs: {
    /** The project's slug in src/data/work.js (its loop, link and name come from there). */
    slug: string;
    /** 16:9 pages of the brand guidelines, as the partner delivered them. */
    slides: { src: string; alt: string }[];
  }[];
}

const { render = true, heading, lead, pairs } = Astro.props;
/* Brand to website (Hunter, Nov 17: "a handful of the brand guidelines that are essentially a 16:9 static
   PDF that Primary sends over ... and then you see a looped version of the website on the right"). The
   pages are Primary's own (the brand book Figma files); the site plays on Kinetic's MacBook, a Blender
   render (devices.py, el 8) with its screen's corners as fractions of the frame (src/data/macbook-angle.json),
   so the loop sits exactly on the glass.
   Later on Nov 17 (Hunter): the laptops turn to the left (az +12), bigger, the rows taller, no "Website
   by Kinetic" tag or industry; and the pages ride a barrel: "they came in from the left, but they were
   closer to us the more on the left they were, and then they got pulled into the website", going "all
   the way behind the screen of the laptop". Each row's pages travel a curve in depth (a quarter of an
   ellipse seen from inside): near and facing us at the page's left edge, turning and shrinking as they
   run right, and slipping behind the laptop's screen. Two lines of pages, the top one slower. */
const rows = pairs
  .map((p) => ({ p, w: WORK.find((w) => w.slug === p.slug) }))
  .filter((r): r is { p: (typeof pairs)[number]; w: (typeof WORK)[number] } => Boolean(r.w && restLoop(r.w) && r.p.slides.length))
  .map(({ p, w }) => ({ p, w, loop: restLoop(w)!, link: projectLink(w) }));
---

{
  render && rows.length > 0 && (
    <Section paddingTop="large" paddingBottom="large" class="brand-web" gap="0">
      <div class="brand-web_head" data-reveal>
        <h2 class="brand-web_title text-style-h2">
          {heading.split("|").map((line) => <span>{line.trim()}</span>)}
        </h2>
        {lead && <p class="brand-web_lead text-style-main">{lead}</p>}
      </div>
      <ul class="brand-web_list" data-brand-web style={`--mac-ratio:${MAC.width / MAC.height}`}>
        {rows.map(({ p, w, loop, link }) => (
          <li class="brand-web_row" data-reveal>
            <div class="brand-web_pair">
              <figure class="brand-web_book" aria-label={`${w.name} brand guidelines by Primary`} data-book>
                {[p.slides.filter((_, i) => i % 2 === 0), p.slides.filter((_, i) => i % 2 === 1)].map((line, r) => (
                  <template data-line={r}>
                    {line.map((s) => (
                      <img class="brand-web_slide" src={s.src} alt="" width="1280" height="720" decoding="async" draggable="false" />
                    ))}
                  </template>
                ))}
                <ul class="sr-only">
                  {p.slides.map((s) => (
                    <li>{s.alt}</li>
                  ))}
                </ul>
              </figure>
              <a class="brand-web_device" {...link} aria-label={`${w.name}, the website`} data-mac>
                <img class="brand-web_mac" src={MAC.src} alt="" width={MAC.width} height={MAC.height} loading="lazy" decoding="async" />
                <span class="brand-web_screen">
                  <video class="brand-web_video" data-src={loop.src} poster={loop.poster} muted loop playsinline preload="none" aria-hidden="true" />
                </span>
              </a>
            </div>
            <p class="brand-web_name text-style-h5">{w.name}</p>
          </li>
        ))}
      </ul>
    </Section>
  )
}

<script define:vars={{ MAC }}>
  // the site loop laid onto the laptop's screen, kept there as the layout resizes
  const fit = (dev) => {
    const W = dev.clientWidth, H = dev.clientHeight, [sw, sh] = MAC.screen, s = dev.querySelector(".brand-web_screen");
    const q = MAC.q.map(([x, y]) => [x * W, y * H]);
    s.style.width = sw + "px";
    s.style.height = sh + "px";
    s.style.transform = `matrix(${(q[1][0] - q[0][0]) / sw},${(q[1][1] - q[0][1]) / sw},${(q[3][0] - q[0][0]) / sh},${(q[3][1] - q[0][1]) / sh},${q[0][0]},${q[0][1]})`;
  };
  document.querySelectorAll("[data-mac]").forEach((dev) => { new ResizeObserver(() => fit(dev)).observe(dev); fit(dev); });

  /* The barrel. In the book's own box (x right, y down, z toward us, the camera's perspective at the
     laptop's screen), a page at angle th (0 to TH) sits on a quarter ellipse round the point
     (left, far):  x = x0 + rx sin(th),  z = zFar + rz cos(th),  turned rotateY(atan(rz sin th / rx cos th))
     so it lies along the curve. th runs at an even pace, so the pages keep their spacing. */
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const TH = 1.18; // where the curve ends, about 68 degrees round: behind the screen
  const LINES = [
    { y: -0.2, lap: 30 }, // seconds for a page to cross, top line slower
    { y: 0.2, lap: 20 },
  ];
  document.querySelectorAll(".brand-web_pair").forEach((pair) => {
    const book = pair.querySelector("[data-book]");
    const dev = pair.querySelector("[data-mac]");
    const row = pair.closest(".brand-web_row");
    const lines = [...book.querySelectorAll("template[data-line]")].map((t, r) => {
      const imgs = [...t.content.querySelectorAll("img")];
      return { ...LINES[r], imgs, els: [], n: 0 };
    });
    let geo = null;
    const build = () => {
      const B = book.getBoundingClientRect(), D = dev.getBoundingClientRect();
      const H = D.height, h = H * 0.25, w = (h * 16) / 9;
      const q = MAC.q;
      const sx = D.left - B.left + ((q[0][0] + q[1][0] + q[2][0] + q[3][0]) / 4) * D.width;
      const sy = D.top - B.top + ((q[0][1] + q[1][1] + q[2][1] + q[3][1]) / 4) * D.height;
      const P = H * 2.2; // the perspective
      const zNear = P * 0.36, zFar = -P * 1.7;
      const x0 = -w * 0.5, rx = sx - x0, rz = zNear - zFar;
      // the curve's length, so each line holds as many pages as fit along it with a gap between
      let len = 0;
      for (let i = 0, px = x0, pz = zNear; i <= 60; i++) {
        const th = (i / 60) * TH, x = x0 + rx * Math.sin(th), z = zFar + rz * Math.cos(th);
        len += Math.hypot(x - px, z - pz);
        px = x;
        pz = z;
      }
      book.style.perspective = `${P}px`;
      book.style.perspectiveOrigin = `${sx}px ${sy}px`;
      geo = { w, h, sx, sy, x0, rx, rz, zFar, H };
      for (const L of lines) {
        const n = Math.max(L.imgs.length, Math.ceil(len / (w * 1.08)));
        if (n !== L.n) {
          L.els.forEach((e) => e.remove());
          L.els = Array.from({ length: n }, (_, i) => {
            const img = L.imgs[i % L.imgs.length].cloneNode();
            book.append(img);
            return img;
          });
          L.n = n;
        }
        for (const e of L.els) {
          e.style.width = `${w}px`;
          e.style.height = `${h}px`;
        }
      }
    };
    const draw = (t) => {
      if (!geo) return;
      const { w, h, sy, x0, rx, rz, zFar, H } = geo;
      for (const L of lines) {
        const y = sy + L.y * H * 0.9 - h / 2;
        L.els.forEach((e, i) => {
          const f = (((i / L.n + t / L.lap) % 1) + 1) % 1;
          const th = f * TH;
          const x = x0 + rx * Math.sin(th) - w / 2;
          const z = zFar + rz * Math.cos(th);
          const turn = 0.55 * Math.atan2(rz * Math.sin(th), rx * Math.cos(th)); // eased, so a page never goes edge-on
          e.style.transform = `translate3d(${x.toFixed(1)}px,${y.toFixed(1)}px,${z.toFixed(1)}px) rotateY(${turn.toFixed(4)}rad)`;
          e.style.zIndex = String(Math.round(z + 4000));
        });
      }
    };
    let on = false, raf = 0, t0 = 0, t = 7;
    const frame = (now) => {
      raf = 0;
      if (!on) return;
      if (t0) t += Math.min(0.05, (now - t0) / 1000);
      t0 = now;
      draw(t);
      raf = requestAnimationFrame(frame);
    };
    new ResizeObserver(() => {
      build();
      draw(t);
    }).observe(pair);
    // each row plays (its pages drifting, its site looping) while it is on screen, and rests when it isn't
    const v = dev.querySelector("video[data-src]");
    new IntersectionObserver(
      ([e]) => {
        on = e.isIntersecting && !reduced;
        if (on && !raf) {
          t0 = 0;
          raf = requestAnimationFrame(frame);
        }
        if (!v || reduced) return;
        if (e.isIntersecting) {
          if (!v.src) v.src = v.dataset.src;
          v.play().catch(() => {});
        } else v.pause();
      },
      { rootMargin: "15% 0px" },
    ).observe(row);
  });
</script>

<style is:global>
  @layer components {
    .brand-web_head {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      width: 100%;
      margin-bottom: var(--space-8);
    }
    .brand-web_title {
      display: flex;
      flex-direction: column;
      margin: 0;
    }
    .brand-web_lead {
      max-width: 40ch;
      margin: 0;
      color: color-mix(in srgb, var(--text) 72%, transparent);
    }
    .brand-web_list {
      display: flex;
      flex-direction: column;
      gap: var(--space-10, 8rem);
      width: 100%;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .brand-web_row {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    /* the laptop on the right, big; the pages run in behind it from the page's left edge */
    .brand-web_pair {
      position: relative;
      display: flex;
      justify-content: flex-end;
      padding-block: clamp(1rem, 3vw, 3rem);
    }
    .brand-web_book {
      position: absolute;
      inset: -4rem 0 -4rem calc(-1 * var(--site-margin, 1.5rem));
      margin: 0;
      overflow: hidden;
      pointer-events: none;
    }
    .brand-web_slide {
      position: absolute;
      top: 0;
      left: 0;
      display: block;
      transform-origin: 50% 50%;
      backface-visibility: hidden;
      box-shadow: 0 0 0 1px rgb(17 17 17 / 0.06);
      will-change: transform;
    }
    .brand-web_device {
      position: relative;
      z-index: 1;
      display: block;
      width: min(68%, 62rem);
      aspect-ratio: var(--mac-ratio, 1.6);
      @media (width < 48rem) {
        width: 82%;
      }
    }
    .brand-web_mac {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    .brand-web_screen {
      position: absolute;
      top: 0;
      left: 0;
      overflow: hidden;
      transform-origin: 0 0;
      background: #111;
    }
    .brand-web_video {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
    }
    .brand-web_name {
      margin: 0;
    }
  }
</style>
