---
import Section from "@/components/wrapper/Section.astro";
import { WORK } from "@/data/work.js";
import { projectLink, restLoop } from "@/data/project-link.js";
import MAC from "@/data/macbook-angle.json";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The headline; a "|" breaks it onto a second line. */
  heading: string;
  /** A line under the headline. */
  lead?: string;
  /** Each pair: pages of the partner's brand guidelines, then the site we built from them. */
  pairs: {
    /** The project's slug in src/data/work.js (its loop, link and name come from there). */
    slug: string;
    /** 16:9 pages of the brand guidelines, as the partner delivered them. */
    slides: { src: string; alt: string }[];
  }[];
}

const { render = true, heading, lead, pairs } = Astro.props;
/* Brand to website (Hunter, Nov 17: "a handful of the brand guidelines that are essentially a 16:9 static
   PDF that Primary sends over. Those move from left to right, almost like a slow marquee, and then you see a
   looped version of the website on the right. You see how those feed into the expressiveness of the
   execution"). The pages are Primary's own (the brand book Figma files); the site plays on Kinetic's
   MacBook, rendered head-on in Blender (Hunter: "it can't be a super aggressive angle"), its screen box
   measured from the render (devices.py corners), so the loop sits exactly on the glass. */
/* Nov 17 (Hunter): "two rows of the marquee. The top one could go a little bit slower than the bottom one",
   cut hard at the page edge. The laptop is one Blender render (devices.py, az -12, el 8), turned a little
   toward the pages (Hunter: "just render it at a slightly sideways angle for now", after a scroll-driven
   turn), with its screen's corners as fractions of the frame (src/data/macbook-angle.json); the script lays
   the loop onto the screen with an affine transform (an orthographic camera turns the screen into an exact
   parallelogram). */
const rows = pairs
  .map((p) => ({ p, w: WORK.find((w) => w.slug === p.slug) }))
  .filter((r): r is { p: (typeof pairs)[number]; w: (typeof WORK)[number] } => Boolean(r.w && restLoop(r.w) && r.p.slides.length))
  .map(({ p, w }) => ({ p, w, loop: restLoop(w)!, link: projectLink(w) }));
---

{
  render && rows.length > 0 && (
    <Section paddingTop="large" paddingBottom="large" class="brand-web" gap="0">
      <div class="brand-web_head" data-reveal>
        <h2 class="brand-web_title text-style-h2">
          {heading.split("|").map((line) => <span>{line.trim()}</span>)}
        </h2>
        {lead && <p class="brand-web_lead text-style-main">{lead}</p>}
      </div>
      <ul class="brand-web_list" data-brand-web style={`--turn-ratio:${MAC.width / MAC.height}`}>
        {rows.map(({ p, w, loop, link }) => (
          <li class="brand-web_row" data-reveal>
            <div class="brand-web_pair">
              <figure class="brand-web_book" aria-label={`${w.name} brand guidelines by Primary`}>
                {[p.slides.filter((_, i) => i % 2 === 0), p.slides.filter((_, i) => i % 2 === 1)].map((line, r) => (
                  <div class:list={["brand-web_track", r === 0 ? "is-slow" : "is-fast"]} style={`--count:${line.length}`}>
                    {[0, 1].map((copy) => (
                      <div class="brand-web_set" aria-hidden={copy === 1 ? "true" : undefined}>
                        {line.map((s) => (
                          <img class="brand-web_slide" src={s.src} alt={copy === 0 ? s.alt : ""} width="1280" height="720" loading="lazy" decoding="async" />
                        ))}
                      </div>
                    ))}
                  </div>
                ))}
                <figcaption class="brand-web_tag text-style-label">Brand guidelines by Primary</figcaption>
              </figure>
              <a class="brand-web_device" {...link} aria-label={`${w.name}, the website`} data-mac>
                <img class="brand-web_mac" src={MAC.src} alt="" width={MAC.width} height={MAC.height} loading="lazy" decoding="async" />
                <span class="brand-web_screen">
                  <video class="brand-web_video" data-src={loop.src} poster={loop.poster} muted loop playsinline preload="none" aria-hidden="true" />
                </span>
                <span class="brand-web_tag brand-web_tag--site text-style-label">Website by Kinetic</span>
              </a>
            </div>
            <p class="brand-web_caption">
              <span class="brand-web_name text-style-h5">{w.name}</span>
              <span class="brand-web_meta text-style-label">{w.industry}</span>
            </p>
          </li>
        ))}
      </ul>
    </Section>
  )
}

<script define:vars={{ MAC }}>
  // the site loop laid onto the laptop's screen, kept there as the layout resizes
  const fit = (dev) => {
    const W = dev.clientWidth, H = dev.clientHeight, [sw, sh] = MAC.screen, s = dev.querySelector(".brand-web_screen");
    const q = MAC.q.map(([x, y]) => [x * W, y * H]);
    s.style.width = sw + "px";
    s.style.height = sh + "px";
    s.style.transform = `matrix(${(q[1][0] - q[0][0]) / sw},${(q[1][1] - q[0][1]) / sw},${(q[3][0] - q[0][0]) / sh},${(q[3][1] - q[0][1]) / sh},${q[0][0]},${q[0][1]})`;
  };
  document.querySelectorAll("[data-mac]").forEach((dev) => { new ResizeObserver(() => fit(dev)).observe(dev); fit(dev); });
</script>

<script>
  // each row plays (its pages drifting, its site looping) while it is on screen, and rests when it isn't
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-brand-web]").forEach((root) => {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const row = e.target as HTMLElement;
        row.classList.toggle("is-playing", e.isIntersecting && !reduced);
        const v = row.querySelector<HTMLVideoElement>("video[data-src]");
        if (!v || reduced) continue;
        if (e.isIntersecting) {
          if (!v.src) v.src = v.dataset.src!;
          v.play().catch(() => {});
        } else v.pause();
      }
    }, { rootMargin: "15% 0px" });
    root.querySelectorAll(".brand-web_row").forEach((row) => io.observe(row));
  });
</script>

<style is:global>
  @layer components {
    .brand-web_head {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      width: 100%;
      margin-bottom: var(--space-8);
    }
    .brand-web_title {
      display: flex;
      flex-direction: column;
      margin: 0;
    }
    .brand-web_lead {
      max-width: 40ch;
      margin: 0;
      color: color-mix(in srgb, var(--text) 72%, transparent);
    }
    .brand-web_list {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
      width: 100%;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .brand-web_row {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    /* the guidelines on the left, the laptop on the right, the same height */
    .brand-web_pair {
      --row-h: clamp(16rem, 30vw, 30rem);
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: clamp(1rem, 3vw, 3rem);
      @media (width < 48rem) {
        --row-h: auto;
        grid-template-columns: 1fr;
      }
    }
    /* the brand book: two rows of its pages run left to right, the top one slower, cut hard at the page's
       left edge and at the laptop's side, no rounding and no fade */
    .brand-web_book {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      height: calc(var(--row-h) * 0.82);
      margin: 0 0 0 calc(-1 * var(--site-margin, 1.5rem));
      overflow: hidden;
      @media (width < 48rem) {
        height: auto;
        margin-right: calc(-1 * var(--site-margin, 1.5rem));
      }
    }
    .brand-web_track {
      display: flex;
      flex: 1 1 0;
      min-height: 0;
      width: max-content;
      animation: brand-web-drift calc(var(--count) * var(--per)) linear infinite;
      animation-play-state: paused;
      @media (width < 48rem) {
        flex: none;
        height: 9rem;
      }
    }
    .brand-web_track.is-slow {
      --per: 11s;
    }
    .brand-web_track.is-fast {
      --per: 7s;
    }
    .brand-web_row.is-playing .brand-web_track {
      animation-play-state: running;
    }
    .brand-web_set {
      display: flex;
      gap: 0.6rem;
      height: 100%;
      padding-right: 0.6rem;
    }
    .brand-web_slide {
      display: block;
      height: 100%;
      width: auto;
      aspect-ratio: 16 / 9;
    }
    /* left to right: the second copy starts where the first sits, so the loop has no seam */
    @keyframes brand-web-drift {
      from {
        transform: translateX(-50%);
      }
      to {
        transform: translateX(0);
      }
    }
    .brand-web_tag {
      position: absolute;
      top: var(--space-3);
      left: calc(var(--site-margin, 1.5rem) + var(--space-3));
      z-index: 1;
      padding: 0.3rem 0.6rem;
      border-radius: 99rem;
      background: var(--background);
      color: var(--text);
    }
    .brand-web_tag--site {
      left: auto;
      right: 0;
      top: 0;
    }
    /* the laptop, a little sideways, with the site playing on its screen */
    .brand-web_device {
      position: relative;
      display: block;
      height: var(--row-h);
      aspect-ratio: var(--turn-ratio, 1.333);
      @media (width < 48rem) {
        height: auto;
        width: 100%;
      }
    }
    .brand-web_mac {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    .brand-web_screen {
      position: absolute;
      top: 0;
      left: 0;
      overflow: hidden;
      transform-origin: 0 0;
      background: #111;
    }
    .brand-web_video {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
    }
    .brand-web_caption {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--space-3);
      margin: 0;
    }
    .brand-web_name {
      margin: 0;
    }
    .brand-web_meta {
      color: color-mix(in srgb, var(--text) 55%, transparent);
    }
    @media (prefers-reduced-motion: reduce) {
      .brand-web_track {
        animation: none;
        transform: translateX(-25%);
      }
      .brand-web_track.is-fast {
        transform: translateX(-10%);
      }
    }
  }
</style>
