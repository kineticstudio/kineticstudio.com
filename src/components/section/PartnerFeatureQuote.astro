---
import DATA from "@/data/testimonials.json";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Which page's featured quote (src/data/testimonials.json, `featured: true`). */
  page: string;
  /** The quoted person's company logo, raw SVG, beside the name. */
  logo?: string;
}

const { render = true, page, logo } = Astro.props;
/* One big quote from the partner's founder (Hunter, Nov 17: "Just like ... Noon Studio, like that reference,
   there is a quote from Nick [Pattison], the founder of Primary. Let's make a big quote for that"). The same
   rule as every quote: only approved words render; preview builds (PUBLIC_DRAFT_QUOTES=1) and the Studio copy
   show it marked as a draft. */
const drafts = import.meta.env.PUBLIC_DRAFT_QUOTES === "1" || process.env.KS_STUDIO_BUILD === "1";
type Q = { quote: string; name: string; role?: string; company: string; approved: boolean; featured?: boolean; avatar?: string; pages: string[] };
const q = (DATA.quotes as Q[]).find((x) => x.featured && x.pages.includes(page) && (x.approved || drafts));
const words = q ? `\u201C${q.quote}\u201D`.split(/\s+/) : [];
const clean = (svg: string) => svg.replace(/<!--[\s\S]*?-->/g, "").replace(/\sid="[^"]*"/g, "").replace(/<svg /, '<svg aria-hidden="true" ');
---

<script>
  // each word goes from dim to white as the quote rises through the screen; without script, or with reduced
  // motion, it is simply white
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-fquote]").forEach((el) => {
    if (reduced) return;
    const words = [...el.querySelectorAll<HTMLElement>(".fquote_w")];
    el.classList.add("is-scrubbed");
    let queued = 0;
    const draw = () => {
      queued = 0;
      const r = el.getBoundingClientRect();
      // 0 when its top is 85% down the screen, 1 when its bottom reaches 45%
      const start = innerHeight * 0.85, end = innerHeight * 0.45;
      const p = Math.min(1, Math.max(0, (start - r.top) / (start - end + r.height)));
      const lit = p * (words.length + 2);
      words.forEach((w, i) => w.style.setProperty("--lit", String(Math.min(1, Math.max(0, lit - i)))));
    };
    const queue = () => (queued ||= requestAnimationFrame(draw));
    addEventListener("scroll", queue, { passive: true });
    addEventListener("resize", queue);
    draw();
  });
</script>

{
  render && q && (
    <section class="fquote theme-light" aria-label={`${q.name}, ${q.company}`}>
      <figure class="fquote_inner" data-reveal>
        {/* the quote, its words lighting up white as it scrolls by (Hunter, Nov 17), then who said it: the
            company named in the line, no logo ("it just looks like a typeface") */}
        <blockquote class="fquote_text" data-fquote>
          {words.map((w, i) => <span class="fquote_w" style={`--i:${i}`}>{w}{i < words.length - 1 ? " " : ""}</span>)}
        </blockquote>
        <figcaption class="fquote_by text-style-main">
          {q.avatar && <img class="fquote_avatar" src={q.avatar} alt="" width="96" height="96" loading="lazy" decoding="async" />}
          <span>{q.name}{q.role ? `, ${q.role} of ${q.company}` : `, ${q.company}`}</span>
        </figcaption>
      </figure>
    </section>
  )
}

<style is:global>
  @layer components {
    /* on white (Hunter, Nov 18: "make this section white") */
    .fquote {
      --background: #fff;
      background: var(--background);
      color: var(--text);
      /* a taller section (Hunter, Nov 18): a full screen, the quote in the middle of it */
      display: grid;
      align-items: center;
      min-height: 100svh;
      padding: var(--section-space-large) var(--site-margin);
    }
    /* left-aligned (Hunter, Nov 17) */
    .fquote_inner {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-6);
      max-width: var(--max-width-main, 90rem);
      margin: 0 auto;
      text-align: left;
    }
    /* in the headline face (Hunter, Nov 18) */
    .fquote_text {
      margin: 0;
      font-family: var(--h2-font-family);
      font-weight: var(--h2-font-weight);
      text-transform: var(--h2-text-transform);
      letter-spacing: var(--h2-letter-spacing);
      font-size: clamp(2.5rem, 6.4vw, 6rem);
      line-height: 0.95;
      max-width: 15em;
      color: var(--text); /* full ink, lit word by word (Hunter, Nov 17) */
      text-wrap: pretty;
      &.is-scrubbed .fquote_w {
        opacity: calc(0.22 + 0.78 * var(--lit, 0));
      }
    }
    .fquote_by {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-start;
      align-items: center;
      gap: 1rem;
      margin: 0;
      color: var(--text);
      font-size: clamp(1.1rem, 1.4vw, 1.35rem);
    }
    .fquote_avatar {
      display: block;
      width: 4rem;
      height: 4rem;
      border-radius: 50%;
      object-fit: cover;
    }
    .fquote_company {
      margin: 0;
    }
    .fquote_logo {
      display: block;
      height: clamp(1.75rem, 2.6vw, 2.5rem);
      margin: 0;
      color: var(--text);
      & svg {
        display: block;
        width: auto;
        height: 100%;
      }
    }
    .fquote_draft {
      padding: 0.05rem 0.45rem;
      border-radius: 99rem;
      background: #c8ff54;
      color: #111;
    }
  }
</style>
