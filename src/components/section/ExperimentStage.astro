---
import { EXPERIMENTS } from "@/data/experiments.js";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The experiment, from src/data/experiments.js. */
  experiment: (typeof EXPERIMENTS)[number];
}

const { render = true, experiment: e } = Astro.props;
const live = EXPERIMENTS.filter((x) => x.kind === "live");
const at = live.findIndex((x) => x.slug === e.slug);
const prev = live[(at - 1 + live.length) % live.length];
const next = live[(at + 1) % live.length];
---

{
  render && (
    <section class="exp_wrap" data-exp={e.slug}>
      <div class="exp_stage" data-stage />

      <header class="exp_head">
        <a class="exp_back text-style-label" href="/playground">← Playground</a>
        <h1 class="exp_title text-style-h3">{e.title}</h1>
        <p class="exp_note text-style-label">{e.note}</p>
        {/* whose work it came from (Oct 25: the Playground leans on the client work) */}
        {"from" in e && e.from && <p class="exp_from pill is-chip">{e.from}</p>}
        {/* Hunter, Oct 25: "People don't know what params are, so maybe we
            have a little label" */}
        <p class="exp_hint text-style-label">Feel free to play around with the parameters.</p>
        <div class="exp_actions">
          <button class="exp_btn pill is-primary" type="button" data-toggle>Parameters <kbd>P</kbd></button>
          <button class="exp_btn pill is-secondary" type="button" data-randomize>Randomize</button>
          <button class="exp_btn pill is-secondary" type="button" data-reset>Reset</button>
          <button class="exp_btn pill is-secondary" type="button" data-share>Copy link</button>
        </div>
      </header>

      <nav class="exp_pager" aria-label="More experiments">
        <a class="exp_page text-style-label" href={`/playground/${prev.slug}`}>← {prev.title}</a>
        <span class="exp_count text-style-label">{String(at + 1).padStart(2, "0")} / {String(live.length).padStart(2, "0")}</span>
        <a class="exp_page text-style-label" href={`/playground/${next.slug}`}>{next.title} →</a>
      </nav>
    </section>
  )
}

<script>
  import { hostExperiment } from "@/scripts/experiment-host.js";

  const modules = import.meta.glob("../../experiments/*.js");

  document.querySelectorAll<HTMLElement>("[data-exp]").forEach(async (root) => {
    const slug = root.dataset.exp!;
    const stage = root.querySelector<HTMLElement>("[data-stage]")!;
    const load = modules[`../../experiments/${slug}.js`];
    if (!load) {
      stage.innerHTML = `<p class="exp_missing text-style-label">This one is still in the lab.</p>`;
      return;
    }
    const mod = (await load()) as { params: object; mount: (...args: unknown[]) => unknown };
    const title = root.querySelector(".exp_title")?.textContent ?? slug;
    // Hunter's Params: the Studio's panel when framed, the standalone one here
    const host = hostExperiment(stage, mod, { title, slug, open: matchMedia("(width >= 48rem)").matches });
    if (host.framed) root.classList.add("is-framed");

    root.querySelector("[data-toggle]")!.addEventListener("click", () => host.togglePanel());
    root.querySelector("[data-randomize]")!.addEventListener("click", () => host.randomize());
    root.querySelector("[data-reset]")!.addEventListener("click", () => host.reset());
    document.addEventListener("keydown", (ev) => {
      if ((ev.target as HTMLElement).closest("input, textarea, select")) return;
      if (ev.key === "r") host.randomize();
    });
    const share = root.querySelector<HTMLButtonElement>("[data-share]")!;
    share.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        share.textContent = "Copied";
        setTimeout(() => (share.textContent = "Copy link"), 1400);
      } catch {}
    });
    addEventListener("pagehide", () => host.destroy());
  });
</script>

<style is:global>
  @layer components {
    .exp_wrap {
      position: relative;
      height: 100svh;
      overflow: hidden;
      background: var(--dark-900);
    }
    .exp_stage {
      position: absolute;
      inset: 0;
    }
    .exp_missing {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      margin: 0;
      color: color-mix(in srgb, var(--text) 50%, transparent);
    }
    /* the title card, the pager and the nav take the piece's look, as its
       Parameters panel does (experiment-host.js sets data-ksp-theme) */
    .exp_wrap {
      --glass: var(--dark-800);
    }
    html[data-ksp-theme="light"] :is(.exp_wrap, .nav_wrap:has(~ main .exp_wrap)) {
      color-scheme: light;
      --glass: var(--light-100);
      --text: var(--dark-900);
      --background: var(--light-300);
      --border: color-mix(in lab, var(--text) 20%, transparent);
      color: var(--text);
    }
    .exp_head {
      position: absolute;
      top: 5.5rem;
      left: var(--site-margin);
      z-index: 2;
      max-width: 22rem;
      padding: 1rem 1.1rem 1.1rem;
      border-radius: 1rem;
      background: color-mix(in srgb, var(--glass) 72%, transparent);
      border: var(--border-width) solid color-mix(in srgb, var(--text) 12%, transparent);
      backdrop-filter: blur(1.25rem) saturate(1.3);
      -webkit-backdrop-filter: blur(1.25rem) saturate(1.3);
    }
    .exp_back {
      color: color-mix(in srgb, var(--text) 60%, transparent);
      &:hover {
        color: var(--text);
      }
    }
    .exp_title {
      margin: var(--space-3) 0 var(--space-2);
    }
    .exp_from {
      margin: var(--space-3) 0 0;
      pointer-events: none;
    }
    .exp_note {
      margin: 0;
      color: color-mix(in srgb, var(--text) 65%, transparent);
    }
    /* the invitation, in full ink, says what the button under it opens */
    .exp_hint {
      margin: var(--space-3) 0 0;
      color: var(--text);
    }
    .exp_actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem;
      margin-top: var(--space-4);
    }
    .exp_wrap.is-framed [data-toggle] {
      display: none;
    }
    /* Hunter's standalone Params panel, kept as it is, placed under the nav */
    .ksp {
      top: 5rem !important;
      bottom: 4.5rem !important;
      right: var(--space-4) !important;
    }
    .exp_pager {
      position: absolute;
      inset: auto var(--site-margin) var(--space-4);
      z-index: 2;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .exp_page {
      padding: 0.5rem 0.8rem;
      border-radius: var(--radius-round);
      background: color-mix(in srgb, var(--glass) 60%, transparent);
      backdrop-filter: blur(0.75rem);
      color: color-mix(in srgb, var(--text) 75%, transparent);
      &:hover {
        color: var(--text);
      }
    }
    .exp_count {
      color: color-mix(in srgb, var(--text) 45%, transparent);
    }
  }
</style>
