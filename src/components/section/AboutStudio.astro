---
import markRaw from "@/assets/brand/mark-ink.svg?raw";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
const markD = markRaw.match(/ d="([^"]+)"/)![1];

// Copy from the October 2026 retainer brief (kinetic-contracts briefs/migration/overland.mjs).
const services = [
  ["Brand", ["Identity and creative direction", "Brand guidelines", "Campaign looks"]],
  ["Website", ["Design and development", "New pages and modules", "Bug fixes, usually the same day"]],
  ["Product", ["Product and app design", "Prototypes you can feel", "Design systems"]],
  ["Image, video and 3D", ["AI image generation", "Marketing and launch videos", "Product renders"]],
  ["Content", ["Blog and news post design", "Case studies and research pages", "Email templates"]],
  ["Decks", ["Investor and sales decks", "Event and keynote slides", "Templates your team can reuse"]],
];
const tools = ["claude", "chatgpt", "gemini", "midjourney", "runway", "flora", "figma", "elevenlabs"];
const studio = [
  ["Information architecture", "The whole site mapped, page by page."],
  ["Wireframing", "Real copy and structure, agreed up front."],
  ["Prototyping", "Live, interactive builds, tuned with Params."],
  ["Design rounds", "Every direction and round, side by side."],
  ["Brand guidelines", "Public, shareable and always current."],
  ["Deployment", "Preview, approve, then publish in one step."],
];
---

{
  render && (
    <div class="about_wrap">
      <header class="about_hero">
        <div class="about_intro">
          <p class="about_eyebrow text-style-label">Founder and creative director</p>
          <h1 class="about_name text-style-display">Hunter Thompson</h1>
          <p class="about_lead text-style-large">
            Kinetic is led by Hunter Thompson: a big New York agency, then founding designer at startups, and now brand and bespoke websites for the companies building what's next.
          </p>
        </div>
        <figure class="about_portrait" data-portrait>
          <svg width="0" height="0" aria-hidden="true">
            <clipPath id="about-clip" clipPathUnits="objectBoundingBox">
              <path transform="scale(0.000829 0.000871) translate(-397 -426)" d={markD} />
            </clipPath>
          </svg>
          {/* Hunter's photo goes here: public/images/hunter.jpg, shown inside the mark */}
          <video data-loop src="/media/play-kinetic-shader.mp4" poster="/media/play-kinetic-shader.jpg" muted loop playsinline aria-hidden="true" />
          <figcaption class="text-style-label">Photo to come</figcaption>
        </figure>
      </header>

      <section class="about_split">
        <div class="about_half">
          <p class="about_tag">Human</p>
          <h2 class="about_title text-style-h2">Human creative direction</h2>
          <p class="about_text text-style-large">An award-winning creative director behind the scenes, directing every individual idea, decision and move.</p>
        </div>
        <div class="about_half is-dark">
          <p class="about_tag is-lime">Realized with AI</p>
          <h2 class="about_title text-style-h2">Human ideas perfected with technology</h2>
          <p class="about_text text-style-large">Dreamed up by humans, realized with flagship AI. We know when and how to use each model to unlock the vision.</p>
          <ul class="about_tools">
            {tools.map((t) => <li><img src={`/images/ai/${t}.png`} alt={t} width="56" height="56" loading="lazy" /></li>)}
          </ul>
        </div>
      </section>

      <section class="about_services">
        <h2 class="about_title text-style-h2">Top-to-bottom creative</h2>
        <ul class="about_grid">
          {services.map(([name, items], i) => (
            <li class="about_cell" data-reveal style={`--reveal-delay:${(i % 3) * 0.06}s`}>
              <h3 class="text-style-h5">{name}</h3>
              <ul class="about_items">{(items as string[]).map((x) => <li class="text-style-small">{x}</li>)}</ul>
            </li>
          ))}
        </ul>
      </section>

      <section class="about_tool">
        <div class="about_tool-copy">
          <h2 class="about_title text-style-h2">A studio tool of our own</h2>
          <p class="about_text text-style-large">Kinetic Studio built an in-house tool that's a single source of truth for every phase of the creative process, top to bottom.</p>
          <ol class="about_steps">
            {studio.map(([t, d], i) => (
              <li>
                <span class="about_step-n text-style-label">{String(i + 1).padStart(2, "0")}</span>
                <span class="about_step-t">{t}</span>
                <span class="about_step-d text-style-small">{d}</span>
              </li>
            ))}
          </ol>
        </div>
        <figure class="about_tool-shot">
          <video data-loop data-src="/media/kinetic-studio.mp4" poster="/media/kinetic-studio.jpg" muted loop playsinline aria-hidden="true" />
        </figure>
      </section>
    </div>
  )
}

<style is:global>
  @layer components {
    .about_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--section-space-medium);
      padding: var(--section-space-nav-overlap) var(--site-margin) 0;
    }
    .about_hero {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-8);
      align-items: end;
      @media (width < 62rem) {
        grid-template-columns: 1fr;
      }
    }
    .about_eyebrow {
      margin: 0 0 var(--space-4);
      color: var(--brand-500);
    }
    .about_name {
      margin: 0;
      font-size: clamp(4.5rem, 11vw, 11rem);
      line-height: 0.82;
    }
    .about_lead {
      margin: var(--space-6) 0 0;
      max-width: 34ch;
      font-size: clamp(1.25rem, 1.9vw, 1.75rem);
      line-height: 1.3;
      color: color-mix(in srgb, var(--text) 80%, transparent);
    }
    .about_portrait {
      position: relative;
      margin: 0;
      aspect-ratio: 1206.2 / 1148;
      & video,
      & img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        clip-path: url(#about-clip);
      }
      & figcaption {
        position: absolute;
        right: 0;
        bottom: -1.75rem;
        color: color-mix(in srgb, var(--text) 40%, transparent);
      }
    }
    .about_split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      border-radius: 1.5rem;
      overflow: hidden;
      @media (width < 48rem) {
        grid-template-columns: 1fr;
      }
    }
    .about_half {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      min-height: 32rem;
      padding: var(--space-8);
      background: var(--sage-300);
      color: var(--brand-text);
      &.is-dark {
        background: var(--dark-700);
        color: var(--text);
      }
    }
    .about_tag {
      align-self: flex-start;
      margin: 0 0 auto;
      padding: 0.45rem 0.8rem 0.35rem;
      border-radius: var(--radius-round);
      border: var(--border-width) solid currentColor;
      font-family: var(--display-family);
      font-size: 1rem;
      line-height: 1;
      text-transform: uppercase;
      &.is-lime {
        border-color: var(--brand-500);
        background: var(--brand-500);
        color: var(--brand-text);
      }
    }
    .about_title {
      margin: 0;
      max-width: 14ch;
    }
    .about_text {
      margin: 0;
      max-width: 36ch;
      opacity: 0.8;
    }
    .about_tools {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin: var(--space-3) 0 0;
      & img {
        width: 3rem;
        height: 3rem;
        border-radius: 0.75rem;
      }
    }
    .about_services {
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }
    .about_grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      margin: 0;
      border-top: var(--border-width) solid var(--grey-300);
      border-left: var(--border-width) solid var(--grey-300);
      @media (width < 62rem) {
        grid-template-columns: repeat(2, 1fr);
      }
      @media (width < 40rem) {
        grid-template-columns: 1fr;
      }
    }
    .about_cell {
      padding: var(--space-6);
      border-right: var(--border-width) solid var(--grey-300);
      border-bottom: var(--border-width) solid var(--grey-300);
      & h3 {
        margin: 0 0 var(--space-4);
      }
    }
    .about_items {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      margin: 0;
      color: color-mix(in srgb, var(--text) 65%, transparent);
    }
    .about_tool {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: var(--space-8);
      align-items: center;
      @media (width < 62rem) {
        grid-template-columns: 1fr;
      }
    }
    .about_tool-copy {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
    }
    .about_steps {
      margin: var(--space-3) 0 0;
      border-top: var(--border-width) solid var(--grey-300);
      & li {
        display: grid;
        grid-template-columns: 2.5rem 1fr 1.3fr;
        gap: var(--space-3);
        align-items: baseline;
        padding: var(--space-3) 0;
        border-bottom: var(--border-width) solid var(--grey-300);
        @media (width < 40rem) {
          grid-template-columns: 2.5rem 1fr;
          .about_step-d {
            grid-column: 2;
          }
        }
      }
    }
    .about_step-n,
    .about_step-d {
      color: color-mix(in srgb, var(--text) 50%, transparent);
    }
    .about_step-t {
      font-family: var(--display-family);
      font-size: 1.375rem;
      line-height: 1;
      text-transform: uppercase;
    }
    .about_tool-shot {
      margin: 0;
      overflow: hidden;
      border-radius: var(--radius-media);
      aspect-ratio: 16 / 10;
      & video {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }
  }
</style>
