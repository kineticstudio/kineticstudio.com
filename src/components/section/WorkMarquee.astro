---
import MEDIA from "@/data/media.json";
import { WORK } from "@/data/work.js";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Label over the marquee. */
  heading?: string;
}

const { render = true, heading = "Selected projects" } = Astro.props;
const media = MEDIA as Record<string, { w: number; h: number; video: boolean }>;
const pool = WORK.filter((w) => media[w.cover]);
// two rows, every other project in each, running opposite ways
const rows = [pool.filter((_, i) => i % 2 === 0), pool.filter((_, i) => i % 2 === 1)];
---

{
  render && (
    <section class="marquee_wrap" data-marquee>
      <p class="marquee_label text-style-label">{heading}</p>
      {rows.map((row, r) => (
        <div class:list={["marquee_row", r % 2 && "is-reverse"]} style={`--count:${row.length}`}>
          {/* the track twice over, so the loop never shows its seam */}
          {[0, 1].map((copy) => (
            <ul class="marquee_track" aria-hidden={copy ? "true" : undefined}>
              {row.map((w) => (
                <li class="marquee_item">
                  <a
                    class="marquee_card"
                    href={w.case ? `/work/${w.slug}` : w.url}
                    target={w.case ? undefined : "_blank"}
                    rel={w.case ? undefined : "noopener"}
                    tabindex={copy ? -1 : undefined}
                  >
                    <span class="marquee_media">
                      <img src={`/media/${w.cover}.jpg`} alt="" loading="lazy" />
                      {media[w.cover].video && <video data-src={`/media/${w.cover}.mp4`} muted loop playsinline preload="none" />}
                    </span>
                    <span class="marquee_meta">
                      <span class="marquee_name">{w.name}</span>
                      <span class="marquee_kind">{w.industry}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ))}
        </div>
      ))}
    </section>
  )
}

<script>
  // A card plays its loop while the pointer is on it; the row holds still.
  document.querySelectorAll<HTMLElement>("[data-marquee] .marquee_card").forEach((card) => {
    const video = card.querySelector("video");
    if (!video) return;
    card.addEventListener("pointerenter", () => {
      if (!video.src) video.src = video.dataset.src!;
      video.play().catch(() => {});
      card.classList.add("is-playing");
    });
    card.addEventListener("pointerleave", () => {
      video.pause();
      card.classList.remove("is-playing");
    });
  });
</script>

<style is:global>
  @layer components {
    .marquee_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      overflow: hidden;
    }
    .marquee_label {
      margin: 0 var(--site-margin) var(--space-2);
      color: color-mix(in srgb, var(--text) 55%, transparent);
    }
    .marquee_row {
      --card-w: clamp(15rem, 24vw, 24rem);
      --gap: var(--space-3);
      display: flex;
      width: max-content;
      &:hover .marquee_track {
        animation-play-state: paused;
      }
    }
    .marquee_track {
      display: flex;
      gap: var(--gap);
      margin: 0;
      padding-right: var(--gap);
      animation: marquee-run calc(var(--count) * 5s) linear infinite;
    }
    .marquee_row.is-reverse .marquee_track {
      animation-direction: reverse;
    }
    .marquee_item {
      flex: none;
      width: var(--card-w);
    }
    .marquee_card {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      color: var(--text);
    }
    .marquee_media {
      position: relative;
      display: block;
      overflow: hidden;
      border-radius: var(--radius-media);
      aspect-ratio: 16 / 10;
      background: var(--dark-700);
      & img,
      & video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: scale 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s ease;
      }
      & video {
        opacity: 0;
      }
    }
    .marquee_card:hover .marquee_media :is(img, video) {
      scale: 1.04;
    }
    .marquee_card.is-playing video {
      opacity: 1;
    }
    .marquee_meta {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
    }
    .marquee_name {
      font-family: var(--display-family);
      font-size: 1.25rem;
      line-height: 1;
      text-transform: uppercase;
    }
    .marquee_kind {
      font-family: var(--primary-family);
      font-size: 0.7rem;
      text-transform: none;
      color: color-mix(in srgb, var(--text) 55%, transparent);
    }
    @keyframes marquee-run {
      to {
        translate: -100% 0;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .marquee_row {
        width: auto;
        overflow-x: auto;
      }
      .marquee_track {
        animation: none;
      }
      .marquee_track + .marquee_track {
        display: none;
      }
    }
  }
</style>
