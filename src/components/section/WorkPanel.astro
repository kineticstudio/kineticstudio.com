---
import type { ComponentProps } from "astro/types";
import Section from "@/components/wrapper/Section.astro";
import Grid from "@/components/wrapper/Grid.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = Pick<ComponentProps<typeof Section>, "render" | "theme"> & {
  /** Hidden heading for screen readers. */
  label?: string;
  /** Utility classes. */
  class?: string;
};

const { render = true, theme = "light", label = "Selected work", class: className, ...rest } = Astro.props;
const cards = await slotContent(Astro.slots);
---

{
  render && cards && (
    <div class="work-panel_wrap">
      <Section theme={theme} class:list={["work-panel_panel", className]} aria-label={label} {...rest}>
        <h2 class="sr-only">{label}</h2>
        <Grid medium={2} class="work-panel_list">
          <Fragment set:html={cards} />
        </Grid>
      </Section>
    </div>
  )
}

<style is:global>
  @layer components {
    /* The white panel slides up over the hero's black tail, and starts tilted
       back in 3D, rising flat as it scrolls in. Browsers without scroll-driven
       animation get the flat panel. */
    .work-panel_wrap {
      --work-panel-overlap: 31rem;
      --work-panel-radius: 3.75rem;
      position: relative;
      z-index: 5;
      perspective: 68.75rem;
      /* tilted back, the panel's far edge projects wider than the screen */
      overflow-x: clip;
      @media (width < 48rem) {
        --work-panel-overlap: 8rem;
        --work-panel-radius: 1.75rem;
      }
    }
    .work-panel_panel {
      margin-top: calc(var(--work-panel-overlap) * -1);
      border-start-start-radius: var(--work-panel-radius);
      border-start-end-radius: var(--work-panel-radius);
      @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
          animation: work-panel-rise linear both;
          animation-timeline: view();
          animation-range: entry 0px entry 520px;
        }
      }
    }
    .work-panel_list {
      gap: 4.375rem;
      @media (width < 48rem) {
        gap: 2.5rem;
      }
    }
    @keyframes work-panel-rise {
      from {
        transform: translateY(20rem) rotateX(11deg);
        opacity: 0;
      }
      to {
        transform: none;
        opacity: 1;
      }
    }
  }
</style>
