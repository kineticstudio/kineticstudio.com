---
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** What was won, under the logo. */
  label: string;
  /** Logo image path, from public/. */
  logo: string;
  /** Logo alternative text. */
  logoAlt?: string;
  /** Link destination. Leave empty for no link. */
  href?: string;
}

const { render = true, label, logo, logoAlt = "", href } = Astro.props;
const Tag = href ? "a" : "div";
---

{
  render && label && logo && (
    <li class="award_wrap">
      <Tag class="award_link" {...(href ? { href, target: "_blank", rel: "noopener" } : {})}>
        <img class="award_logo" src={logo} alt={logoAlt} loading="lazy" />
        <span class="award_label">{label}</span>
      </Tag>
    </li>
  )
}

<style is:global>
  @layer components {
    .award_link {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: inherit;
      text-decoration: none;
    }
    a.award_link {
      transition: opacity 0.3s ease;
      &:hover {
        opacity: 0.6;
      }
    }
    .award_logo {
      height: 2.125rem;
      width: auto;
      flex: none;
    }
    .award_label {
      font-size: 0.75rem;
      line-height: 1.3;
      opacity: 0.5;
    }
  }
</style>
