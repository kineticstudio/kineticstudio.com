---
import MEDIA from "@/data/media.json";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The project, from src/data/work.js. */
  work: {
    slug: string;
    name: string;
    industry: string;
    does: string[];
    cover: string;
    url?: string;
    case?: boolean;
    isNew?: boolean;
    partner?: string;
  };
  /** Card shape: the media's own ratio, or a fixed 4:3 crop. */
  ratio?: "media" | "fixed";
  /** Load the loop right away instead of when it nears the screen. */
  eager?: boolean;
  /** Utility classes. */
  class?: string;
}

const { render = true, work, ratio = "fixed", eager = false, class: className, ...rest } = Astro.props;
const m = (MEDIA as Record<string, { w: number; h: number; ground: string; video: boolean }>)[work.cover];
const href = work.case ? `/work/${work.slug}` : work.url;
const external = !work.case;
const src = `/media/${work.cover}`;
---

{
  render && m && (
    <a
      class:list={["work-card_wrap", className]}
      href={href}
      target={external ? "_blank" : undefined}
      rel={external ? "noopener" : undefined}
      data-cursor={work.case ? "View case" : "Visit site ↗"}
      data-industry={work.industry}
      data-does={work.does.join("|")}
      style={`--ground:${m.ground};--ratio:${ratio === "media" ? `${m.w}/${m.h}` : "4/3"}`}
      {...rest}
    >
      <div class="work-card_media">
        {m.video ? (
          <video
            class="work-card_video"
            data-loop
            {...(eager ? { src: `${src}.mp4` } : { "data-src": `${src}.mp4` })}
            poster={`${src}.jpg`}
            muted
            loop
            playsinline
            preload="none"
            width={m.w}
            height={m.h}
            aria-hidden="true"
          />
        ) : (
          <img class="work-card_video" src={`${src}.jpg`} alt="" width={m.w} height={m.h} loading={eager ? "eager" : "lazy"} />
        )}
        {(work.isNew || work.case) && (
          <span class="work-card_tags">
            {work.isNew && <span class="work-card_pill is-new">New</span>}
            {work.case && <span class="work-card_pill">Case study</span>}
          </span>
        )}
      </div>
      <div class="work-card_meta">
        <h3 class="work-card_name text-style-h5">{work.name}</h3>
        <p class="work-card_info text-style-label">
          <span>{work.industry}</span>
          <span>{work.does.join(", ")}{work.partner ? `, ${work.partner}` : ""}</span>
        </p>
      </div>
    </a>
  )
}

<style is:global>
  @layer components {
    .work-card_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      color: var(--text);
    }
    .work-card_media {
      position: relative;
      aspect-ratio: var(--ratio);
      overflow: hidden;
      border-radius: var(--radius-media);
      background: var(--ground);
      transform: translateZ(0);
    }
    .work-card_video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .work-card_wrap:hover .work-card_video {
      transform: scale(1.035);
    }
    .work-card_tags {
      position: absolute;
      top: var(--space-2);
      left: var(--space-2);
      display: flex;
      gap: 0.25rem;
    }
    .work-card_pill {
      padding: 0.35rem 0.6rem 0.28rem;
      border-radius: var(--radius-round);
      background: color-mix(in srgb, var(--dark-900) 70%, transparent);
      backdrop-filter: blur(0.5rem);
      color: var(--sage-300);
      font-family: var(--display-family);
      font-size: 0.875rem;
      line-height: 1;
      text-transform: uppercase;
      &.is-new {
        background: var(--brand-500);
        color: var(--brand-text);
      }
    }
    .work-card_meta {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--space-3);
    }
    .work-card_name {
      margin: 0;
    }
    .work-card_info {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.2rem;
      margin: 0;
      text-align: right;
      color: color-mix(in srgb, var(--text) 50%, transparent);
    }
  }
</style>
