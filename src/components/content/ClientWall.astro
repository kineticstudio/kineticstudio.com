---
import { CLIENTS, WORK } from "@/data/work.js";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Label over the wall. */
  heading?: string;
  /** Utility classes. */
  class?: string;
}

const { render = true, heading = "Over 60 world-class clients", class: className } = Astro.props;
const coverOf = (name: string) => WORK.find((w) => w.name === name || w.client === name || (name === "Anthropic" && w.slug === "claude"))?.cover;
---

{
  render && (
    <div class:list={["clients_wrap", className]}>
      <p class="clients_label text-style-label">{heading}</p>
      <ul class="clients_list">
        {CLIENTS.map((c, i) => {
          const cover = coverOf(c);
          return (
            <li class="clients_item" data-reveal style={`--reveal-delay:${(i % 4) * 0.05}s`} data-cover={cover}>
              {cover && <img class="clients_bg" src={`/media/${cover}.jpg`} alt="" loading="lazy" />}
              <span class="clients_name text-style-h5">{c}</span>
            </li>
          );
        })}
      </ul>
    </div>
  )
}

<style is:global>
  @layer components {
    .clients_wrap {
      width: 100%;
    }
    .clients_label {
      margin: 0 0 var(--space-4);
      color: color-mix(in srgb, var(--text) 55%, transparent);
    }
    .clients_list {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      margin: 0;
      border-top: var(--border-width) solid var(--grey-300);
      border-left: var(--border-width) solid var(--grey-300);
      @media (width < 62rem) {
        grid-template-columns: repeat(3, 1fr);
      }
      @media (width < 40rem) {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    .clients_item {
      position: relative;
      display: flex;
      align-items: flex-end;
      min-height: 7.5rem;
      padding: var(--space-4);
      overflow: hidden;
      border-right: var(--border-width) solid var(--grey-300);
      border-bottom: var(--border-width) solid var(--grey-300);
    }
    .clients_bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      scale: 1.15;
      filter: saturate(0.8);
      transition: opacity 0.5s ease, scale 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .clients_name {
      position: relative;
      margin: 0;
      color: color-mix(in srgb, var(--text) 80%, transparent);
      transition: color 0.3s ease;
    }
    .clients_item[data-cover]:hover {
      .clients_bg {
        opacity: 0.55;
        scale: 1;
      }
      .clients_name {
        color: var(--brand-500);
      }
    }
  }
</style>
