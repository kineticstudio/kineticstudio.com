---
import logoRaw from "@/assets/brand/logo.svg?raw";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Play the build on load: the lines fire in, the pill (KINETIC inside it) slides in from the right, and its pull bends the lines. */
  autoplay?: boolean;
  /** Utility classes. */
  class?: string;
}

const { render = true, autoplay = true, class: className, ...rest } = Astro.props;

// The 2026 logo (Figma "Kinetic Studio Brand" 82:6), read from the one file
const markD = logoRaw.match(/id="mark"[^>]*\sd="([^"]+)"/)![1];
const stripes = markD.split("M").filter(Boolean).map((s) => "M" + s.trim());
const letters = [...logoRaw.matchAll(/<path d="([^"]+)"\/>/g)].map((m) => m[1]);
const viewBox = logoRaw.match(/viewBox="([^"]+)"/)![1];
const rect = logoRaw.match(/<rect id="pill"[^>]*>/)![0];
const n = (k: string) => Number(rect.match(new RegExp(`\\s${k}="([\\d.]+)"`))![1]);
const pill = { x: n("x"), y: n("y"), w: n("width"), h: n("height"), r: n("rx"), sw: n("stroke-width") };
---

{
  render && (
    <div class:list={["kinetic-logo_wrap", autoplay && "is-autoplay", className]} data-kinetic-logo {...rest}>
      <svg class="kinetic-logo_svg" viewBox={viewBox} fill="none" role="img" aria-label="Kinetic">
        <g class="kinetic-logo_mark">
          {stripes.map((d) => <path class="kinetic-logo_stripe" d={d} data-d={d} fill="currentColor" fill-rule="evenodd" />)}
        </g>
        <g class="kinetic-logo_pill">
          <rect x={pill.x} y={pill.y} width={pill.w} height={pill.h} rx={pill.r} stroke="currentColor" stroke-width={pill.sw} />
          <g fill="currentColor">{letters.map((d) => <path d={d} />)}</g>
        </g>
      </svg>
    </div>
  )
}

<script>
  import { mountLogoIntro } from "@/scripts/logo-intro.js";
  import { HOME_LOOK } from "@/data/home-look.js";

  // the intro itself is src/scripts/logo-intro.js (the Studio's Logo intro prototype plays the same file)
  document.querySelectorAll<HTMLElement>("[data-kinetic-logo]").forEach((root) => {
    const say = (name: string, rate = 1, gain = 1) => {
      window.dispatchEvent(new CustomEvent("ks:sound", { detail: { name, rate, gain } }));
    };
    // tells a page that the logo is whole (HeroLines then docks it)
    let announced = false;
    const built = () => {
      if (announced) return;
      announced = true;
      root.dispatchEvent(new CustomEvent("kinetic-logo:built", { bubbles: true }));
    };
    const intro = mountLogoIntro(root, { look: HOME_LOOK.intro, say, onBuilt: built });

    root.addEventListener("click", () => intro.build());
    const arrival = document.documentElement.classList.contains("is-arrival"); // the intro is skipped
    if (root.classList.contains("is-autoplay") && !arrival && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      root.classList.add("is-ready");
      intro.build();
    } else {
      intro.pulled();
      root.classList.add("is-ready");
      requestAnimationFrame(built);
    }
  });
</script>

<style is:global>
  @layer components {
    .kinetic-logo_wrap {
      position: relative;
      color: var(--sage-300);
      cursor: pointer;
      &.is-autoplay:not(.is-ready) svg {
        visibility: hidden;
      }
    }
    /* the intro's field of lines, the size of the window (placed by the script) */
    .kinetic-logo_field {
      position: absolute;
      z-index: 0;
      display: none;
      /* the reset caps canvases at their box's width, which scaled the field off the logo */
      max-width: none;
      max-height: none;
      pointer-events: none;
    }
    .kinetic-logo_svg {
      position: relative;
      z-index: 1;
      display: block;
      width: 100%;
      height: auto;
      overflow: visible;
    }
    .kinetic-logo_stripe {
      transform-box: fill-box;
    }
  }
</style>
