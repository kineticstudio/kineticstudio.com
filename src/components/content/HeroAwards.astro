---
import type { ComponentProps } from "astro/types";
import Section from "@/components/wrapper/Section.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = Pick<ComponentProps<typeof Section>, "render" | "theme"> & {
  /** The headline. */
  heading: string;
  /** Utility classes. */
  class?: string;
};

const { render = true, heading, theme = "dark", class: className, ...rest } = Astro.props;
const awards = await slotContent(Astro.slots);
---

{
  render && heading && (
    <Section theme={theme} paddingTop="none" paddingBottom="none" class:list={["hero-awards_wrap", className]} {...rest}>
      <div class="hero-awards_layout">
        <h1 class="hero-awards_heading text-style-display">{heading}</h1>
        {awards && <ul class="hero-awards_list" set:html={awards} />}
      </div>
    </Section>
  )
}

<style is:global>
  @layer components {
    /* One screen of hero, plus a tail of black exactly as tall as the work
       panel's overlap, so the panel's top edge lands at the fold. */
    .hero-awards_wrap {
      --hero-awards-overlap: 31rem;
      @media (width < 48rem) {
        --hero-awards-overlap: 8rem;
      }
    }
    /* The padding lives here, not on the section: Section's padding props
       are utilities, and a utility outranks a component's own CSS. */
    .hero-awards_layout {
      width: 100%;
      min-height: calc(100svh + var(--hero-awards-overlap));
      padding-block: 9rem calc(3rem + var(--hero-awards-overlap));
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 6rem;
      @media (width < 32.5rem) {
        gap: 3rem;
      }
    }
    .hero-awards_heading {
      margin: 0 auto;
      max-width: 19ch;
      text-align: center;
      text-transform: uppercase;
      font-size: clamp(1.75rem, 4.9vw, 4.5rem);
      line-height: 1.04;
      letter-spacing: -0.01em;
      text-wrap: balance;
    }
    .hero-awards_list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.625rem 1.5rem;
      align-items: center;
      @media (width < 75rem) {
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
      }
      @media (width < 32.5rem) {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
