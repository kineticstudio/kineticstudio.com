---
import { AWARDS, STATS } from "@/data/work.js";
import { laurelLayoutVars } from "@/data/laurel-look.js";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Headline beside the awards. */
  heading?: string;
  /** Paragraph beside the headline. */
  lead?: string;
  /** Show the three numbers under the awards. */
  stats?: boolean;
  /** Just the three laurels in a line, small, no headline or rules (the wheel's header). */
  compact?: boolean;
  /** Leave the 3D laurels to the page (the laurel tuner mounts its own). */
  manual?: boolean;
  /** Utility classes. */
  class?: string;
}

const {
  render = true,
  heading = "Award-winning creative direction",
  lead = "Kinetic is led by Hunter Thompson: a big New York agency, then founding designer at startups, and now brand and bespoke websites for the companies building what's next.",
  stats = true,
  compact = false,
  manual = false,
  class: className,
} = Astro.props;
---

{
  render && (
    <div class:list={["awards_wrap", compact && "is-compact", className]} data-awards={manual ? "manual" : ""} style={compact ? laurelLayoutVars() : undefined}>
      {!compact && (
        <div class="awards_head">
          <h2 class="awards_title text-style-h2" data-reveal>{heading}</h2>
          <p class="awards_lead text-style-large" data-reveal style="--reveal-delay:0.1s">{lead}</p>
        </div>
      )}
      <div class="awards_row">
      <ul class="awards_list">
        {AWARDS.map((a, i) => (
          <li class="awards_item" data-reveal style={`--reveal-delay:${0.1 * i}s`}>
            <div class="awards_laurel" data-laurel-slot>
              <img class="awards_half is-left" data-src="/images/awards/laurel-chrome.webp" alt="" decoding="async" />
              <img class="awards_logo" src={a.logo} alt={a.name} style={`--logo-w:${a.width}rem`} />
              <img class="awards_half is-right" data-src="/images/awards/laurel-chrome.webp" alt="" decoding="async" />
            </div>
            <p class="awards_line text-style-small">{a.line}</p>
          </li>
        ))}
      </ul>
      <canvas class="awards_canvas" aria-hidden="true" />
      </div>
      {stats && !compact && (
        <ul class="awards_stats">
          {STATS.map((s, i) => (
            <li class="awards_stat" data-reveal style={`--reveal-delay:${0.1 * i}s`}>
              <span class="awards_num text-style-figure" data-count-to={s.value}>{s.value}</span>
              <span class="awards_label text-style-label">{s.label}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  )
}

<script>
  // Numbers count up the first time they come into view.
  const counters = document.querySelectorAll<HTMLElement>("[data-count-to]");
  const io = new IntersectionObserver((entries) => {
    for (const { target, isIntersecting } of entries) {
      if (!isIntersecting) continue;
      io.unobserve(target);
      const el = target as HTMLElement;
      const raw = el.dataset.countTo!;
      const end = parseInt(raw, 10);
      const suffix = raw.replace(String(end), "");
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) continue;
      const t0 = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / 1400);
        el.textContent = Math.round(end * (1 - Math.pow(1 - k, 4))) + suffix;
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }, { threshold: 0.6 });
  counters.forEach((c) => io.observe(c));

  import { laurelOptions, laurelLayoutVars } from "@/data/laurel-look.js";
  import { LITE } from "@/scripts/lite.js";

  // The laurels in real 3D chrome, once WebGL and src/scripts/laurel.js
  // are there; the rendered halves are the fallback, only fetched when the 3D
  // can't be built (Oct 30: they cost every visit 258 KB that WebGL then hid).
  // Every setting is in src/data/laurel-look.js (tuned at /tools/laurels).
  const modules = import.meta.glob("../../scripts/laurel.js");
  // on the homepage the 3D is built as the intro hands over, before the laurels fade in, not while
  // it plays: the code comes in meanwhile (Oct 30, Cloudflare's numbers)
  const intro = document.querySelector("[data-hero-lines]") && document.documentElement.dataset.intro !== "done";
  const introOver = intro ? new Promise((done) => addEventListener("ks:intro-done", done, { once: true })) : null;
  document.querySelectorAll<HTMLElement>("[data-awards]:not([data-awards='manual'])").forEach(async (root) => {
    const load = modules["../../scripts/laurel.js"];
    let canvas = root.querySelector<HTMLCanvasElement>(".awards_canvas");
    const flat = () => root.querySelectorAll<HTMLImageElement>(".awards_half[data-src]").forEach((img) => (img.src = img.dataset.src!));
    // phones keep the flat laurels: the 3D ran its light and bloom every frame (src/scripts/lite.js)
    if (LITE || !load || !canvas || !canvas.getContext("webgl2")) return flat();
    try {
      const code = load();
      await introOver;
      const { mountLaurels } = (await code) as { mountLaurels: (c: HTMLCanvasElement, o: object) => unknown };
      const slots = [...root.querySelectorAll<HTMLElement>("[data-laurel-slot]")];
      // Hunter, Oct 24: "the 3D laurels still don't look great. They need to
      // look like chrome. Maybe we need to rebuild them and have them have a
      // different shape." Fewer, plumper leaves (round both ways, a soft
      // crease down each) big enough to carry a whole reflection, in the
      // polished world: sky over a hot horizon over black, the horizon
      // landing mid-leaf, so every leaf has a bright face and a black one with
      // a hard line between. The bloom kept low: strong, it washed the metal
      // to flat silver. The wreath opened wider so the logo has room. On a
      // light page the horizon sits higher, so the metal reads dark on paper.
      const light = getComputedStyle(root).colorScheme === "light";
      type Handle = { destroy(): void; update(o: object): void; render(): void };
      const mount = (look?: object, on = canvas) => mountLaurels(on, { count: slots.length, getSlots: () => slots, ...laurelOptions(look as never, { light }) }) as Handle;
      let handle = mount();
      // kept on the row, so the homepage's particle hero can draw a fresh frame of it, and
      // its Params can change the look: live where it can, built again (on a fresh canvas,
      // the old one's context is gone) when the leaves or the wreath change
      Object.assign(root, {
        __laurels: handle,
        __laurelLook(look: object, rebuild: boolean) {
          if (root.classList.contains("is-compact")) root.setAttribute("style", laurelLayoutVars(look as never));
          if (rebuild) {
            handle.destroy();
            const fresh = canvas.cloneNode() as HTMLCanvasElement;
            canvas.replaceWith(fresh);
            canvas = fresh;
            handle = mount(look, fresh);
            Object.assign(root, { __laurels: handle });
          } else {
            handle.update(laurelOptions(look as never, { light }));
            handle.render();
          }
        },
      });
      root.classList.add("is-3d");
    } catch (e) {
      console.warn("laurels stay flat:", e);
      flat();
    }
  });
</script>

<style is:global>
  @layer components {
    .awards_wrap {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--section-space-small);
      width: 100%;
    }
    .awards_head {
      display: grid;
      grid-template-columns: 1.3fr 1fr;
      gap: var(--space-6);
      align-items: end;
      @media (width < 48rem) {
        grid-template-columns: 1fr;
      }
    }
    .awards_title,
    .awards_lead {
      margin: 0;
    }
    .awards_title {
      max-width: 12ch;
    }
    .awards_lead {
      max-width: 34ch;
      color: color-mix(in srgb, var(--text) 70%, transparent);
    }
    .awards_list,
    .awards_stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      margin: 0;
      border-top: var(--border-width) solid var(--grey-300);
      @media (width < 40rem) {
        grid-template-columns: 1fr;
      }
    }
    .awards_item,
    .awards_stat {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-7) var(--space-4);
      text-align: center;
      & + & {
        border-left: var(--border-width) solid var(--grey-300);
        @media (width < 40rem) {
          border-left: 0;
          border-top: var(--border-width) solid var(--grey-300);
        }
      }
    }
    .awards_laurel {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 14rem;
      height: 9.5rem;
    }
    /* the flat wreath's two branches, each a half of the picture at its own shape, at the slot's outer
       edges: as wide as half the slot, cover cropped their tips and stems whenever the slot was wider
       than the picture (Hunter, Oct 31, on his phone: "the laurels seem cut off in a weird way") */
    .awards_half {
      position: absolute;
      top: 0;
      width: auto;
      height: 100%;
      aspect-ratio: 350 / 622;
      max-width: 50%;
      object-fit: cover;
      &.is-left {
        left: 0;
        object-position: left center;
      }
      &.is-right {
        right: 0;
        object-position: right center;
      }
    }
    .awards_wrap.is-3d .awards_half {
      visibility: hidden;
    }
    .awards_logo {
      position: relative;
      width: calc(var(--logo-w) * 1.35);
      height: auto;
      filter: brightness(0) invert(0.92);
      :where(.theme-light) & {
        filter: brightness(0) opacity(0.85);
      }
    }
    .awards_line {
      max-width: 22ch;
      margin: 0;
      text-wrap: balance;
      color: color-mix(in srgb, var(--text) 60%, transparent);
    }
    .awards_stats {
      border-bottom: var(--border-width) solid var(--grey-300);
    }
    .awards_label {
      color: color-mix(in srgb, var(--text) 60%, transparent);
    }
    .awards_wrap.is-compact {
      gap: 0;
      & .awards_list {
        border-top: 0;
        grid-template-columns: repeat(3, auto);
        justify-content: center;
        gap: var(--awards-gap, 5.5rem);
      }
      & .awards_item {
        gap: var(--space-1);
        padding: 0;
        border: 0;
      }
      & .awards_laurel {
        width: var(--laurel-w, 10rem);
        height: calc(var(--laurel-w, 10rem) * 0.675);
      }
      & .awards_logo {
        width: calc(var(--logo-w) * var(--logo-scale, 0.85));
      }
      & .awards_line {
        max-width: 22ch;
        margin-top: var(--space-1);
        font-size: var(--line-size, var(--text-small));
      }
      & .awards_canvas {
        inset: -3rem -2rem;
        width: calc(100% + 4rem);
        height: calc(100% + 6rem);
      }
      /* on a phone the three share the width, so the row never runs off it */
      @media (width < 48rem) {
        & .awards_list {
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: var(--space-2);
        }
        & .awards_laurel {
          width: min(100%, 6.5rem);
          height: auto;
          aspect-ratio: 10 / 6.75;
        }
        & .awards_logo {
          width: calc(var(--logo-w) * 0.6);
        }
        & .awards_line {
          max-width: 13ch;
          font-size: 0.8125rem;
        }
      }
    }
    .awards_row {
      position: relative;
      & .awards_list {
        position: relative;
        z-index: 1;
      }
    }
    /* bleeds past the row so the hop and the glow have room */
    .awards_canvas {
      position: absolute;
      inset: -5rem 0;
      width: 100%;
      max-width: none; /* the reset caps canvases at 100%: this one overhangs the row */
      height: calc(100% + 10rem);
      pointer-events: none;
    }
  }
</style>
