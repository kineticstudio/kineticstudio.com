---
interface Props {
  /** Utility classes. */
  class?: string;
  /** Accessible description of what the field does. */
  label?: string;
}

const { class: className, label = "A field of lines that bend round your cursor" } = Astro.props;
/* The Kinetic lines the cursor plays with (src/scripts/line-field.js): the
   lines take this element's text colour and fill its box. */
---

<div class:list={["line-field_wrap", className]} data-line-field role="img" aria-label={label}>
  <canvas class="line-field_canvas" aria-hidden="true"></canvas>
</div>

<script>
  import { mountLineField } from "@/scripts/line-field.js";

  document.querySelectorAll<HTMLElement>("[data-line-field]").forEach((root) => {
    mountLineField(root.querySelector("canvas")!);
  });
</script>

<style is:global>
  @layer components {
    .line-field_wrap {
      position: relative;
      overflow: hidden;
      touch-action: pan-y;
      cursor: crosshair;
    }
    .line-field_canvas {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      max-width: none;
    }
  }
</style>
