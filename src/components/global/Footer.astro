---
import mark from "@/assets/brand/mark.svg?raw";
import { CONTACT_EMAIL, SOCIAL } from "@/consts.ts";
import ContactForm from "@/components/section/ContactForm.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The contact form at the foot of the page (all but the Playground). */
  form?: boolean;
}

const { render = true, form = true } = Astro.props;
const year = new Date().getFullYear();
/* The footer, dark on every page, and the end of every page (Hunter, Oct 25:
   "I don't like the footer. There's a card on top of the work, and then the
   footer just has another set of lines ... The start a project should be at
   the bottom of every page, so really, it could be a part of the footer").

   The contact form itself (ContactForm, not on the Playground), then the
   pages, the address, the profiles, the sound and the year. The barrel of
   work that sat over the form is gone (Hunter, Oct 25: "let's remove the
   barrel section above the contact field"); ProjectBarrel is kept. */
// the marks, drawn in the text colour
const ICONS: Record<string, string> = {
  X: '<path d="M17.75 3h3.07l-6.71 7.67L22 21h-6.18l-4.84-6.33L5.44 21H2.37l7.18-8.2L2 3h6.34l4.37 5.78L17.75 3Zm-1.08 16.18h1.7L7.4 4.73H5.58l11.09 14.45Z"/>',
  LinkedIn: '<path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/>',
};
---

{
  render && (
    <footer class="footer_wrap theme-dark">
      {/* the contact form itself at the foot of every page but the Playground (Hunter, Oct 25: "Let's
          have the contact form on the bottom of every page, as opposed to the Start the Project CTA ...
          Except for the playground") */}
      {form && <ContactForm inFooter />}

      <div class="footer_bar">
        <a class="footer_mark" href="/" aria-label="Kinetic Studio, home" set:html={mark} />
        <ul class="footer_links">
          <li><a class="pill is-tab footer_page" href="/playground">Playground</a></li>
          <li><a class="pill is-tab footer_page" href="/about">About</a></li>
          <li><a class="pill is-tab footer_page" href="/contact">Contact</a></li>
          <li><a class="footer_link footer_mail text-style-label" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
        </ul>
        <ul class="footer_social">
          {SOCIAL.map((s) => (
            <li>
              <a class="footer_icon" href={s.href} target="_blank" rel="noopener" aria-label={`Hunter Thompson on ${s.name}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" set:html={ICONS[s.name]} />
              </a>
            </li>
          ))}
        </ul>
        <button class="footer_sound pill is-tab" type="button" data-sound-toggle aria-pressed="true">
          <span class="footer_bars" aria-hidden="true"><i /><i /><i /><i /></span>
          Sound
        </button>
        <p class="footer_meta text-style-label">© {year} Kinetic Studio</p>
        <a class="pill is-tab footer_top" href="#main">Back to top ↑</a>
      </div>
    </footer>
  )
}

<script>
  // back to the top, smoothly, and the page's start takes the focus
  document.querySelectorAll<HTMLAnchorElement>(".footer_top").forEach((a) =>
    a.addEventListener("click", (e) => {
      e.preventDefault();
      scrollTo({ top: 0, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      document.getElementById("main")?.focus({ preventScroll: true });
    }),
  );
</script>

<style is:global>
  @layer components {
    .footer_wrap {
      position: relative;
      margin-top: auto;
      padding: var(--section-space-small) 0 var(--space-5);
      background: var(--background);
      color: var(--text);
      overflow: hidden;
    }
    .footer_bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4) var(--space-6);
      margin: 0 var(--site-margin);
      padding-top: var(--space-5);
      border-top: var(--border-width) solid var(--border);
    }
    .footer_mark {
      display: block;
      width: 1.75rem;
      color: var(--text);
      & svg {
        display: block;
        width: 100%;
        height: auto;
      }
    }
    .footer_links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.25rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .footer_link {
      color: color-mix(in srgb, var(--text) 70%, transparent);
      text-decoration: none;
      &:hover {
        color: var(--text);
      }
    }
    /* Hunter's profiles, as small marks */
    .footer_social {
      display: flex;
      gap: 0.4rem;
      margin: 0 0 0 auto;
      padding: 0;
      list-style: none;
    }
    .footer_icon {
      display: grid;
      place-items: center;
      width: var(--pill-height);
      height: var(--pill-height);
      border: var(--pill-stroke) solid color-mix(in srgb, var(--text) 35%, transparent);
      border-radius: 999px;
      color: color-mix(in srgb, var(--text) 80%, transparent);
      transition: border-color 0.3s ease, color 0.3s ease;
      & svg {
        width: 0.8rem;
        height: 0.8rem;
      }
      &:hover {
        border-color: var(--text);
        color: var(--text);
      }
    }
    /* the sound, on or off: four bars that move while it is on */
    /* the pages, the sound and back to top in the nav's own words and pills */
    .footer_sound {
      gap: 0.5rem;
      /* on or off shows in its bars, not a ring */
      &.pill.is-tab[aria-pressed] {
        border-color: transparent;
      }
      &[aria-pressed="false"] {
        color: color-mix(in srgb, var(--text) 50%, transparent);
      }
    }
    .footer_bars {
      display: inline-flex;
      align-items: flex-end;
      gap: 2px;
      height: 0.8rem;
      & i {
        width: 2px;
        height: 30%;
        background: currentColor;
      }
    }
    .footer_sound[aria-pressed="true"] .footer_bars i {
      animation: footer-bars 0.9s ease-in-out infinite alternate;
      &:nth-child(2) {
        animation-delay: -0.3s;
      }
      &:nth-child(3) {
        animation-delay: -0.6s;
      }
      &:nth-child(4) {
        animation-delay: -0.15s;
      }
    }
    @keyframes footer-bars {
      to {
        height: 100%;
      }
    }
    .footer_mail {
      display: inline-flex;
      align-items: center;
      height: var(--pill-height);
      padding-inline: var(--pill-pad);
    }
    .footer_meta {
      margin: 0;
      color: color-mix(in srgb, var(--text) 45%, transparent);
    }
    @media (width < 48rem) {
      .footer_social {
        margin-left: 0;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .footer_sound[aria-pressed="true"] .footer_bars i {
        animation: none;
        height: 70%;
      }
    }
  }
</style>
