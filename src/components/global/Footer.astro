---
import mark from "@/assets/brand/mark-ink.svg?raw";
import { CONTACT_EMAIL } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
const year = new Date().getFullYear();
---

{
  render && (
    <footer class="footer_wrap">
      <div class="footer_cta">
        <p class="footer_eyebrow text-style-label">Have something in mind?</p>
        <a class="footer_big text-style-display" href="/contact">
          <span>Start a</span> <span>project</span>
          <span class="footer_arrow" aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="footer_bar">
        <span class="footer_mark" set:html={mark} aria-hidden="true" />
        <a class="footer_link text-style-label" href={`mailto:${CONTACT_EMAIL}`} data-copy={CONTACT_EMAIL}>{CONTACT_EMAIL}</a>
        <ul class="footer_links">
          <li><a class="footer_link text-style-label" href="/work">Work</a></li>
          <li><a class="footer_link text-style-label" href="/playground">Playground</a></li>
          <li><a class="footer_link text-style-label" href="/about">About</a></li>
        </ul>
        <p class="footer_meta text-style-label">© {year} Kinetic Studio</p>
      </div>
    </footer>
  )
}

<script>
  // A nugget: clicking the address copies it, and says so.
  document.querySelectorAll<HTMLAnchorElement>("[data-copy]").forEach((a) => {
    a.addEventListener("click", async (event) => {
      if (event.metaKey || event.ctrlKey) return;
      try {
        await navigator.clipboard.writeText(a.dataset.copy ?? "");
        event.preventDefault();
        const text = a.textContent;
        a.textContent = "Copied to clipboard";
        window.dispatchEvent(new CustomEvent("ks:sound", { detail: "tick" }));
        setTimeout(() => (a.textContent = text), 1600);
      } catch {}
    });
  });
</script>

<style is:global>
  @layer components {
    .footer_wrap {
      position: relative;
      margin-top: auto;
      padding: var(--section-space-large) var(--site-margin) var(--space-5);
      border-top: var(--border-width) solid var(--grey-300);
      background: var(--background);
      color: var(--text);
    }
    .footer_cta {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding-bottom: var(--section-space-medium);
    }
    .footer_eyebrow {
      color: color-mix(in srgb, var(--text) 55%, transparent);
    }
    .footer_big {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      column-gap: 0.18em;
      color: var(--text);
      font-size: clamp(4.5rem, 15vw, 15rem);
      line-height: 0.82;
      transition: color 0.3s ease;
      &:hover {
        color: var(--brand-500);
      }
    }
    .footer_arrow {
      font-family: var(--primary-family);
      font-size: 0.5em;
      line-height: 1;
      transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .footer_big:hover .footer_arrow {
      transform: translate(0.12em, -0.12em);
    }
    .footer_bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4) var(--space-6);
      padding-top: var(--space-5);
      border-top: var(--border-width) solid var(--grey-300);
    }
    .footer_mark {
      width: 1.75rem;
      color: var(--sage-300);
      & svg {
        width: 100%;
        height: auto;
      }
    }
    .footer_links {
      display: flex;
      gap: var(--space-4);
      margin: 0 0 0 auto;
    }
    .footer_link {
      color: color-mix(in srgb, var(--text) 70%, transparent);
      &:hover {
        color: var(--text);
      }
    }
    .footer_meta {
      color: color-mix(in srgb, var(--text) 40%, transparent);
    }
    @media (width < 48rem) {
      .footer_links {
        margin-left: 0;
        width: 100%;
      }
    }
  }
</style>
