---
import lockup from "@/assets/brand/lockup-ink.svg?raw";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Hide the lockup until the page hands it over (a hero that owns the logo). */
  logoHidden?: boolean;
}

const { render = true, logoHidden = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/work", label: "Work" },
  { href: "/playground", label: "Playground" },
  { href: "/about", label: "About" },
];
---

{
  render && (
    <header class:list={["nav_wrap", logoHidden && "logo-hidden"]}>
      <a class="nav_logo" href="/" aria-label={SITE_NAME} set:html={lockup} />
      <nav class="nav_menu" aria-label="Main">
        <ul class="nav_links">
          {links.map((l) => (
            <li>
              <a class="nav_link text-style-label" href={l.href} aria-current={path.startsWith(l.href) ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
        <button class="nav_sound text-style-label" type="button" aria-pressed="false" data-sound-toggle aria-label="Sound">
          <span class="nav_sound_bars" aria-hidden="true"><i /><i /><i /><i /></span>
        </button>
        <a class="nav_contact" href="/contact" aria-current={path.startsWith("/contact") ? "page" : undefined}>Contact</a>
      </nav>
    </header>
  )
}

<style is:global>
  @layer components {
    .nav_wrap {
      position: fixed;
      inset: 0 0 auto;
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding: var(--space-4) var(--site-margin);
      color: var(--text);
      pointer-events: none;
      & > * {
        pointer-events: auto;
      }
    }
    .nav_logo {
      display: block;
      width: 8.5rem;
      color: var(--text);
      transition: opacity 0.4s ease;
      & svg {
        width: 100%;
        height: auto;
      }
    }
    .nav_wrap.logo-hidden .nav_logo {
      opacity: 0;
    }
    .nav_menu {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding: 0.3rem;
      border-radius: var(--radius-round);
      background: color-mix(in srgb, var(--background) 55%, transparent);
      backdrop-filter: blur(1rem);
      -webkit-backdrop-filter: blur(1rem);
    }
    .nav_links {
      display: flex;
      margin: 0;
    }
    .nav_link {
      display: block;
      padding: 0.6rem 0.8rem;
      border-radius: var(--radius-round);
      color: color-mix(in srgb, var(--text) 70%, transparent);
      transition: color var(--hover-duration) var(--hover-ease), background-color var(--hover-duration) var(--hover-ease);
      &:hover,
      &[aria-current="page"] {
        color: var(--text);
        background: color-mix(in srgb, var(--text) 8%, transparent);
      }
    }
    .nav_sound {
      display: grid;
      place-items: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 50%;
      color: color-mix(in srgb, var(--text) 70%, transparent);
      &:hover {
        color: var(--text);
      }
    }
    .nav_sound_bars {
      display: flex;
      align-items: center;
      gap: 0.125rem;
      height: 0.75rem;
      & i {
        width: 0.125rem;
        height: 25%;
        background: currentColor;
        border-radius: 1rem;
        transition: height 0.3s ease;
      }
    }
    .nav_sound[aria-pressed="true"] .nav_sound_bars i {
      animation: nav-sound 0.9s ease-in-out infinite alternate;
      &:nth-child(2) { animation-delay: -0.3s; }
      &:nth-child(3) { animation-delay: -0.6s; }
      &:nth-child(4) { animation-delay: -0.15s; }
    }
    @keyframes nav-sound {
      from { height: 20%; }
      to { height: 100%; }
    }
    .nav_contact {
      display: block;
      padding: 0.55rem 1.1rem 0.45rem;
      border-radius: var(--radius-round);
      background: var(--brand-500);
      color: var(--brand-text);
      font-family: var(--display-family);
      font-size: 1.125rem;
      line-height: 1;
      text-transform: uppercase;
      transition: transform var(--hover-duration) var(--hover-ease);
      &:hover {
        transform: scale(1.04);
      }
    }
    @media (width < 40rem) {
      .nav_logo {
        width: 6.5rem;
      }
      .nav_links .nav_link {
        padding-inline: 0.5rem;
      }
      .nav_sound {
        display: none;
      }
    }
    @media (width < 30rem) {
      .nav_links li:nth-child(2) {
        display: none;
      }
    }
  }
</style>
