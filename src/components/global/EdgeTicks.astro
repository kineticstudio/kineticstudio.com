---
// The notched edges of the 2026 briefs (kinetic-contracts brand-2026/ticks.svg):
// a short tick every 48 px down both sides of the page. They travel with the
// scroll, and a page can turn them itself ("ks:ticks", in px): the wheel does.
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The left edge's ticks (off on the homepage, Hunter, Oct 29: "remove the hatch lines on the left-hand side of the home page"). */
  left?: boolean;
}

const { render = true, left = true } = Astro.props;
---

{
  render && (
    <>
      {left && <div class="ticks_wrap is-left" aria-hidden="true" />}
      <div class="ticks_wrap is-right" aria-hidden="true" />
    </>
  )
}

<script>
  // the shift is set on the two strips themselves: set on <html>, every scrolled frame restyled the
  // whole page (Oct 30, phones)
  const strips = [...document.querySelectorAll<HTMLElement>(".ticks_wrap")];
  let extra = 0, raf = 0;
  const paint = () => {
    raf = 0;
    const shift = `${(-scrollY + extra).toFixed(1)}px`;
    for (const s of strips) s.style.setProperty("--ticks-shift", shift);
  };
  const request = () => (raf ||= requestAnimationFrame(paint));
  addEventListener("scroll", request, { passive: true });
  addEventListener("ks:ticks", (e) => {
    extra = Number((e as CustomEvent).detail) || 0;
    request();
  });
  paint();
</script>

<style is:global>
  @layer components {
    .ticks_wrap {
      --tick-step: 3rem;
      position: fixed;
      top: 0;
      bottom: 0;
      z-index: 40;
      width: 0.625rem;
      pointer-events: none;
      background-image: linear-gradient(to bottom, color-mix(in srgb, var(--sage-300) 14%, transparent) 1px, transparent 1px);
      background-size: 100% var(--tick-step);
      background-position: 0 var(--ticks-shift, 0px);
      &.is-left {
        left: 0;
      }
      &.is-right {
        right: 0;
      }
      @media (width < 48rem) {
        width: 0.4rem;
      }
    }
  }
</style>
