---
interface Props {
  /** What it sizes, for its label and for the page to find it ([data-size="name"]). */
  name: string;
  min: number;
  max: number;
  step?: number;
  value: number;
  /** Utility classes. */
  class?: string;
}

const { name, min, max, step = 1, value, class: className } = Astro.props;
---

{/* Hunter, Oct 23: "a little slider. That lets me zoom in or out ... make the work bigger or smaller".
    A fine notched track (the site's notches) and a lime thumb; the page listens for its input. */}
<label class:list={["size_wrap", className]}>
  <span class="size_label text-style-label">Size</span>
  <span class="size_track">
    <input class="size_input" type="range" min={min} max={max} step={step} value={value} data-size={name} aria-label={`${name} size`} />
  </span>
</label>

<style is:global>
  @layer components {
    .size_wrap {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      height: 2.25rem;
      padding: 0 0.9rem;
      cursor: pointer;
    }
    .size_label {
      color: color-mix(in srgb, var(--text) 60%, transparent);
    }
    .size_track {
      position: relative;
      display: block;
      width: 6.5rem;
      height: 1rem;
      /* the notches: a 1px tick every 6px, faint */
      background: repeating-linear-gradient(to right, color-mix(in srgb, var(--text) 22%, transparent) 0 1px, transparent 1px 6px) center / 100% 0.45rem no-repeat;
    }
    .size_input {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      margin: 0;
      appearance: none;
      background: none;
      cursor: pointer;
      &::-webkit-slider-runnable-track {
        height: 100%;
        background: none;
      }
      &::-moz-range-track {
        height: 100%;
        background: none;
      }
      &::-webkit-slider-thumb {
        appearance: none;
        width: 0.5rem;
        height: 1rem;
        border-radius: var(--radius-round);
        background: var(--brand-500);
        box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--brand-500) 20%, transparent);
        transition: transform 0.2s ease;
      }
      &::-moz-range-thumb {
        width: 0.5rem;
        height: 1rem;
        border: 0;
        border-radius: var(--radius-round);
        background: var(--brand-500);
      }
      &:active::-webkit-slider-thumb {
        transform: scaleY(1.2);
      }
      &:focus-visible {
        outline: var(--focus-width) solid var(--text);
        outline-offset: 0.3rem;
        border-radius: var(--radius-round);
      }
    }
  }
</style>
