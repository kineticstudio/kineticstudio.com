---
import type { Award } from "../data/site";

interface Props {
	heading: string;
	awards: Award[];
}
const { heading, awards } = Astro.props;
---

<section class="hero page-padding">
	<div class="container hero__inner">
		<h1 class="hero__heading">{heading}</h1>

		<ul class="hero__awards">
			{
				awards.map((award) => {
					const Tag = award.url ? "a" : "div";
					return (
						<li>
							<Tag
								class="hero__award"
								{...(award.url
									? { href: award.url, target: "_blank", rel: "noopener" }
									: {})}
							>
								<img
									src={award.logo}
									alt={award.logoAlt}
									class="hero__award-logo"
									loading="lazy"
								/>
								<span class="hero__award-label">{award.label}</span>
							</Tag>
						</li>
					);
				})
			}
		</ul>
	</div>
</section>

<style>
	.hero {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;

		/* One full screen of hero, plus a tail of black for the projects
		   panel to slide up over. The tail exactly equals the panel's
		   negative margin, so the panel's top edge lands at the fold. */
		min-height: calc(100svh + var(--panel-overlap));
		padding-block: 9rem calc(3rem + var(--panel-overlap));
	}

	.hero__inner {
		width: 100%;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 6rem;
		flex: 1;
	}

	.hero__heading {
		margin: 0;
		max-width: 19ch;
		margin-inline: auto;
		text-align: center;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(1.75rem, 4.9vw, 4.5rem);
		line-height: 1.04;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.hero__awards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 10px 24px;
		align-items: center;
	}

	.hero__award {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	a.hero__award {
		transition: opacity 0.3s ease;
	}
	a.hero__award:hover {
		opacity: 0.6;
	}

	.hero__award-logo {
		height: 34px;
		width: auto;
		flex: none;
	}

	.hero__award-label {
		font-size: 0.75rem;
		line-height: 1.3;
		color: rgb(255 255 255 / 0.5);
	}

	@media (max-width: 900px) {
		.hero__awards {
			grid-template-columns: repeat(2, 1fr);
			gap: 1.5rem;
		}
	}

	@media (max-width: 520px) {
		.hero__awards {
			grid-template-columns: 1fr;
		}
		.hero__inner {
			gap: 3rem;
		}
	}
</style>
