---
// A bare stage for building one experiment: the piece, its Params, nothing else.
import { EXPERIMENTS } from "@/data/experiments.js";

export function getStaticPaths() {
  return EXPERIMENTS.filter((e) => e.kind === "live").map((e) => ({ params: { slug: e.slug }, props: { e } }));
}
const { e } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="site-root" href="/" />
    <title>{e.title} · Lab</title>
    <style is:global>
      html, body { margin: 0; height: 100%; background: #0d0d0d; }
      .lab, .lab-stage { position: relative; height: 100%; overflow: hidden; }
      html:has(.lab.is-bare) astro-dev-toolbar, html:has(.lab.is-bare) .ksp { display: none !important; }
    </style>
  </head>
  <body>
    <div class="lab">
      <div class="lab-stage" data-slug={e.slug}></div>
    </div>
    <script>
      import { hostExperiment } from "@/scripts/experiment-host.js";
      type Experiment = { params: object; mount: (...args: unknown[]) => unknown };
      const modules = import.meta.glob("../../experiments/*.js");
      const stage = document.querySelector<HTMLElement>(".lab-stage")!;
      // ?bare: the piece alone, for scripts/capture-experiments.mjs
      const bare = new URLSearchParams(location.search).has("bare");
      if (bare) document.querySelector(".lab")!.classList.add("is-bare");
      const slug = stage.dataset.slug;
      const load = modules[`../../experiments/${slug}.js`];
      if (!load) {
        stage.textContent = `src/experiments/${slug}.js is not written yet.`;
      } else {
        const mod = (await load()) as Experiment;
        const host = hostExperiment(stage, mod, { title: document.title, open: !bare });
        // window.__experiment.panel.set(path, value) moves a dial from a test script
        Object.assign(window, { __experiment: { host, panel: host.api } });
      }
    </script>
  </body>
</html>
