---
import Layout from "@/layouts/BaseLayout.astro";
import PartnerHero from "@/components/section/PartnerHero.astro";
import PartnerBrandToWeb from "@/components/section/PartnerBrandToWeb.astro";
import PartnerProcess from "@/components/section/PartnerProcess.astro";
import PartnerClose from "@/components/section/PartnerClose.astro";
import PartnerQuotes from "@/components/section/PartnerQuotes.astro";
import PartnerStudio from "@/components/section/PartnerStudio.astro";
import PartnerOffer from "@/components/section/PartnerOffer.astro";
import PartnerFeatureQuote from "@/components/section/PartnerFeatureQuote.astro";
import WorkWheel from "@/components/section/WorkWheel.astro";
import { HOME } from "@/data/work.js";
import primaryLogo from "@/assets/clients/primary.svg?raw";

/* Nov 6: Primary (primary.studio) made Kinetic its web partner, and Hunter promised Brandon a page to
   share with prospects. Hunter: "we should show off exe.dev, owner.com, august health, ramble ... But
   also show other sites done by me, and make sure we show off the clients and the pedigree and stuff.
   logos and laurels"; then "a lockup of primary × Kinetic ... a horizontal marquee for all the primary
   work, and then go back and do our carousel scroller ... for the other work", with a light section on
   how we work together. Every tile rests on its loop, with no live 3D card and no particles ("We don't
   need the 3D hover states on this one ... let's not have the pixel effect").
   No contact form at the foot (Hunter, Nov 6: "Remove the contact form at the bottom").
   Not in the nav and kept out of search (NOINDEX_ROUTES): it travels by link. */
/* Nov 9: Planned added, the fifth live Primary brand (Hunter to Nick, Nov 7: "We technically have 5 live"). */
const PRIMARY = ["exe", "owner", "august-health", "ramble", "planned"];
/* Nov 9: a shorter wheel, in the homepage's order and an even count so the last row isn't one tile on its
   own; the page is about Primary's brands, and the other work was three quarters of its height. */
const MORE = ["wispr-flow", "dawn", "anthropic-community", "moses", "ethos", "rime", "rylo", "cambium", "venus-aerospace", "epirus", "new-era", "counsel-health"];
const rest = MORE.filter((slug) => HOME.includes(slug) && !PRIMARY.includes(slug));

/* Nov 17 upgrade, from the group DM: Hunter, Nov 9: "a more proper landing page that explains the
   relationship ... what it looks like to take the brand and bring it to the web"; Nick, Nov 9: "some kind of
   transformation of the brand into web", "clear process and timeline", and "an inherent advantage to it
   being light mode and feeling like primary" (Hunter: "Much more in line with where I want to take it");
   Hunter, Nov 9: four weeks of web, not five ("Let's do 4 weeks"). Prices stayed off the page until Nov 17, when Hunter asked for the $50,000 offer section. */

/* Brand to website: each brand as Primary's brand book hands it over, beside the site. Colours and type
   are the brand books' own (exe: Primary's guidelines file; Owner: the site's tokens; Planned: the
   Interim Brand Book); logos are the real files. */
/* Nov 17: Primary's own guideline pages beside each site (Hunter: "the brand guidelines ... 16:9 static
   PDF that Primary sends over"). Pages from the brand book Figma files: exe (Primary's delivery, imported
   by Hunter), Owner (Owner.com Website file, Brand page) and Ramble (Ramble file, Guidelines 2026). No
   Planned row (Hunter, Nov 17: "dont do planned"). */
const B = "/images/primary/brand";
// each row's line says what the client does, not who made what (Hunter, Nov 18)
const PAIRS = [
  {
    slug: "exe",
    // no launch film here for now (Hunter, Nov 17); it is at public/media/exe-launch-film.mp4 if wanted:
    // film: { src: "/media/exe-launch-film.mp4", poster: "/media/exe-launch-film.jpg", label: "Watch the launch film" },
    line: "A private computer for your agents: real servers, kept running for you.",
    slides: [
      { src: `${B}/exe-cover.webp`, alt: "exe brand guidelines, the cover" },
      { src: `${B}/exe-logo.webp`, alt: "exe logo system" },
      { src: `${B}/exe-illustration.webp`, alt: "exe field manual illustrations" },
      { src: `${B}/exe-colour.webp`, alt: "exe neutral colours" },
      { src: `${B}/exe-type.webp`, alt: "exe brand fonts" },
      { src: `${B}/exe-layout.webp`, alt: "exe layout markers" },
      { src: `${B}/exe-cap.webp`, alt: "exe cap" },
    ],
  },
  {
    slug: "owner",
    line: "Online ordering and websites that help restaurants grow.",
    slides: [
      { src: `${B}/owner-title.webp`, alt: "Owner brand guidelines, the cover" },
      { src: `${B}/owner-colour.webp`, alt: "Owner primary colour palette" },
      { src: `${B}/owner-app.webp`, alt: "Owner app and listing exhibits" },
      { src: `${B}/owner-ui.webp`, alt: "Owner UI integration" },
      { src: `${B}/owner-stage.webp`, alt: "Owner on stage and on a badge" },
      { src: `${B}/owner-gradients.webp`, alt: "Owner full-bleed gradients" },
    ],
  },
  {
    slug: "ramble",
    line: "Group chats for big communities, hosted by the shows fans love.",
    slides: [
      { src: `${B}/ramble-cover.webp`, alt: "Ramble brand guidelines, the cover" },
      { src: `${B}/ramble-logo.webp`, alt: "Ramble logo system" },
      { src: `${B}/ramble-posters.webp`, alt: "Ramble posters" },
      { src: `${B}/ramble-colour.webp`, alt: "Ramble primary colours" },
      { src: `${B}/ramble-type.webp`, alt: "Ramble brand fonts" },
      { src: `${B}/ramble-tote.webp`, alt: "Ramble tote bag" },
      { src: `${B}/ramble-patterns.webp`, alt: "Ramble macro patterns" },
    ],
  },
];

/* The hand-off, week by week: the sprint is two weeks (primary.studio), web is four after it, and the
   content and wireframes start in the sprint's second week. */
const COLUMNS = ["Week 1", "Week 2", "Week 3", "Week 4", "Week 5", "Week 6"];
// Kinetic is working from day one (Hunter, Nov 17: "Right now, it looks like work doesn't happen until week 2.
// That's not quite right"): discovery through the sprint's first week, wireframes in its second; launch is the
// bottom of the chart ("I need Launch to be at the bottom")
const LANES = [
  {
    name: "Primary",
    kind: "partner" as const,
    bars: [{ title: "Brand sprint", note: "Strategy, identity and the brand book", from: 1, to: 2, when: "Weeks 1 and 2" }],
  },
  {
    name: "Kinetic",
    kind: "kinetic" as const,
    bars: [
      { title: "Discovery", note: "Questions, research and the site map, alongside the sprint", from: 1, to: 1, when: "Week 1", soft: true },
      { title: "Wireframes", note: "Content and structure, while the sprint wraps", from: 2, to: 2, when: "Week 2", soft: true },
      { title: "Homepage design", note: "A live prototype you can comment on", from: 3, to: 4, when: "Weeks 3 and 4" },
      { title: "Every page, built", note: "Custom code, tested, then launched", from: 5, to: 6, when: "Weeks 5 and 6" },
    ],
  },
];
/* What passes between the studios through the sprint (Hunter, Nov 17: "colors established, general direction
   figured out, and things get tossed back and forth between the two, but they're labeled"; then "You could see
   ideas going back and forth: when it gets 'nope ideas,' then it gets colored, then ... the brand system gets
   set up, etc., back and forth"). `day` is the working day, its fraction how far into that day. */
/* What passes between the studios in the sprint (Hunter, Nov 18: "Think more critically about what I'd be sending
   over to Primary. It would really be motion ideas and prototypes ... at the very tail end"). Primary sends its
   work as it lands; Kinetic listens until the brand is set, then hands back motion and prototypes in the last
   days, in time for the final presentation. Primary stops hard at the end of week 2. `stick` pills stay on. */
const EXCHANGES = [
  { day: 1.2, from: "partner", label: "Kickoff", stick: true },
  { day: 2.1, from: "partner", label: "Research" },
  { day: 2.8, from: "partner", label: "First ideas" },
  { day: 3.6, from: "partner", label: "Moodboards", stick: true },
  { day: 4.2, from: "partner", label: "Exec presentation" },
  { day: 5.1, from: "partner", label: "Direction picked", stick: true },
  { day: 6.0, from: "partner", label: "Colour" },
  { day: 7.2, from: "partner", label: "Type" },
  { day: 8.3, from: "partner", label: "Logo" },
  { day: 9.4, from: "partner", label: "Brand system", stick: true },
  { day: 10.5, from: "partner", label: "Brand book draft" },
  { day: 11.2, from: "kinetic", label: "Motion ideas", stick: true },
  { day: 12.1, from: "kinetic", label: "Prototypes", stick: true },
  { day: 12.8, from: "kinetic", label: "Motion for the presentation" },
  { day: 13.2, from: "partner", label: "Final presentation" },
  { day: 14.0, from: "partner", label: "Brand book", stick: true },
] as const;
/* Kinetic's own process once Primary hands over (Hunter, Nov 18: "show off what would happen post-Primary ... how
   the process works on our end"), each a pill that comes on in Kinetic's block as the line reaches it */
const STEPS = [
  { day: 15.4, label: "Homepage in the Studio" },
  { day: 17.8, label: "Feedback" },
  { day: 20.0, label: "Motion and interaction" },
  { day: 22.3, label: "Homepage signed off" },
  { day: 24.8, label: "Every page designed" },
  { day: 27.6, label: "Components and CMS" },
  { day: 30.4, label: "Built in code" },
  { day: 33.2, label: "Content in" },
  { day: 35.7, label: "Tested on every device" },
  { day: 38.0, label: "SEO and performance" },
  { day: 39.9, label: "Preview for sign-off" },
] as const;
const POINTS = [
  {
    title: "Straight to the designer",
    body: "Hunter with Kinetic designs and builds your site directly. No junior hand-off, just quick answers and links to review.",
  },
  {
    title: "Yours to run",
    body: "Up to about 15 pages in custom code, with a CMS your team can edit without a developer.",
  },
];
---

<Layout theme="light" footerForm={false} title="Primary x Kinetic" description="Primary builds the brand in two weeks, Kinetic carries it into the website in four: sites for exe.dev, Owner, August Health, Ramble and Planned." image="/og-primary.jpg">
  {/* no logo intro here: the wheel arrives straight away (it waits for "ks:intro-done" otherwise) */}
  <script is:inline slot="head">document.documentElement.dataset.intro = "done";</script>
  {/* left-aligned and smaller, straight into the first brand (Hunter, Nov 17: "Let's actually not have the hero
      barrel grid. Instead, left-align the primary to Kinetic lockup, the H1, and the subcopy. Make it smaller.
      Remove the carousel of work below that, and then we'll just go straight into the exe example."); the
      awards and client logos sit down by the wheel */}
  {/* the hero and the rows share one ground: light into dark toward the screen's bottom right, like the
      Primary proposal's cover (Hunter, Nov 17), stuck to the screen as they scroll (PartnerBrandToWeb) */}
  <div class="bw-ground" data-ground>
  <div class="bw-ground_layer" aria-hidden="true"></div>
  <PartnerHero
    compact
    partnerLogo={primaryLogo}
    partnerName="Primary"
    heading="Put your Primary brand | out into the world"
    lead="Primary is a world-class branding agency. Kinetic turns their work into a website full of motion and interaction, live four weeks after your sprint."
  />
  <PartnerBrandToWeb pairs={PAIRS} />
  </div>
  {/* Nick's words, right under the last brand row (Hunter, Nov 18); drafts only until Nick approves them */}
  <PartnerFeatureQuote page="primary" />
  <PartnerProcess
    partnerLogo={primaryLogo}
    exchanges={[...EXCHANGES]}
    steps={[...STEPS]}
    heading="Two studios, | one team"
    lead="Six weeks from kickoff with Primary to a live site. Kinetic is in the files before your sprint wraps, so nobody explains your company twice."
    columns={COLUMNS}
    lanes={LANES}
  />
  {/* the Studio, from the proposal's tooling page, the brand book first (Hunter, Nov 17) */}
  <PartnerStudio partner="Primary" />
  {/* the offer (Hunter, Nov 17), from the Primary proposal's "What you get" and fixed-price card; replaces the
      timeline's two points ("Straight to the designer", "Yours to run"), which said the same */}
  <PartnerOffer
    heading="A special relationship | with Primary"
    price="[Live in] 4 weeks | [for] $50,000"
    includes={[
      { icon: "doc", text: "Up to about 15 pages" },
      { icon: "sitemap", text: "Story, sitemap and wireframes" },
      { icon: "spark", text: "Web design, animation and interaction" },
      { icon: "code", text: "Custom code, with a CMS your team can edit" },
      { icon: "pen", text: "Unlimited revisions" },
      { icon: "chat", text: "Creative direction from Hunter, no hand-off" },
      { icon: "browser", text: "Access to the Kinetic Studio" },
      { icon: "grid", text: "A production-ready component library" },
      { icon: "speed", text: "SEO, AEO and a performance pass" },
      { icon: "calendar", text: "A start during your brand sprint" },
    ]}
  />
  <WorkWheel heading="More websites | from Kinetic" only={rest} simple dark />
  {/* the other clients' words, further down, on the page's own light so they don't run into the close's neon (Hunter, Nov 18) */}
  <PartnerQuotes page="primary" />
  <PartnerClose
    heading="Start with | a brand sprint"
    lead="Book your sprint with Primary, and your website comes from the same team, four weeks later."
    cta={{ label: "Start with Primary", href: "https://www.primary.studio/contact" }}
  />
</Layout>

<script>
  import "@/scripts/brand-web-params.js";
</script>
