---
import Layout from "@/layouts/BaseLayout.astro";
import PartnerHero from "@/components/section/PartnerHero.astro";
import PartnerWork from "@/components/section/PartnerWork.astro";
import PartnerHow from "@/components/section/PartnerHow.astro";
import WorkWheel from "@/components/section/WorkWheel.astro";
import { HOME } from "@/data/work.js";
import primaryLogo from "@/assets/clients/primary.svg?raw";

/* Nov 6: Primary (primary.studio) made Kinetic its web partner, and Hunter promised Brandon a page to
   share with prospects. Hunter: "we should show off exe.dev, owner.com, august health, ramble ... But
   also show other sites done by me, and make sure we show off the clients and the pedigree and stuff.
   logos and laurels"; then "a lockup of primary × Kinetic ... a horizontal marquee for all the primary
   work, and then go back and do our carousel scroller ... for the other work", with a light section on
   how we work together. Every tile rests on its loop, with no live 3D card and no particles ("We don't
   need the 3D hover states on this one ... let's not have the pixel effect").
   No contact form at the foot (Hunter, Nov 6: "Remove the contact form at the bottom").
   Not in the nav and kept out of search (NOINDEX_ROUTES): it travels by link. */
/* Nov 9: Planned added, the fifth live Primary brand (Hunter to Nick, Nov 7: "We technically have 5 live"). */
const PRIMARY = ["exe", "owner", "august-health", "ramble", "planned"];
/* Nov 9: a shorter wheel, in the homepage's order and an even count so the last row isn't one tile on its
   own; the page is about Primary's brands, and the other work was three quarters of its height. */
const MORE = ["wispr-flow", "dawn", "anthropic-community", "moses", "ethos", "rime", "rylo", "cambium", "venus-aerospace", "epirus", "new-era", "counsel-health"];
const rest = MORE.filter((slug) => HOME.includes(slug) && !PRIMARY.includes(slug));

/* The working relationship, from the Nov 6 call with Nick and Brandon, told in the order a client lives it:
   the brand, the early web start, Hunter directly, launch. Prices stay off the page. */
const HOW = [
  {
    title: "Brand first",
    body: "Primary runs your brand sprint and delivers a launch-ready identity in two weeks.",
  },
  {
    title: "A head start on web",
    body: "Content and wireframes can start during the sprint, so the site is never waiting on the brand.",
  },
  {
    title: "Straight to the designer",
    body: "Hunter with Kinetic designs and builds your site directly. No junior hand-off, just quick answers and links to review.",
  },
  {
    title: "Live in about five weeks",
    body: "Up to about 15 pages, in custom code with a CMS your team can edit. After launch we can keep going with site updates, decks and social.",
  },
];
---

<Layout footerForm={false} title="Primary x Kinetic" description="Primary builds the brand, Kinetic carries it into the website: award-winning sites for exe.dev, Owner, August Health, Ramble and Planned." image="/og-primary.jpg">
  {/* no logo intro here: the wheel arrives straight away (it waits for "ks:intro-done" otherwise) */}
  <script is:inline slot="head">document.documentElement.dataset.intro = "done";</script>
  <PartnerHero
    partnerLogo={primaryLogo}
    partnerName="Primary"
    heading="From brand | to website"
    lead="Primary builds your brand in a two-week sprint. Kinetic carries it into your website, live in about five weeks. Two studios working as one, so nothing gets lost in between."
  />
  <PartnerWork only={PRIMARY} credits label="Websites for Primary brands" />
  <PartnerHow
    heading="Two studios, | one team"
    lead="Your site is designed from Primary's own system and files, so it feels like the brand from the first page, not a translation of it."
    cta={{ label: "Start with Primary", href: "https://www.primary.studio/contact" }}
    points={HOW}
  />
  <WorkWheel heading="More websites | from Kinetic" only={rest} simple />
</Layout>
