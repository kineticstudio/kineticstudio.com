---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import { getProjects, getSiteSettings } from "../lib/sanity";

const [projects, { site, awards }] = await Promise.all([
	getProjects(),
	getSiteSettings(),
]);
---

<BaseLayout title={site.title} description={site.description}>
	<SiteHeader contactEmail={site.contactEmail} />
	<main>
		<Hero heading={site.heroHeading} awards={awards} />
		<ProjectGrid projects={projects} />
	</main>
</BaseLayout>

