---
// Scratch page for src/scripts/laurel.js: three award slots in a row, one
// canvas over them, a laurel drawn round each placeholder. Not linked
// anywhere; delete once the awards section uses mountLaurels for real.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Laurels · Lab</title>
    <style is:global>
      html, body { margin: 0; min-height: 100%; background: #0d0d0d; color: #d9e2d2; font: 13px/1.3 ui-monospace, monospace; }
      main { min-height: 100vh; display: grid; place-items: center; }
      .awards { position: relative; display: flex; gap: 2rem; flex-wrap: wrap; justify-content: center; padding: 2rem; }
      .awards canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
      .award { position: relative; width: 9rem; height: 9rem; display: grid; place-items: center; text-align: center; text-transform: uppercase; letter-spacing: 0.04em; }
      .award span { max-width: 4.5rem; }
    </style>
  </head>
  <body>
    <main>
      <div class="awards">
        <canvas aria-hidden="true"></canvas>
        <div class="award"><span>Awwwards SOTD</span></div>
        <div class="award"><span>Webby Honoree</span></div>
        <div class="award"><span>SXSW Finalist</span></div>
      </div>
    </main>
    <script>
      import { mountLaurels } from "@/scripts/laurel.js";
      const row = document.querySelector<HTMLElement>(".awards")!;
      const handle = mountLaurels(row.querySelector("canvas")!, {
        count: 3,
        getSlots: () => row.querySelectorAll(".award"),
      });
      Object.assign(window, { __laurels: handle });
    </script>
  </body>
</html>
