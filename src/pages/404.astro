---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
---

<Layout
  title="Page not found"
  description="This page doesn't exist, but the work does: award-winning websites and brands from Kinetic Studio."
>
  <Section paddingTop="navoverlap" paddingBottom="navoverlap" class="flex-grow">
    <ContentWrapper centered={true}>
      <Heading variant="h1" tag="h1" maxWidth={12}>Lost between the lines</Heading>
      <Paragraph variant="large" maxWidth={36}>This page doesn't exist, but the work does.</Paragraph>
      <ButtonWrapper>
        <Button element="link" href="/">Back to home</Button>
        <Button element="link" href="/playground" emphasis="secondary">Visit the Playground</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>
