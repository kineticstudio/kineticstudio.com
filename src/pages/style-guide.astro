---
/* Kinetic Studio's own design system.
 *
 * The DOCUMENT comes from @kineticstudio/astro-design-system, shared with
 * Elio and Ramble. This file supplies only what is ours: the palette, the
 * faces, and the real components. Redesign the package once and all three
 * sites move on their next build.
 *
 * Two things about this site that the other two do not have, both handled
 * below rather than by bending the package:
 *
 *   Our tokens predate the package's contract (--black, --peach,
 *   --font-display) and are used throughout the site, so they are ALIASED to
 *   the contract rather than renamed. Renaming them would touch every file
 *   for no gain.
 *
 *   We have no mark asset, so the cover opens on the title.
 *
 * The URL stays /style-guide because it is linked from the site.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import DesignSystem from "@kineticstudio/astro-design-system";
import Stage from "@kineticstudio/astro-design-system/Stage.astro";
import Button from "../components/Button.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { awards } from "../data/site";
import { getProjects } from "../lib/sanity";

const projects = await getProjects();
const withVideo = projects.find((p) => p.video) ?? projects[0];
const textOnly = projects.find((p) => !p.video) ?? projects[0];

/* Weighted by role: black is nearly the whole site, peach is the one accent
   and is currently unspent. */
const PALETTE = [
  { name: "Black", hex: "#000000", token: "--black", on: "#ffffff", span: 7, tall: true,
    use: "The page. Body copy on white, and the ground everything else sits on." },
  { name: "White", hex: "#ffffff", token: "--white", on: "#000000", span: 5, tall: true,
    use: "The projects panel, and hero type on black." },
  { name: "Peach", hex: "#f7a696", token: "--peach", on: "#000000", span: 6,
    use: "The accent. Currently unspent on the site itself." },
  { name: "Grey", hex: "#dbdbdb", token: "--grey", on: "#000000", span: 6,
    use: "A video placeholder while it loads. Not a design colour." },
];

const PROPORTION = [
  { hex: "#000000", pct: 78 }, { hex: "#ffffff", pct: 19 },
  { hex: "#f7a696", pct: 2 }, { hex: "#dbdbdb", pct: 1 },
];

const TYPE_SCALE = [
  { label: "Hero", size: "clamp(1.75rem, 4.9vw, 4.5rem)", face: "var(--sys-display)", weight: 600, lh: 1.02, sample: "CAPTIVATING WEBSITES" },
  { label: "Section", size: "clamp(1.1rem, 1.6vw, 1.5rem)", face: "var(--sys-display)", weight: 600, lh: 1.1, sample: "SUPERORGANISM" },
  { label: "Body", size: "1rem", face: "var(--sys-body)", weight: 400, lh: 1.5, sample: "We build websites that tell compelling stories, for companies with something worth saying." },
  { label: "Small", size: "0.8125rem", face: "var(--sys-body)", weight: 400, lh: 1.5, sample: "Made by Kinetic Studio" },
];

const SPACING = [
  { name: "Page", value: "var(--page-padding)", px: 64, note: "The page's own margin, 1.5em on a phone." },
  { name: "Grid gap", value: "var(--grid-gap)", px: 32, note: "Between cards in the projects grid." },
  { name: "Overlap", value: "var(--panel-overlap)", px: 24, note: "How far the panel rides over the hero." },
];
---

<BaseLayout title="Style guide">
  <!-- Our tokens predate the package's contract, so they are aliased here
       rather than renamed across the whole site. This block is the only
       adapter the package needs. -->
  <style is:global>
    :root {
      --bg: var(--black);
      --ink: var(--white);
      --muted: rgba(255, 255, 255, 0.66);
      --surface: rgba(255, 255, 255, 0.12);
      --contrast-bg: var(--white);
      --contrast-ink: var(--black);
      --contrast-muted: rgba(0, 0, 0, 0.62);
      --contrast-surface: rgba(0, 0, 0, 0.1);
      --accent: var(--peach);
      --sys-display: var(--font-display);
      --sys-body: var(--font-body);
      --gutter: var(--page-padding);
    }
  </style>

  <DesignSystem
    brand="Kinetic Studio"
    mark={null}
    palette={PALETTE}
    proportion={PROPORTION}
    typeScale={TYPE_SCALE}
    spacing={SPACING}
    displayName="Monument Extended"
    bodyName="GT Walsheim"
    intro="Every component here is imported from the live site, so this page cannot drift from the thing it documents."
  >
    <Fragment slot="buttons">
      <Button href="#">Get in touch</Button>
    </Fragment>
    <Fragment slot="buttons-light">
      <Button href="#">Get in touch</Button>
    </Fragment>

    <Fragment slot="components">
      <Stage name="Project card" file="src/components/ProjectCard.astro"
             note="With a video, as most carry one.">
        <ProjectCard project={withVideo} />
      </Stage>

      <Stage name="Project card, text only" file="src/components/ProjectCard.astro"
             note="The same component with no video, which has to hold its own.">
        <ProjectCard project={textOnly} />
      </Stage>

      <Stage name="Awards" file="src/data/site.ts" short
             note="Pulled from data rather than written into the page.">
        <ul class="sg-awards">
          {awards.map((a) => <li>{a.name ?? a}</li>)}
        </ul>
      </Stage>
    </Fragment>
  </DesignSystem>
</BaseLayout>

<style is:global>
  .sg-awards { display: flex; flex-wrap: wrap; gap: 14px; list-style: none; margin: 0; padding: 24px; }
  .sg-awards li { font-family: var(--body); font-size: 14px; opacity: 0.8; }
</style>
